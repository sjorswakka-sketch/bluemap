msgstr "Sharpshooter"

#. Uitleg bij prestatie boog_schietbaan
#: scripts/data/ext/boog.gd:40
msgid "Haal Tessa's schietbaan: drie doelwitten binnen de tijd."
msgstr "Beat Tessa's shooting range: three targets before time runs out."

#. Naam van prestatie boog_rivier
#: scripts/data/ext/boog.gd:44
msgid "Over de rivier"
msgstr "Across the River"

#. Uitleg bij prestatie boog_rivier
#: scripts/data/ext/boog.gd:44
msgid "Open het verborgen poortje in het Fluisterbos met je boog."
msgstr "Open the hidden gate in the Whispering Woods with your bow."

#. Naam van prestatie vijanden_magier
#: scripts/data/ext/vijanden.gd:48
msgid "Spreuk gebroken"
msgstr "Spell Broken"

#. Uitleg bij prestatie vijanden_magier
#: scripts/data/ext/vijanden.gd:48
msgid "Versla een magiër."
msgstr "Defeat a Mage."

#. Naam van prestatie vijanden_spuwer
#: scripts/data/ext/vijanden.gd:52
msgid "Spuuglokker"
msgstr "Spit Stopper"

#. Uitleg bij prestatie vijanden_spuwer
#: scripts/data/ext/vijanden.gd:52
msgid "Versla vijf slijmspuwers."
msgstr "Defeat five Slime Spitters."

#. Naam van prestatie meer_karper
#: scripts/data/ext/meer.gd:47
msgid "Legende van het meer"
msgstr "Legend of the Lake"

#. Uitleg bij prestatie meer_karper
#: scripts/data/ext/meer.gd:47
msgid "Vang de Gouden Karper en breng hem naar Visser Joris."
msgstr "Catch the Golden Carp and bring it to Joris the Fisher."

#. Uitleg bij prestatie meer_boekenwurm
#: scripts/data/ext/meer.gd:51
msgid "Breng Lena haar drie verloren boeken terug."
msgstr "Bring Lena her three lost books."

#. Naam van prestatie meer_lezer
#: scripts/data/ext/meer.gd:55
msgid "Kenner van Azura"
msgstr "Scholar of Azura"

#. Uitleg bij prestatie meer_lezer
#: scripts/data/ext/meer.gd:55
msgid "Lees alle oude boeken in de bibliotheek van het Zilvermeer."
msgstr "Read all the old books in the library at Silver Lake."

#. Naam van prestatie diepte_open
#: scripts/data/ext/diepte.gd:148
msgid "Onder de tempel"
msgstr "Beneath the Temple"

#. Uitleg bij prestatie diepte_open
#: scripts/data/ext/diepte.gd:148
msgid "Breek het zegel en daal af in De Diepte."
msgstr "Break the seal and go down into the Depths."

#. Naam van prestatie diepte_wachter
#: scripts/data/ext/diepte.gd:152
msgid "Hoeder van de Sterrenkaart"
msgstr "Keeper of the Star Map"

#. Uitleg bij prestatie diepte_wachter
#: scripts/data/ext/diepte.gd:152
msgid "Versla De Vergeten Wachter."
msgstr "Defeat the Forgotten Guardian."

#. Naam van prestatie diepte_hartjes
#: scripts/data/ext/diepte.gd:156
msgid "Acht hartjes"
msgstr "Eight Hearts"

#. Uitleg bij prestatie diepte_hartjes
#: scripts/data/ext/diepte.gd:156
msgid "Heb het maximum van acht hartjes."
msgstr "Reach the max of eight hearts."

#. Naam van prestatie lantaarn_gevonden
#: scripts/data/ext/polijst.gd:300
msgid "Licht in de duisternis"
