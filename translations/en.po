msgstr "Spend a night at the inn."

#. Naam van prestatie rich
#: scripts/data/achievements.gd:102
msgid "Goudkoorts"
msgstr "Gold Fever"

#. Uitleg bij prestatie rich
#: scripts/data/achievements.gd:102
msgid "Heb 150 munten tegelijk in je zak."
msgstr "Have 150 coins in your pocket at once."

#. Naam van prestatie boog_schietbaan
#: scripts/data/ext/boog.gd:40
