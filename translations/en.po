msgstr ""

#. Kaart depths1, sign [9, 25]: tekst op een bord
#: scripts/maps/depths1.gd:51
msgid "Op de muur staan oude woorden:"
msgstr ""

#. Kaart depths1, sign [9, 25]: tekst op een bord
#: scripts/maps/depths1.gd:51
