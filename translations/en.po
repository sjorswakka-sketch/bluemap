#. Titel van opdracht main
#. Titel van boek blauwe_kaart (bibliotheek)
#: scripts/data/quests.gd:10 scripts/data/ext/meer_boeken.gd:17
msgid "De Blauwe Kaart"
msgstr ""

#. Opdracht main, stap 1
#: scripts/data/quests.gd:14
msgid "Vind de drie kaartkristallen: in het Fluisterbos, de Vergeten Ruïne en de Echo-grot. ({crystals}/3)"
msgstr ""

#. Opdracht main, stap 2
#: scripts/data/quests.gd:17
msgid "Breng de kristallen naar Oudste Bram bij de tempel."
msgstr ""

#. Opdracht main, stap 3
#: scripts/data/quests.gd:18
msgid "Versla de Slijmkoning in de Kristaltempel (de deur in het dorp staat nu open)."
msgstr ""

#. Titel van opdracht kat
#: scripts/data/quests.gd:22
msgid "Muis de kat"
msgstr ""

#. Opdracht kat, stap 1
#: scripts/data/quests.gd:25
msgid "Pim mist zijn kat Muis. Zoek haar in het Fluisterbos."
msgstr ""

#. Opdracht kat, stap 2
#: scripts/data/quests.gd:28
msgid "Muis is gevonden! Vertel het aan Pim in het dorp."
msgstr ""

#. Titel van opdracht medaillon
#: scripts/data/quests.gd:32
msgid "Het medaillon van Wilfred"
msgstr ""

#. Opdracht medaillon, stap 1
#: scripts/data/quests.gd:35
msgid "Wilfred, de geest in de Ruïne, zoekt zijn medaillon. Het ligt ergens in de Echo-grot."
msgstr ""

#. Opdracht medaillon, stap 2
#: scripts/data/quests.gd:38
msgid "Breng het medaillon naar Wilfred in de Vergeten Ruïne."
msgstr ""

#. Titel van opdracht drank
#: scripts/data/quests.gd:42
msgid "Slijmgel voor Mila"
msgstr ""

#. Opdracht drank, stap 1
#: scripts/data/quests.gd:45
msgid "Mila wil drankjes brouwen. Breng haar 5 slijmgel. ({gel}/5)"
msgstr ""

#. Opdracht drank, stap 2
#: scripts/data/quests.gd:48
msgid "Geef de slijmgel aan Mila in de herberg."
msgstr ""

#. Titel van opdracht boog_schietbaan
#: scripts/data/ext/boog.gd:64
msgid "Schietbaan"
msgstr ""

#. Opdracht boog_schietbaan, stap 1
#: scripts/data/ext/boog.gd:67
msgid "Raak alle drie de doelwitten op Tessa's schietbaan binnen 20 seconden. Praat met Tessa voor een poging."
msgstr ""

#. Opdracht boog_schietbaan, stap 2
#: scripts/data/ext/boog.gd:70
msgid "Gehaald! Ga naar Tessa voor je beloning."
msgstr ""

#. Titel van opdracht meer_karper
#: scripts/data/ext/meer.gd:105
msgid "De Gouden Karper"
msgstr ""

#. Opdracht meer_karper, stap 1
#: scripts/data/ext/meer.gd:108
msgid "Visser Joris droomt van de Gouden Karper. Vang hem in diep water, aan het eind van de verre steiger in het Zilvermeer."
msgstr ""

#. Opdracht meer_karper, stap 2
#: scripts/data/ext/meer.gd:111
msgid "Je hebt de Gouden Karper! Breng hem naar Visser Joris in het Zilvermeer."
msgstr ""

#. Titel van opdracht meer_boeken
#. Naam van prestatie meer_boekenwurm
#: scripts/data/ext/meer.gd:51 scripts/data/ext/meer.gd:115
msgid "Boekenwurm"
msgstr ""

#. Opdracht meer_boeken, stap 1
#: scripts/data/ext/meer.gd:118
msgid "Lena van de bibliotheek mist drie boeken: één op het eiland in het Zilvermeer, één in het huisje van Joris en één bij Sanne. ({boeken}/3)"
msgstr ""

#. Opdracht meer_boeken, stap 2
#: scripts/data/ext/meer.gd:121
msgid "Je hebt alle drie de boeken! Breng ze naar Lena in de bibliotheek."
msgstr ""

#. Opdracht diepte, stap 1
#: scripts/data/ext/diepte.gd:77
msgid "Het rommelt onder de Kristaltempel. Zoek achterin de tempel naar een weg naar beneden."
msgstr ""

#. Opdracht diepte, stap 2
#: scripts/data/ext/diepte.gd:81
msgid "Het zegel is gebroken! Zoek in de Kristalgangen een sleutel voor de kristalpoort."
msgstr ""

#. Opdracht diepte, stap 3
#: scripts/data/ext/diepte.gd:85
msgid "De poort is open. Neem de trap naar Het Hart van de Kaart. Neem genoeg drankjes mee!"
msgstr ""

#. Opdracht diepte, stap 4
#: scripts/data/ext/diepte.gd:89
msgid "Versla De Vergeten Wachter! Rol door zijn scherven en sla toe na zijn aanval. Laat hem tegen een pilaar knallen: dan is hij even duizelig!"
msgstr ""

#. Titel van opdracht arena_kampioen
#. Titel die je krijgt voor arena-rang gold ("Hé {arena_title}!")
#: scripts/data/arena.gd:36 scripts/data/ext/arena.gd:61
msgid "Arenakampioen"
msgstr ""

#. Opdracht arena_kampioen, stap 1
#: scripts/data/ext/arena.gd:64
msgid "Win de Brons-rang in de arena, in het noordoosten van het dorp. Arenameester Bruno schrijft je in."
msgstr ""

#. Opdracht arena_kampioen, stap 2
#: scripts/data/ext/arena.gd:68
msgid "Win de Zilver-rang in de arena."
msgstr ""

#. Opdracht arena_kampioen, stap 3
#: scripts/data/ext/arena.gd:71
msgid "Win de Goud-rang en word Arenakampioen! In de laatste ronde staat een kristalgolem."
msgstr ""

