msgstr[0] "The gates close. %d round!"
msgstr[1] "The gates close. %d rounds!"

#: scripts/entities/arena_master.gd:167
msgid "Ronde %d"
msgstr "Round %d"

#: scripts/entities/arena_master.gd:167
msgid "Laatste ronde!"
msgstr "Final round!"

#: scripts/entities/arena_master.gd:278
msgid "Ronde %d gehaald!"
msgstr "Round %d cleared!"

#: scripts/entities/arena_master.gd:278
msgid "Even rust..."
msgstr "Take a breather..."

#: scripts/entities/arena_master.gd:317
msgid "Het publiek gooit een hartje!"
msgstr "The crowd throws you a heart!"

#. naam van een arena-rang ("Brons gehaald!"); daaronder je tijd (1:36)
#: scripts/entities/arena_master.gd:357
