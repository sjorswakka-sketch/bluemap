msgstr ""

#. Vijand mage: tip als je hem voor het eerst ziet
#: scripts/data/ext/vijanden.gd:26
msgid "Een Magiër! Sla zijn tovervonk stuk of wijk uit."
msgstr ""

#. Naam van vijand slime_spitter
#: scripts/data/ext/vijanden.gd:31
msgid "Slijmspuwer"
msgstr ""

#. Vijand slime_spitter: grappige beschrijving in het beestenboek
#: scripts/data/ext/vijanden.gd:38
msgid "Een slijm met een veel te grote mond, en hij gebruikt hem ook. Kom je te dichtbij, dan hupt hij weg om het opnieuw te proberen."
msgstr ""

#. Vijand slime_spitter: tip als je hem voor het eerst ziet
#: scripts/data/ext/vijanden.gd:36
msgid "Een Slijmspuwer! Rol weg als hij spuugt. Kom je dichtbij, dan hupt hij weg."
msgstr ""

#. Naam van vijand diepte_golem
