msgstr ""

#. Kaart arena, gate [12, 16]: melding als hij op slot zit
#. Kaart arena, portal [12, 16]: melding als hij op slot zit
#: scripts/maps/arena.gd:35 scripts/maps/arena.gd:36
msgid "De poorten blijven dicht tot je alle rondes hebt gewonnen. Opgeven kan bij de gong."
msgstr ""

#. Naam van wie er praat (Gesprek bram_intro)
#. Naam van wie er praat (Gesprek bram_intro2)
#. Naam van wie er praat (Gesprek bram_explain)
#. Naam van wie er praat (Gesprek bram_accept)
#. Naam van wie er praat (Gesprek bram_later)
#. Naam van wie er praat (Gesprek bram_progress)
#: scripts/ui/ending.gd:53 scripts/data/dialogue.gd:18 scripts/data/dialogue.gd:27 scripts/data/dialogue.gd:39
msgid "Oudste Bram"
msgstr ""

#. Gesprek bram_intro, Oudste Bram zegt
#: scripts/data/dialogue.gd:20
msgid "Ah, een reiziger! Welkom in Dageraadsdorp."
msgstr ""

#. Gesprek bram_intro, Oudste Bram zegt
#: scripts/data/dialogue.gd:21
msgid "Ik ben Bram, de oudste van het dorp en de bewaker van de Blauwe Kaart."
msgstr ""

#. Gesprek bram_intro, Oudste Bram zegt
#: scripts/data/dialogue.gd:22
msgid "Kijk, in de tempel hangt de kaart van heel Azura, gemaakt van gloeiend kristal. Hij houdt de slijmen rustig en laat zien waar het land veilig is."
msgstr ""

#. Gesprek bram_intro2, Oudste Bram zegt
#: scripts/data/dialogue.gd:29
msgid "Maar drie nachten geleden barstte de kaart. De drie grote kristallen sprongen eruit en vlogen het land in: naar het Fluisterbos, de Vergeten Ruïne en de Echo-grot."
msgstr ""

#. Gesprek bram_intro2, Oudste Bram zegt
#: scripts/data/dialogue.gd:30
msgid "Sindsdien zijn de slijmen wild geworden. En onder de tempel... daar hoor ik iets groots bewegen."
msgstr ""

#. Gesprek bram_intro2: keuze van de speler
#. Gesprek bram_explain: keuze van de speler
#: scripts/data/dialogue.gd:33 scripts/data/dialogue.gd:45
msgid "Ik help je!"
msgstr ""

#. Gesprek bram_intro2: keuze van de speler
#: scripts/data/dialogue.gd:34
msgid "Wat moet ik precies doen?"
msgstr ""

#. Gesprek bram_intro2: keuze van de speler
#: scripts/data/dialogue.gd:35
msgid "Ik moet er even over nadenken."
msgstr ""

#. Gesprek bram_explain, Oudste Bram zegt
#: scripts/data/dialogue.gd:41
msgid "Zoek de drie kaartkristallen en breng ze naar mij. Het Fluisterbos ligt over de brug in het oosten, de Wachter Hein houdt er een oogje op."
msgstr ""

#. Gesprek bram_explain, Oudste Bram zegt
#: scripts/data/dialogue.gd:42
msgid "Met een houten zwaard kom je niet ver. Greta de smid kan beter spul maken als je haar slijmgel brengt, en Tobias verkoopt drankjes."
msgstr ""

#. Gesprek bram_explain: keuze van de speler
#: scripts/data/dialogue.gd:46
msgid "Ik kom straks terug."
msgstr ""

#. Gesprek bram_accept, Oudste Bram zegt
#: scripts/data/dialogue.gd:52
msgid "Dank je, held! Neem dit mee voor onderweg."
msgstr ""

#. Gesprek bram_accept, Oudste Bram zegt
#: scripts/data/dialogue.gd:53
msgid "Een helddrank. Druk op H als je gewond bent. En rol met Shift om aanvallen te ontwijken, dan kan niets je raken!"
msgstr ""

#. Gesprek bram_later, Oudste Bram zegt
#: scripts/data/dialogue.gd:59
msgid "Neem de tijd. Maar de slijmen wachten niet..."
msgstr ""

#. Gesprek bram_progress, Oudste Bram zegt
#: scripts/data/dialogue.gd:64
msgid "Hoe gaat het met de zoektocht? Je hebt {crystals} van de 3 kristallen."
msgstr ""

#. Gesprek bram_progress, Oudste Bram zegt
#: scripts/data/dialogue.gd:65
msgid "Het Fluisterbos, de Vergeten Ruïne en de Echo-grot. Pas goed op jezelf!"
msgstr ""

#. Gesprek bram_crystals, Oudste Bram zegt
#: scripts/data/dialogue.gd:71
msgid "Je hebt ze alle drie! Ik kan het bijna niet geloven..."
msgstr ""

#. Gesprek bram_crystals, Oudste Bram zegt
#: scripts/data/dialogue.gd:72
msgid "Geef maar hier. Ik leg ze terug in de Blauwe Kaart."
msgstr ""

#. Gesprek bram_crystals2, Oudste Bram zegt
#: scripts/data/dialogue.gd:80
msgid "Kijk! De kaart gloeit weer. Maar luister... de deur van de tempel is opengesprongen."
msgstr ""

#. Gesprek bram_crystals2, Oudste Bram zegt
#: scripts/data/dialogue.gd:81
msgid "Daarbeneden zit de Slijmkoning. Hij dronk de kracht van de gebarsten kaart en is gigantisch geworden."
msgstr ""

#. Gesprek bram_crystals2, Oudste Bram zegt
#: scripts/data/dialogue.gd:82
msgid "Alleen jij kunt hem nog stoppen. Rust uit in de herberg, drink een drankje en neem je beste zwaard mee."
msgstr ""

#. Gesprek bram_crystals2, Oudste Bram zegt
#: scripts/data/dialogue.gd:83
msgid "Veel succes, held. Heel Azura rekent op je."
msgstr ""

#. Gesprek bram_boss_wait, Oudste Bram zegt
#: scripts/data/dialogue.gd:89
msgid "De tempeldeur staat open. Rust eerst goed uit in de herberg, dan ben je er klaar voor."
msgstr ""

#. Gesprek bram_done, Oudste Bram zegt
#: scripts/data/dialogue.gd:94
msgid "Dankzij jou is de Blauwe Kaart weer heel!"
msgstr ""

#. Gesprek bram_done, Oudste Bram zegt
#: scripts/data/dialogue.gd:95
msgid "Het dorp viert feest. Rust maar uit, held. Je hebt het verdiend."
msgstr ""

#. Naam van wie er praat (Gesprek greta_intro)
#. Naam van wie er praat (Gesprek greta_menu)
#. Naam van wie er praat (Gesprek greta_iron)
#. Naam van wie er praat (Gesprek greta_iron_ask)
#. Naam van wie er praat (Gesprek greta_iron_no)
#. Naam van wie er praat (Gesprek greta_iron_done)
#: scripts/ui/ending.gd:54 scripts/data/dialogue.gd:101 scripts/data/dialogue.gd:110 scripts/data/dialogue.gd:119
msgid "Greta"
msgstr ""

#. Gesprek greta_intro, Greta zegt
#: scripts/data/dialogue.gd:103
msgid "Hé! Jij bent dat reizigertje van Bram, hè? Ik ben Greta, de smid."
msgstr ""

#. Gesprek greta_intro, Greta zegt
#: scripts/data/dialogue.gd:104
msgid "Dat houten ding van jou is geen zwaard, het is een stok met ambitie."
msgstr ""

#. Gesprek greta_menu, Greta zegt
#: scripts/data/dialogue.gd:111
msgid "Wat kan ik voor je smeden?"
msgstr ""

#. Gesprek greta_menu: keuze van de speler
#: scripts/data/dialogue.gd:113
msgid "Een ijzeren zwaard"
msgstr ""

#. Gesprek greta_menu: keuze van de speler
#: scripts/data/dialogue.gd:114
msgid "Een kristalzwaard"
msgstr ""

#. Gesprek greta_menu: keuze van de speler
#: scripts/data/dialogue.gd:115
msgid "Niets, bedankt."
msgstr ""

#. Gesprek greta_iron, Greta zegt
#: scripts/data/dialogue.gd:120
msgid "Een ijzeren zwaard? Dat kost 5 slijmgel en 40 munten. Je hebt {gel} slijmgel en {coins} munten."
msgstr ""

#. Gesprek greta_iron_ask, Greta zegt
#: scripts/data/dialogue.gd:128
msgid "Dat kan! Zal ik hem voor je smeden?"
msgstr ""

#. Gesprek greta_iron_ask: keuze van de speler
#. Gesprek greta_crystal_ask: keuze van de speler
#: scripts/data/dialogue.gd:131 scripts/data/dialogue.gd:162
msgid "Ja, smeed maar!"
msgstr ""

#. Gesprek greta_iron_ask: keuze van de speler
#. Gesprek greta_crystal_ask: keuze van de speler
#. Gesprek wereld_bed_menu: keuze van de speler
#. Gesprek arena_bronze_ask: keuze van de speler
#. Gesprek arena_silver_ask: keuze van de speler
#. Gesprek arena_gold_ask: keuze van de speler
#: scripts/data/dialogue.gd:135 scripts/data/dialogue.gd:166 scripts/data/ext/arena.gd:139 scripts/data/ext/arena.gd:158
msgid "Nog even niet."
msgstr ""

#. Gesprek greta_iron_no, Greta zegt
#: scripts/data/dialogue.gd:140
msgid "Dan ben je nog niet klaar. Slijmen in het bos laten slijmgel vallen. Kom maar terug als je genoeg hebt."
msgstr ""

#. Gesprek greta_iron_done, Greta zegt
#: scripts/data/dialogue.gd:144
msgid "Zo! Voel dat gewicht eens. Dit raakt een stuk harder dan je stok."
msgstr ""

#. Gesprek greta_crystal, Greta zegt
#: scripts/data/dialogue.gd:149
msgid "Een kristalzwaard... Dat is werk voor een meester. Ik heb 2 kristalscherven nodig, 8 slijmgel en 80 munten."
msgstr ""

#. Gesprek greta_crystal, Greta zegt
#: scripts/data/dialogue.gd:150
msgid "Je hebt {shards} scherven, {gel} slijmgel en {coins} munten. Golems in de ruïne en de grot laten scherven vallen."
msgstr ""

#. Gesprek greta_crystal_ask, Greta zegt
#: scripts/data/dialogue.gd:159
msgid "Je hebt alles! Dit wordt mijn mooiste zwaard. Zal ik beginnen?"
msgstr ""

#. Gesprek greta_crystal_no, Greta zegt
#: scripts/data/dialogue.gd:171
msgid "Nog niet genoeg. Kom terug als je alles hebt, dan maak ik er iets moois van."
msgstr ""

#. Gesprek greta_crystal_done, Greta zegt
#: scripts/data/dialogue.gd:175
msgid "Kijk dat nou... het gloeit! Pas er goed op, dit is het beste wat ik ooit gemaakt heb."
msgstr ""

#. Gesprek greta_max, Greta zegt
#: scripts/data/dialogue.gd:179
msgid "Dat kristalzwaard is mijn beste werk. Meer kan ik er niet aan doen. Ga ze maar een lesje leren!"
msgstr ""

#. Gesprek greta_done, Greta zegt
#: scripts/data/dialogue.gd:184
msgid "De held van Azura in mijn smederij! Ik heb net nieuwe zwaarden gesmeed, voor op het feest. Nou ja, voor de taart."
msgstr ""

#. Naam van wie er praat (Gesprek tobias_intro)
#. Naam van wie er praat (Gesprek tobias_menu)
#. Naam van wie er praat (Gesprek tobias_sell)
#. Naam van wie er praat (Gesprek tobias_sold)
#. Naam van wie er praat (Gesprek tobias_done)
#: scripts/ui/ending.gd:55 scripts/data/dialogue.gd:194 scripts/data/dialogue.gd:200 scripts/data/dialogue.gd:209
msgid "Tobias"
msgstr ""

#. Gesprek tobias_intro, Tobias zegt
#: scripts/data/dialogue.gd:195
msgid "Welkom, welkom! Tobias, koopman van de beste waar van heel Azura!"
msgstr ""

#. Gesprek tobias_intro, Tobias zegt
#: scripts/data/dialogue.gd:195
msgid "Of eigenlijk van het hele dorp. Maar dat is wel eerlijk gezegd het enige."
msgstr ""

#. Gesprek tobias_menu, Tobias zegt
#: scripts/data/dialogue.gd:201
msgid "Zeg het maar, wat mag het zijn?"
msgstr ""

#. Gesprek tobias_menu: keuze van de speler
#: scripts/data/dialogue.gd:203
msgid "Ik wil iets kopen."
msgstr ""

#. Gesprek tobias_menu: keuze van de speler
#: scripts/data/dialogue.gd:204
msgid "Ik wil slijmgel verkopen."
msgstr ""

#. Gesprek tobias_menu: keuze van de speler
#. Gesprek meer_joris_menu: keuze van de speler
#. Gesprek arena_bruno_menu: keuze van de speler
#: scripts/data/dialogue.gd:205 scripts/data/ext/arena.gd:110 scripts/data/ext/meer.gd:186
msgid "Tot ziens."
msgstr ""

#. Gesprek tobias_sell, Tobias zegt
#: scripts/data/dialogue.gd:210
msgid "Slijmgel? Prima spul! Ik geef 3 munten per stuk. Je hebt {gel} stuks. Pas op: Greta en Mila hebben het ook nodig."
msgstr ""

#. Gesprek tobias_sell: keuze van de speler
#: scripts/data/dialogue.gd:212
msgid "Verkoop alles."
msgstr ""

#. Gesprek tobias_sell: keuze van de speler
#. Gesprek arena_bruno_ranks: keuze van de speler
#: scripts/data/dialogue.gd:213 scripts/data/ext/arena.gd:120
msgid "Toch maar niet."
msgstr ""

#. Gesprek tobias_sold, Tobias zegt
#: scripts/data/dialogue.gd:218
msgid "Prima zaken doen met jou!"
msgstr ""

#. Gesprek tobias_done, Tobias zegt
#: scripts/data/dialogue.gd:223
msgid "Mijn omzet is verdubbeld sinds de Slijmkoning weg is! Alles blijft voor jou gewoon hetzelfde. Maar dan wel met een knipoog."
msgstr ""

#. Naam van wie er praat (Gesprek mila_intro)
#. Naam van wie er praat (Gesprek mila_menu)
#. Naam van wie er praat (Gesprek mila_rest)
#. Naam van wie er praat (Gesprek mila_quest)
#. Naam van wie er praat (Gesprek mila_quest_ok)
#. Naam van wie er praat (Gesprek mila_potion_progress)
#: scripts/ui/ending.gd:56 scripts/data/dialogue.gd:230 scripts/data/dialogue.gd:239 scripts/data/dialogue.gd:250
msgid "Mila"
msgstr ""

#. Gesprek mila_intro, Mila zegt
#: scripts/data/dialogue.gd:232
msgid "Welkom in de herberg! Ik ben Mila."
msgstr ""

#. Gesprek mila_intro, Mila zegt
#: scripts/data/dialogue.gd:233
msgid "Je mag hier altijd uitrusten, dat is gratis voor een held. Je wordt helemaal beter en ik schrijf op waar je gebleven was."
msgstr ""

#. Gesprek mila_menu, Mila zegt
#: scripts/data/dialogue.gd:240
msgid "Hoe kan ik je helpen?"
msgstr ""

#. Gesprek mila_menu: keuze van de speler
#: scripts/data/dialogue.gd:242
msgid "Ik wil uitrusten."
msgstr ""

#. Gesprek mila_menu: keuze van de speler
#: scripts/data/dialogue.gd:243
msgid "Ik heb verse vis voor je! ({visgeld} munten)"
msgstr ""

#. Gesprek mila_menu: keuze van de speler
#. Gesprek meer_joris_menu: keuze van de speler
#. Gesprek meer_lena_menu: keuze van de speler
#: scripts/data/dialogue.gd:244 scripts/data/ext/meer.gd:182 scripts/data/ext/meer.gd:330
msgid "Heb je werk voor me?"
msgstr ""

#. Gesprek mila_menu: keuze van de speler
#: scripts/data/dialogue.gd:245
msgid "Mag ik hier slapen?"
msgstr ""

#. Gesprek mila_menu: keuze van de speler
#. Gesprek meer_lena_menu: keuze van de speler
#: scripts/data/dialogue.gd:246 scripts/data/ext/meer.gd:333
msgid "Nee, bedankt."
msgstr ""

#. Gesprek mila_rest, Mila zegt
#: scripts/data/dialogue.gd:251
msgid "Zo, helemaal opgeknapt! Ik heb je voortgang opgeschreven."
msgstr ""

#. Gesprek mila_quest, Mila zegt
#: scripts/data/dialogue.gd:256
msgid "Eigenlijk wel! Ik wil helddrankjes brouwen voor het dorp, maar ik heb slijmgel nodig. Vijf stuks."
msgstr ""

#. Gesprek mila_quest, Mila zegt
#: scripts/data/dialogue.gd:257
msgid "Breng je ze mij, dan krijg je er drie drankjes en wat munten voor je moeite."
msgstr ""

#. Gesprek mila_quest: keuze van de speler
#: scripts/data/dialogue.gd:260
msgid "Dat doe ik."
msgstr ""

#. Gesprek mila_quest: keuze van de speler
#. Gesprek pim_intro: keuze van de speler
#. Gesprek meer_joris_karper_vraag: keuze van de speler
#. Gesprek meer_lena_vraag: keuze van de speler
#: scripts/data/dialogue.gd:261 scripts/data/dialogue.gd:294 scripts/data/ext/meer.gd:267 scripts/data/ext/meer.gd:365
msgid "Misschien later."
msgstr ""

#. Gesprek mila_quest_ok, Mila zegt
#: scripts/data/dialogue.gd:266
msgid "Fijn! Slijmen in het bos laten het vaak vallen."
msgstr ""

#. Gesprek mila_potion_progress, Mila zegt
#: scripts/data/dialogue.gd:270
msgid "Heb je al genoeg slijmgel? Je hebt er {gel} van de 5."
msgstr ""

#. Gesprek mila_potion_done, Mila zegt
#: scripts/data/dialogue.gd:274
msgid "Slijmgel! Vijf stuks! Dan ga ik meteen aan de slag."
msgstr ""

#. Gesprek mila_potion_done, Mila zegt
#: scripts/data/dialogue.gd:274
msgid "Hier, drie helddrankjes en 25 munten. Dank je wel!"
msgstr ""

#. Gesprek mila_done, Mila zegt
#: scripts/data/dialogue.gd:280
msgid "De herberg zit vol met mensen die jou willen zien. Jouw bed is altijd vrij, held."
msgstr ""

#. Naam van wie er praat (Gesprek pim_intro)
#. Naam van wie er praat (Gesprek pim_ok)
#. Naam van wie er praat (Gesprek pim_progress)
#. Naam van wie er praat (Gesprek pim_cat_back)
#. Naam van wie er praat (Gesprek pim_done)
#. Naam van personage pim (boven zijn hoofd)
#: scripts/ui/ending.gd:57 scripts/data/dialogue.gd:287 scripts/data/dialogue.gd:298 scripts/data/dialogue.gd:302
msgid "Pim"
msgstr ""

#. Gesprek pim_intro, Pim zegt
#: scripts/data/dialogue.gd:289
msgid "Snif... Muis is weg!"
msgstr ""

#. Gesprek pim_intro, Pim zegt
#: scripts/data/dialogue.gd:290
msgid "Mijn kat Muis is gisteren het bos in gerend. Het is daar zo eng... Wil jij haar zoeken?"
msgstr ""

#. Gesprek pim_intro: keuze van de speler
#: scripts/data/dialogue.gd:293
msgid "Ik zoek haar wel!"
msgstr ""

#. Gesprek pim_ok, Pim zegt
#: scripts/data/dialogue.gd:299
msgid "Echt waar?! Dankjewel! Ze is wit met een zwart vlekje op haar neus."
msgstr ""

#. Gesprek pim_progress, Pim zegt
#: scripts/data/dialogue.gd:303
msgid "Heb je Muis al gezien? Ze is wit met een zwart vlekje op haar neus."
msgstr ""

#. Gesprek pim_cat_back, Pim zegt
#: scripts/data/dialogue.gd:308
msgid "Muis!!! Je hebt haar gevonden!"
msgstr ""

#. Gesprek pim_cat_back, Pim zegt
#: scripts/data/dialogue.gd:309
msgid "Dankjewel, dankjewel! Hier, dit vond ik in het bos. Het is vast iets waard."
msgstr ""

#. Gesprek pim_done, Pim zegt
#: scripts/data/dialogue.gd:315
msgid "Muis slaapt de hele dag op mijn bed. Ze is wel een beetje dik geworden van het bos."
msgstr ""

#. Naam van wie er praat (Gesprek muis_bos)
#. Naam van wie er praat (Gesprek muis_dorp)
#. Naam van personage muis_bos (boven zijn hoofd)
#. Naam van personage muis_dorp (boven zijn hoofd)
#: scripts/data/dialogue.gd:318 scripts/data/dialogue.gd:326 scripts/data/npcs.gd:89 scripts/data/npcs.gd:93
msgid "Muis"
msgstr ""

#. Gesprek muis_bos, Muis zegt
#: scripts/data/dialogue.gd:320
msgid "Miauw?"
msgstr ""

#. Gesprek muis_bos, Muis zegt
#: scripts/data/dialogue.gd:321
msgid "Muis snuffelt aan je hand en rent met een grote boog het bos uit, richting het dorp."
msgstr ""

#. Gesprek muis_dorp, Muis zegt
#: scripts/data/dialogue.gd:327
msgid "Miauw. (Ze rolt zich op en begint te spinnen.)"
msgstr ""

#. Naam van wie er praat (Gesprek hein_talk)
#. Naam van wie er praat (Gesprek hein_done)
#. Naam van personage hein (boven zijn hoofd)
#: scripts/data/dialogue.gd:332 scripts/data/dialogue.gd:339 scripts/data/npcs.gd:58
msgid "Wachter Hein"
msgstr ""

#. Gesprek hein_talk, Wachter Hein zegt
#: scripts/data/dialogue.gd:334
msgid "Halt! Oh, jij bent het. Het Fluisterbos is gevaarlijk: slijmen en vleermuizen overal."
msgstr ""

#. Gesprek hein_talk, Wachter Hein zegt
#: scripts/data/dialogue.gd:335
msgid "Een tip: met Shift rol je weg en kan niets je raken. En de blauwe altaren slaan je voortgang op."
msgstr ""

#. Gesprek hein_done, Wachter Hein zegt
#: scripts/data/dialogue.gd:340
msgid "Het bos is veel rustiger sinds je de Slijmkoning hebt verslagen. Bedankt, held!"
msgstr ""

#. Naam van wie er praat (Gesprek anja_talk)
#. Naam van wie er praat (Gesprek anja_done)
#. Naam van personage anja (boven zijn hoofd)
#: scripts/data/dialogue.gd:343 scripts/data/dialogue.gd:350 scripts/data/npcs.gd:65
msgid "Anja"
msgstr ""

#. Gesprek anja_talk, Anja zegt
#: scripts/data/dialogue.gd:345
msgid "De Blauwe Kaart is al duizend jaar oud. Mijn oma zei altijd dat hij het land beschermt."
msgstr ""

#. Gesprek anja_talk, Anja zegt
#: scripts/data/dialogue.gd:346
msgid "Als die kaart echt breekt, wordt Azura weer wild. Gelukkig heb jij nu die opdracht!"
msgstr ""

#. Gesprek anja_done, Anja zegt
#: scripts/data/dialogue.gd:351
msgid "Heb je het gehoord? De Blauwe Kaart straalt weer helderblauw! Alles dankzij jou."
msgstr ""

#. Naam van wie er praat (Gesprek joost_done)
#. Naam van wie er praat (Gesprek joost_talk)
#. Naam van wie er praat (Gesprek joost_key)
#. Naam van personage joost (boven zijn hoofd)
#: scripts/data/dialogue.gd:354 scripts/data/dialogue.gd:358 scripts/data/dialogue.gd:365 scripts/data/npcs.gd:72
msgid "Joost"
msgstr ""

#. Gesprek joost_done, Joost zegt
#: scripts/data/dialogue.gd:355
msgid "De slijmen zijn rustiger nu de kaart weer heel is. Ik gaf er een een appel. Hij at hem op. Het was raar."
msgstr ""

#. Gesprek joost_talk, Joost zegt
#: scripts/data/dialogue.gd:360
msgid "De Vergeten Ruïne is dichtgemetseld met een poortje. Je hebt de sleutel nodig."
msgstr ""

#. Gesprek joost_talk, Joost zegt
#: scripts/data/dialogue.gd:361
msgid "Ik hoorde dat er ergens in het bos een kist ligt, bewaakt door slijmen. Misschien zit daar iets in..."
msgstr ""

#. Gesprek joost_key, Joost zegt
#: scripts/data/dialogue.gd:366
msgid "Is dat een sleutel? Dan weet je wat je moet doen: naar het poortje van de ruïne, in het noordoosten van het bos!"
msgstr ""

#. Naam van wie er praat (Gesprek wilfred_intro)
#. Naam van wie er praat (Gesprek wilfred_ok)
#. Naam van wie er praat (Gesprek wilfred_progress)
#. Naam van wie er praat (Gesprek wilfred_return)
#. Naam van wie er praat (Gesprek wilfred_done)
#. Naam van personage wilfred (boven zijn hoofd)
#: scripts/data/dialogue.gd:371 scripts/data/dialogue.gd:382 scripts/data/dialogue.gd:386 scripts/data/dialogue.gd:390
msgid "Wilfred"
msgstr ""

#. Gesprek wilfred_intro, Wilfred zegt
#: scripts/data/dialogue.gd:373
msgid "Ooooh... een levende! Wees niet bang, ik bijt niet. Ik ben Wilfred."
msgstr ""

#. Gesprek wilfred_intro, Wilfred zegt
#: scripts/data/dialogue.gd:374
msgid "Ik was de bewaker van deze ruïne, lang geleden. Mijn medaillon is zoekgeraakt... ik denk dat het in de Echo-grot ligt."
msgstr ""

#. Gesprek wilfred_intro: keuze van de speler
#: scripts/data/dialogue.gd:377
msgid "Ik breng het terug."
msgstr ""

#. Gesprek wilfred_intro: keuze van de speler
#: scripts/data/dialogue.gd:378
msgid "Sorry, geen tijd."
msgstr ""

#. Gesprek wilfred_ok, Wilfred zegt
#: scripts/data/dialogue.gd:383
msgid "Wat aardig van je. Het is een zilveren medaillon met mijn naam erin."
msgstr ""

#. Gesprek wilfred_progress, Wilfred zegt
#: scripts/data/dialogue.gd:387
msgid "Zoek je mijn medaillon nog? Het ligt in de Echo-grot, ergens diep onder de grond."
msgstr ""

#. Gesprek wilfred_return, Wilfred zegt
#: scripts/data/dialogue.gd:392
msgid "Mijn medaillon! Na al die jaren!"
msgstr ""

#. Gesprek wilfred_return, Wilfred zegt
#: scripts/data/dialogue.gd:393
msgid "Neem deze kristalscherven als dank. Ze zijn van een kaartkristal dat hier ooit brak."
msgstr ""

#. Gesprek wilfred_done, Wilfred zegt
#: scripts/data/dialogue.gd:399
msgid "Nu kan ik eindelijk rusten. Dank je, vriend."
msgstr ""

#. Naam van wie er praat (Gesprek king_intro)
#. Naam van vijand king
#: scripts/data/dialogue.gd:404 scripts/data/enemies.gd:62
msgid "De Slijmkoning"
msgstr ""

#. Gesprek king_intro, De Slijmkoning zegt
#: scripts/data/dialogue.gd:406
msgid "Blub... blub blub..."
msgstr ""

#. Gesprek king_intro, De Slijmkoning zegt
#: scripts/data/dialogue.gd:407
msgid "WIE DURFT MIJN TEMPEL BINNEN TE KOMEN?!"
msgstr ""

#. Gesprek king_intro, De Slijmkoning zegt
#: scripts/data/dialogue.gd:408
msgid "De kaart is van MIJ! Ik zal je tot gel verwerken!"
msgstr ""

#. Naam van wie er praat (Gesprek tessa_nobow)
#. Naam van wie er praat (Gesprek tessa_intro)
#. Naam van wie er praat (Gesprek tessa_menu)
#. Naam van wie er praat (Gesprek tessa_go)
#. Naam van wie er praat (Gesprek tessa_howto)
#. Naam van wie er praat (Gesprek tessa_active)
#: scripts/data/ext/boog.gd:77 scripts/data/ext/boog.gd:85 scripts/data/ext/boog.gd:94 scripts/data/ext/boog.gd:114
msgid "Tessa"
msgstr ""

#. Gesprek tessa_nobow, Tessa zegt
#: scripts/data/ext/boog.gd:79
msgid "Hoi! Ik ben Tessa. Dit is mijn schietbaan."
msgstr ""

#. Gesprek tessa_nobow, Tessa zegt
#: scripts/data/ext/boog.gd:80
msgid "Zonder boog kun je hier niets doen, hoor. Tobias verkoopt ze in zijn winkel."
msgstr ""

#. Gesprek tessa_nobow, Tessa zegt
#: scripts/data/ext/boog.gd:81
msgid "Kom terug als je er een hebt. Dan leer ik je schieten!"
msgstr ""

#. Gesprek tessa_intro, Tessa zegt
#: scripts/data/ext/boog.gd:87
msgid "Hé, een boog! Kom maar hier."
msgstr ""

#. Gesprek tessa_intro, Tessa zegt
#: scripts/data/ext/boog.gd:88
msgid "Ik ben Tessa. Wachter Hein vindt het goed dat ik mijn schietbaan hier neerzet, vlak bij zijn post."
msgstr ""

#. Gesprek tessa_intro, Tessa zegt
#: scripts/data/ext/boog.gd:89
msgid "Zie je die drie doelwitten? Raak ze alle drie binnen 20 seconden, dan krijg je een beloning."
msgstr ""

#. Gesprek tessa_menu, Tessa zegt
#: scripts/data/ext/boog.gd:95
msgid "Zullen we schieten?"
msgstr ""

#. Gesprek tessa_menu: keuze van de speler
#: scripts/data/ext/boog.gd:98
msgid "Ik doe mee!"
msgstr ""

#. Gesprek tessa_menu: keuze van de speler
#: scripts/data/ext/boog.gd:102
msgid "Nog een poging!"
msgstr ""

#. Gesprek tessa_menu: keuze van de speler
#: scripts/data/ext/boog.gd:106
msgid "Oefenen, zonder beloning"
msgstr ""

#. Gesprek tessa_menu: keuze van de speler
#: scripts/data/ext/boog.gd:109
msgid "Hoe schiet ik?"
msgstr ""

#. Gesprek tessa_menu: keuze van de speler
#: scripts/data/ext/boog.gd:110
msgid "Straks misschien."
msgstr ""

#. Gesprek tessa_go, Tessa zegt
#: scripts/data/ext/boog.gd:116
msgid "Ga op de planken van de schietlijn staan. Van daar zie je alle drie de doelwitten."
msgstr ""

#. Gesprek tessa_go, Tessa zegt
#: scripts/data/ext/boog.gd:117
msgid "Ik tel af: 3, 2, 1... Bij \"Af!\" begint de tijd."
msgstr ""

#. Gesprek tessa_go, Tessa zegt
#: scripts/data/ext/boog.gd:118
msgid "Tijdens een poging schiet je met mijn pijlen. Dat kost jou dus niks. Succes!"
msgstr ""

#. Gesprek tessa_howto, Tessa zegt
#: scripts/data/ext/boog.gd:124
msgid "Druk op F om een pijl te schieten. Je schiet de kant op waarin je kijkt."
msgstr ""

#. Gesprek tessa_howto, Tessa zegt
#: scripts/data/ext/boog.gd:125
msgid "Loop je schuin? Dan vliegt je pijl ook schuin. Muren stoppen een pijl, maar over water vliegt hij gewoon heen."
msgstr ""

#. Gesprek tessa_howto, Tessa zegt
#: scripts/data/ext/boog.gd:126
msgid "Elk schot kost een pijl uit je pijlenkoker. Je kunt er 40 dragen. Hier op mijn baan leen je mijn pijlen."
msgstr ""

#. Gesprek tessa_active, Tessa zegt
#: scripts/data/ext/boog.gd:132
msgid "Het is je nog niet gelukt, hè? Geen zorgen. Iedereen mist wel eens."
msgstr ""

#. Gesprek tessa_done, Tessa zegt
#: scripts/data/ext/boog.gd:138
msgid "Daar is mijn beste schutter! De baan is altijd open."
msgstr ""

#. Gesprek tessa_done, Tessa zegt
#: scripts/data/ext/boog.gd:139
msgid "Een beloning krijg je maar één keer, maar oefenen mag zo vaak je wilt."
msgstr ""

#. Gesprek tessa_reward, Tessa zegt
#: scripts/data/ext/boog.gd:145
msgid "Alle drie raak! En nog binnen de tijd ook!"
msgstr ""

#. Gesprek tessa_reward_pay, Tessa zegt
#: scripts/data/ext/boog.gd:154
msgid "Hier is je beloning: 25 munten en 10 pijlen. Goed geschoten!"
msgstr ""

#. Gesprek tessa_reward_full, Tessa zegt
#: scripts/data/ext/boog.gd:160
msgid "Maar je pijlenkoker zit bijna vol. Mijn beloning past er dan niet meer in!"
msgstr ""

#. Gesprek tessa_reward_full, Tessa zegt
#: scripts/data/ext/boog.gd:161
msgid "Schiet eerst een paar pijlen af en kom dan terug."
msgstr ""

#. Gesprek meer_joris_intro, Visser Joris zegt
#: scripts/data/ext/meer.gd:161
msgid "Hmpf. Een bezoeker. Ik dacht dat de vissen het ergste waren, maar nee: mensen."
msgstr ""

#. Gesprek meer_joris_intro, Visser Joris zegt
#: scripts/data/ext/meer.gd:162
msgid "...Grapje. Ik ben Joris, visser van het Zilvermeer. Al veertig jaar. Ik heb meer vissen gezien dan jij haren hebt."
msgstr ""

#. Gesprek meer_joris_intro, Visser Joris zegt
#: scripts/data/ext/meer.gd:163
msgid "Je staat naar mijn hengel te kijken. Je wilt vissen, hè? Ik zie het aan je ogen. Ze glimmen als een baars."
msgstr ""

#. Gesprek meer_joris_hengel, Visser Joris zegt
#: scripts/data/ext/meer.gd:171
msgid "Hier, neem mijn reservehengel. Gratis. Maar behandel hem lief."
msgstr ""

#. Gesprek meer_joris_hengel, Visser Joris zegt
#: scripts/data/ext/meer.gd:172
msgid "Je vist bij een visplek: dat zijn de kringetjes in het water. Ga ernaast staan en druk op E. Wacht dan op een beet, en wees snel!"
msgstr ""

#. Gesprek meer_joris_menu, Visser Joris zegt
#: scripts/data/ext/meer.gd:179
msgid "Nou? Wat kan ik voor je doen?"
msgstr ""

#. Gesprek meer_joris_menu: keuze van de speler
#: scripts/data/ext/meer.gd:181
msgid "Verkoop al mijn vis ({visgeld} munten)"
msgstr ""

#. Gesprek meer_joris_menu: keuze van de speler
#: scripts/data/ext/meer.gd:183
msgid "Hoe is het met de Gouden Karper?"
msgstr ""

#. Gesprek meer_joris_menu: keuze van de speler
#: scripts/data/ext/meer.gd:184
msgid "Heb je tips over vissen?"
msgstr ""

#. Gesprek meer_joris_menu: keuze van de speler
#: scripts/data/ext/meer.gd:185
msgid "Hoe gaat het nu de Slijmkoning weg is?"
msgstr ""

#. Gesprek meer_joris_na, Visser Joris zegt
#: scripts/data/ext/meer.gd:192
msgid "De Slijmkoning is weg? Dat wist ik al. De vissen bijten weer als vanouds. Alleen die slijmen aan de overkant blijven brutaal."
msgstr ""

#. Gesprek meer_joris_na, Visser Joris zegt
#: scripts/data/ext/meer.gd:193
msgid "Ze eten nog steeds mijn aas. Maar ik begin ze bijna aardig te vinden. Vertel het niet door, ik heb een reputatie."
msgstr ""

#. Gesprek meer_joris_verkoop, Visser Joris zegt
#: scripts/data/ext/meer.gd:199
msgid "Laat maar zien... Hm. Hm-hm. Die zijn goed. Ik geef er een eerlijke prijs voor."
msgstr ""

#. Gesprek meer_joris_verkocht, Visser Joris zegt
#: scripts/data/ext/meer.gd:209
msgid "Zo. Eerlijk zaken doen, dat vind ik prettig. Kom maar terug als je meer hebt."
msgstr ""

#. Gesprek meer_joris_vol, Visser Joris zegt
#: scripts/data/ext/meer.gd:214
msgid "Pfff. Het hele dorp zit vol met vis. Ik heb vis in de kast, vis in de la en vis in mijn laarzen."
msgstr ""

#. Gesprek meer_joris_vol, Visser Joris zegt
#: scripts/data/ext/meer.gd:215
msgid "Vanaf nu betaal ik maar de helft. Dat is niet persoonlijk, hoor. Zo werkt de vismarkt."
msgstr ""

#. Gesprek meer_joris_vol_kort, Visser Joris zegt
#: scripts/data/ext/meer.gd:221
msgid "Hmpf. Het dorp zit nog steeds vol met vis. Ik betaal de helft, weet je nog?"
msgstr ""

#. Gesprek meer_joris_tips, Visser Joris zegt
#: scripts/data/ext/meer.gd:225
msgid "Tips? Ik heb alleen maar tips. Wat wil je weten?"
msgstr ""

#. Gesprek meer_joris_tips: keuze van de speler
#: scripts/data/ext/meer.gd:227
msgid "Hoe vang ik een vis?"
msgstr ""

#. Gesprek meer_joris_tips: keuze van de speler
#: scripts/data/ext/meer.gd:228
msgid "Waar zitten de grote vissen?"
msgstr ""

#. Gesprek meer_joris_tips: keuze van de speler
#: scripts/data/ext/meer.gd:229
msgid "Wat doe ik met mijn vis?"
msgstr ""

#. Gesprek meer_joris_tips: keuze van de speler
#: scripts/data/ext/meer.gd:230
msgid "Dank je, genoeg."
msgstr ""

#. Gesprek meer_joris_tip_vangen, Visser Joris zegt
#: scripts/data/ext/meer.gd:236
msgid "Gooi uit bij een visplek. Wacht tot de dobber zakt en er een uitroepteken verschijnt. Druk dan snel op E!"
msgstr ""

#. Gesprek meer_joris_tip_vangen, Visser Joris zegt
#: scripts/data/ext/meer.gd:237
msgid "Houd daarna E ingedrukt: dan stijgt de groene zone. Laat los, dan zakt hij. Houd de vis in het groen tot de balk vol is."
msgstr ""

#. Gesprek meer_joris_tip_diep, Visser Joris zegt
#: scripts/data/ext/meer.gd:244
msgid "In diep water. Aan het eind van de verre steiger, helemaal aan de oostkant van het meer."
msgstr ""

#. Gesprek meer_joris_tip_diep, Visser Joris zegt
#: scripts/data/ext/meer.gd:245
msgid "Daar zwemt de grootste vis van het meer. Ik heb hem één keer gezien. En nul keer gevangen."
msgstr ""

#. Gesprek meer_joris_tip_verkopen, Visser Joris zegt
#: scripts/data/ext/meer.gd:252
msgid "Verkopen, natuurlijk! Aan mij, of aan Mila in de herberg. Zij maakt er soep van."
msgstr ""

#. Gesprek meer_joris_tip_verkopen, Visser Joris zegt
#: scripts/data/ext/meer.gd:253
msgid "Maar pas op: als het dorp te veel vis heeft, gaat de prijs omlaag. Dat gaat zo met vis. Ook met mensen, trouwens."
msgstr ""

#. Gesprek meer_joris_karper_vraag, Visser Joris zegt
#: scripts/data/ext/meer.gd:260
msgid "Werk? Hmpf. Ja, eigenlijk wel. Maar je gaat me uitlachen."
msgstr ""

#. Gesprek meer_joris_karper_vraag, Visser Joris zegt
#: scripts/data/ext/meer.gd:261
msgid "Ik droom al jaren van de Gouden Karper. Een vis van puur goud. Grote ogen, glimmende schubben, veel te slim."
msgstr ""

#. Gesprek meer_joris_karper_vraag, Visser Joris zegt
#: scripts/data/ext/meer.gd:262
msgid "Ik heb hem één keer gezien, vanaf de verre steiger. Hij zwom langs, keek me aan en... lachte. Echt waar."
msgstr ""

#. Gesprek meer_joris_karper_vraag, Visser Joris zegt
#: scripts/data/ext/meer.gd:263
msgid "Vang hem voor me. Dan weet ik tenminste dat hij echt bestaat."
msgstr ""

#. Gesprek meer_joris_karper_vraag: keuze van de speler
#: scripts/data/ext/meer.gd:266
msgid "Ik ga hem vangen!"
msgstr ""

#. Gesprek meer_joris_karper_ok, Visser Joris zegt
#: scripts/data/ext/meer.gd:273
msgid "Echt? Goed zo. Probeer het in diep water, aan het eind van de verre steiger. Hij is niet gek: een gewone plek haalt hem niet."
msgstr ""

#. Gesprek meer_joris_karper_ok, Visser Joris zegt
#: scripts/data/ext/meer.gd:274
msgid "En geduld, hè. Veel geduld. Vissen is vooral wachten. En mopperen."
msgstr ""

#. Gesprek meer_joris_karper_voortgang, Visser Joris zegt
#: scripts/data/ext/meer.gd:281
msgid "Nog geen gouden vis? Diep water, aan het eind van de verre steiger. Hij laat zich niet zomaar zien."
msgstr ""

#. Gesprek meer_joris_karper_voortgang, Visser Joris zegt
#: scripts/data/ext/meer.gd:282
msgid "Hoe vaker je het probeert, hoe nieuwsgieriger hij wordt. Dat zeg ik tenminste tegen mezelf."
msgstr ""

#. Gesprek meer_joris_karper_direct, Visser Joris zegt
#: scripts/data/ext/meer.gd:288
msgid "Wat heb je daar in je tas? Is dat... Nee. Dat kan niet."
msgstr ""

#. Gesprek meer_joris_karper_direct, Visser Joris zegt
#: scripts/data/ext/meer.gd:289
msgid "Je hebt hem gewoon gevangen, zonder dat ik het je vroeg? Ik moet even gaan zitten."
msgstr ""

#. Gesprek meer_joris_karper_klaar, Visser Joris zegt
#: scripts/data/ext/meer.gd:297
msgid "De Gouden Karper! Hij glimt! Hij kijkt me aan! Hij lacht! Ik wist het!"
msgstr ""

#. Gesprek meer_joris_karper_klaar, Visser Joris zegt
#: scripts/data/ext/meer.gd:298
msgid "Veertig jaar heb ik gewacht. Hier, hier, neem dit. Het is minder dan hij waard is, maar het is alles wat ik heb."
msgstr ""

#. Gesprek meer_joris_karper_na, Visser Joris zegt
#: scripts/data/ext/meer.gd:309
msgid "Mijn Visserspet. Ik draag hem al veertig jaar. Nu is hij van jou. Ik heb er thuis nog drie, maar deze brengt geluk."
msgstr ""

#. Gesprek meer_joris_karper_na, Visser Joris zegt
#: scripts/data/ext/meer.gd:310
msgid "En voor je vis betalen Mila en ik voortaan 10% extra. Dat heet respect."
msgstr ""

#. Gesprek meer_joris_karper_na, Visser Joris zegt
#: scripts/data/ext/meer.gd:311
msgid "De Gouden Karper zet ik terug in het meer. Hij heeft het verdiend. Aan een haak hapt hij nooit meer, zo slim is hij wel. Maar soms zie je hem glinsteren."
msgstr ""

#. Naam van wie er praat (Gesprek meer_lena_intro)
#. Naam van wie er praat (Gesprek meer_lena_menu)
#. Naam van wie er praat (Gesprek meer_lena_over)
#. Naam van wie er praat (Gesprek meer_lena_diepte)
#. Naam van wie er praat (Gesprek meer_lena_vraag)
#. Naam van wie er praat (Gesprek meer_lena_ok)
#: scripts/data/ext/meer.gd:317 scripts/data/ext/meer.gd:327 scripts/data/ext/meer.gd:337 scripts/data/ext/meer.gd:346
msgid "Lena"
msgstr ""

#. Gesprek meer_lena_intro, Lena zegt
#: scripts/data/ext/meer.gd:319
msgid "Welkom in de bibliotheek van het Zilvermeer. Ik ben Lena."
msgstr ""

#. Gesprek meer_lena_intro, Lena zegt
#: scripts/data/ext/meer.gd:320
msgid "Je mag alles lezen. Alleen niet met natte vingers. En niet hardop. En niet... ach, ik zie dat je het begrijpt."
msgstr ""

#. Gesprek meer_lena_intro, Lena zegt
#: scripts/data/ext/meer.gd:321
msgid "De lessenaars met een open boek erop zijn voor jou: loop erheen en druk op E. Elk boek vertelt een stukje van Azura."
msgstr ""

#. Gesprek meer_lena_menu, Lena zegt
#: scripts/data/ext/meer.gd:328
msgid "Kan ik je ergens mee helpen?"
msgstr ""

#. Gesprek meer_lena_menu: keuze van de speler
#: scripts/data/ext/meer.gd:331
msgid "Wat weet je over de Diepte?"
msgstr ""

#. Gesprek meer_lena_menu: keuze van de speler
#: scripts/data/ext/meer.gd:332
msgid "Vertel eens iets over de boeken."
msgstr ""

#. Gesprek meer_lena_over, Lena zegt
#: scripts/data/ext/meer.gd:339
msgid "Alles wat de mensen van Azura ooit hebben opgeschreven, staat hier. Over de Blauwe Kaart, over de oude wachters, over slijmen."
msgstr ""

#. Gesprek meer_lena_over, Lena zegt
#: scripts/data/ext/meer.gd:340
msgid "Sommige boeken zijn zo oud dat ze 'Azura' nog met een andere letter schrijven. Die laat ik liever niet los."
msgstr ""

#. Gesprek meer_lena_over, Lena zegt
#: scripts/data/ext/meer.gd:341
msgid "Lees maar op de lessenaars. Daar staan de korte verhalen. De dikke boeken blijven in de kast. Die zijn zwaar."
msgstr ""

#. Gesprek meer_lena_diepte, Lena zegt
#: scripts/data/ext/meer.gd:348
msgid "De Diepte? Ik hoopte al dat je dat ging vragen. Het staat in alle boeken, maar op geen enkele bladzijde die je kunt vinden."
msgstr ""

#. Gesprek meer_lena_diepte, Lena zegt
#: scripts/data/ext/meer.gd:349
msgid "De Blauwe Kaart is een kopie. Het origineel, de Sterrenkaart, ligt ergens onder de Kristaltempel. Een oude Wachter bewaakt hem. Hij slaapt, maar hij slaapt licht."
msgstr ""

#. Gesprek meer_lena_diepte, Lena zegt
#: scripts/data/ext/meer.gd:350
msgid "De oude boeken zeggen: als de kaart weer heel is, gaat de weg naar beneden open. Of dat klopt, weet niemand. Ga je kijken? Neem dan veel drankjes mee."
msgstr ""

#. Gesprek meer_lena_vraag, Lena zegt
#: scripts/data/ext/meer.gd:357
msgid "Nu je het zegt... ja! Ik mis drie boeken. Ze zijn nooit teruggebracht."
msgstr ""

#. Gesprek meer_lena_vraag, Lena zegt
#: scripts/data/ext/meer.gd:358
msgid "Eén heb ik uitgeleend aan iemand die naar het eiland in het meer ging. Hij kwam nooit terug. Het boek ook niet."
msgstr ""

#. Gesprek meer_lena_vraag, Lena zegt
#: scripts/data/ext/meer.gd:359
msgid "Eén ligt vast in het huisje van Joris. Hij gebruikte het als onderzetter en heeft het daarna ergens opgeborgen. Ik wil er niet over nadenken."
msgstr ""

#. Gesprek meer_lena_vraag, Lena zegt
#: scripts/data/ext/meer.gd:360
msgid "En eentje heeft Sanne meegenomen. Ze vindt boeken zonder plaatjes saai, maar ze neemt ze wel mee. Kinderen!"
msgstr ""

#. Gesprek meer_lena_vraag, Lena zegt
#: scripts/data/ext/meer.gd:361
msgid "Wil je ze voor me zoeken? Dan krijg je een beloning. En iets bijzonders, achterin."
msgstr ""

#. Gesprek meer_lena_vraag: keuze van de speler
#: scripts/data/ext/meer.gd:364
msgid "Ik zoek ze wel!"
msgstr ""

#. Gesprek meer_lena_ok, Lena zegt
#: scripts/data/ext/meer.gd:370
msgid "Wat fijn! Eén op het eiland, één in het huisje van Joris en één bij Sanne. Je kunt ze niet missen. Nou ja, wel. Maar ze zijn er."
msgstr ""

#. Gesprek meer_lena_voortgang, Lena zegt
#: scripts/data/ext/meer.gd:376
msgid "Hoe gaat het met mijn boeken? Eén ligt op het eiland, één in het huisje van Joris en één is bij Sanne."
msgstr ""

#. Gesprek meer_lena_voortgang_0, Lena zegt
#: scripts/data/ext/meer.gd:383
msgid "Nog niets gevonden? Geen haast hoor. Boeken lopen niet weg. Nou ja, deze wel."
msgstr ""

#. Gesprek meer_lena_voortgang_1, Lena zegt
#: scripts/data/ext/meer.gd:384
msgid "Eén boek al! Dan zijn het er nog twee. Je bent een echte boekenzoeker."
msgstr ""

#. Gesprek meer_lena_voortgang_2, Lena zegt
#: scripts/data/ext/meer.gd:385
msgid "Twee boeken al! Nog eentje. Ik hoor de kasten al juichen."
msgstr ""

#. Gesprek meer_lena_boeken_terug, Lena zegt
#: scripts/data/ext/meer.gd:389
msgid "Jij hebt ze! Alle drie! Laat eens kijken..."
msgstr ""

#. Gesprek meer_lena_boeken_terug, Lena zegt
#: scripts/data/ext/meer.gd:390
msgid "'Sagen van het Zilvermeer', nog droog. 'Het Grote Vissenboek', met een koffiekring. En 'Sterren boven Azura'... met kleurpotloodvlekken."
msgstr ""

#. Gesprek meer_lena_boeken_terug, Lena zegt
#: scripts/data/ext/meer.gd:391
msgid "Het is perfect. Ik zet ze meteen terug. Hier is je beloning: dertig munten."
msgstr ""

#. Gesprek meer_lena_achterkamer, Lena zegt
#: scripts/data/ext/meer.gd:402
msgid "En nu iets bijzonders. Achter de kast aan de rechterkant van de zaal zit een geheim kamertje. Alleen leden mogen erin."
msgstr ""

#. Gesprek meer_lena_achterkamer, Lena zegt
#: scripts/data/ext/meer.gd:403
msgid "Vanaf nu ben jij lid. Kijk maar eens goed naar de rechterwand..."
msgstr ""

#. Gesprek meer_lena_achterkamer, Lena zegt
#: scripts/data/ext/meer.gd:404
msgid "Straks, als we uitgepraat zijn, schuift de kast opzij. Hij klemde al jaren. Achterin ligt het laatste boek van de oude bibliothecarissen, en een klein cadeautje."
msgstr ""

#. Gesprek meer_lena_klaar, Lena zegt
#: scripts/data/ext/meer.gd:410
msgid "Mijn favoriete lezer! Het achterkamertje staat altijd voor je open. Lees vooral alles. Lessenaars bijten niet."
msgstr ""

#. Gesprek meer_lena_alles_gelezen, Lena zegt
#: scripts/data/ext/meer.gd:419
msgid "Wacht eens... heb je álle lessenaars gelezen? Zelfs die in het geheime kamertje?"
msgstr ""

#. Gesprek meer_lena_alles_gelezen, Lena zegt
#: scripts/data/ext/meer.gd:420
msgid "Ik heb nog nooit zo'n goede lezer ontmoet. Jij weet nu meer over Azura dan Oudste Bram. Zeg dat maar niet tegen hem."
msgstr ""

#. Naam van wie er praat (Gesprek meer_sanne_intro)
#. Naam van wie er praat (Gesprek meer_sanne_menu)
#. Naam van wie er praat (Gesprek meer_sanne_boek)
#. Naam van wie er praat (Gesprek meer_sanne_laars)
#. Naam van wie er praat (Gesprek meer_sanne_klaar)
#. Naam van personage meer_sanne (boven zijn hoofd)
#: scripts/data/ext/meer.gd:147 scripts/data/ext/meer.gd:428 scripts/data/ext/meer.gd:438 scripts/data/ext/meer.gd:448
msgid "Sanne"
msgstr ""

#. Gesprek meer_sanne_intro, Sanne zegt
#: scripts/data/ext/meer.gd:430
msgid "Sssst! Je maakt de vissen bang!"
msgstr ""

#. Gesprek meer_sanne_intro, Sanne zegt
#: scripts/data/ext/meer.gd:431
msgid "Oh, sorry. Ik ben Sanne. Ik ben acht. En driekwart."
msgstr ""

#. Gesprek meer_sanne_intro, Sanne zegt
#: scripts/data/ext/meer.gd:432
msgid "Ik probeer al de hele dag een vis te vangen. Maar ik vang alleen laarzen. Kijk, ik heb er maar één aan. De andere is... ergens."
msgstr ""

#. Gesprek meer_sanne_menu, Sanne zegt
#: scripts/data/ext/meer.gd:439
msgid "Als jij een echte vis voor me hebt, geef ik je mijn schat. Het is een boek. Ik vind het saai, er staan geen plaatjes in."
msgstr ""

#. Gesprek meer_sanne_menu: keuze van de speler
#: scripts/data/ext/meer.gd:441
msgid "Hier, een baars voor jou!"
msgstr ""

#. Gesprek meer_sanne_menu: keuze van de speler
#: scripts/data/ext/meer.gd:442
msgid "Hier, een snoek voor jou!"
msgstr ""

#. Gesprek meer_sanne_menu: keuze van de speler
#: scripts/data/ext/meer.gd:443
msgid "Is dit jouw laars?"
msgstr ""

#. Gesprek meer_sanne_menu: keuze van de speler
#: scripts/data/ext/meer.gd:444
msgid "Ik kom terug met een vis."
msgstr ""

#. Gesprek meer_sanne_boek, Sanne zegt
#: scripts/data/ext/meer.gd:450
msgid "Een echte vis! Hij is zo glad! En hij kijkt boos! Dankjewel!"
msgstr ""

#. Gesprek meer_sanne_boek, Sanne zegt
#: scripts/data/ext/meer.gd:451
msgid "Hier is mijn schat. Hij zat in mijn tas, maar er past niks meer in. Veel plezier ermee."
msgstr ""

#. Gesprek meer_sanne_laars, Sanne zegt
#: scripts/data/ext/meer.gd:458
msgid "MIJN LAARS! Ik zocht hem al een week! Hij stinkt precies zoals ik me herinner!"
msgstr ""

#. Gesprek meer_sanne_laars, Sanne zegt
#: scripts/data/ext/meer.gd:459
msgid "Je bent de beste. Hier, neem mijn schat maar. Ik moet nu eerst mijn laars aantrekken."
msgstr ""

#. Gesprek meer_sanne_klaar, Sanne zegt
#: scripts/data/ext/meer.gd:466
msgid "Bedankt voor je hulp! Ik ga nu nog meer vangen. Ik wil de Gouden Karper. Joris zegt dat hij lacht. Vissen lachen niet. Toch?"
msgstr ""

#. Gesprek meer_sanne_klaar, Sanne zegt
#: scripts/data/ext/meer.gd:467
msgid "Maar eerst moet ik stil zijn. Sssst."
msgstr ""

#. Gesprek meer_mila_vis, Mila zegt
#: scripts/data/ext/meer.gd:474
msgid "Verse vis! Daar maak ik soep van. Laat maar zien..."
msgstr ""

#. Gesprek meer_mila_klaar, Mila zegt
#: scripts/data/ext/meer.gd:483
msgid "Mmm, dit wordt de beste soep van het dorp. Dank je wel!"
msgstr ""

#. Gesprek meer_mila_vol, Mila zegt
#: scripts/data/ext/meer.gd:487
msgid "Mmm, soep! Al zit het dorp wel vol met vis: ik kan niet meer dan de halve prijs betalen. Maar dank je wel!"
msgstr ""

#. Gesprek wereld_bed_info, Mila zegt
#: scripts/data/ext/wereld.gd:20
msgid "Uitrusten blijft gratis, hoor! Maar in een echt bed slapen kost 5 munten."
msgstr ""

#. Gesprek wereld_bed_info, Mila zegt
#: scripts/data/ext/wereld.gd:21
msgid "Dan slaap je door tot de ochtend, en je wordt ook helemaal beter. Fijn als het buiten donker is!"
msgstr ""

#. Naam van wie er praat (Gesprek wereld_bed)
#. Naam van wie er praat (Gesprek wereld_bed_menu)
#. Naam van wie er praat (Gesprek wereld_bed_poor)
#: scripts/data/ext/wereld.gd:26 scripts/data/ext/wereld.gd:33 scripts/data/ext/wereld.gd:41
msgid "Bed"
msgstr ""

#. Gesprek wereld_bed_menu, Bed zegt
#: scripts/data/ext/wereld.gd:34
msgid "Een zacht bed met een blauwe deken. Wil je slapen tot het ochtend is?"
msgstr ""

#. Gesprek wereld_bed_menu: keuze van de speler
#: scripts/data/ext/wereld.gd:36
msgid "Slapen (5 munten)"
msgstr ""

#. Gesprek wereld_bed_poor, Bed zegt
#: scripts/data/ext/wereld.gd:42
msgid "Een zacht bed met een blauwe deken. Een nachtje slapen kost 5 munten, en zoveel heb je nu niet."
msgstr ""

#. Gesprek diepte_bram_hint, Oudste Bram zegt
#: scripts/data/ext/diepte.gd:20
msgid "Held! Wacht even, voor je gaat rusten."
msgstr ""

#. Gesprek diepte_bram_hint, Oudste Bram zegt
#: scripts/data/ext/diepte.gd:21
msgid "Sinds de Blauwe Kaart weer heel is, hoor ik een zacht gerommel onder de tempel."
msgstr ""

#. Gesprek diepte_bram_hint, Oudste Bram zegt
#: scripts/data/ext/diepte.gd:22
msgid "Mijn oma vertelde over een oude bewaker die diep onder de grond slaapt: De Vergeten Wachter."
msgstr ""

#. Gesprek diepte_bram_hint, Oudste Bram zegt
#: scripts/data/ext/diepte.gd:23
msgid "Hij bewaakt de Sterrenkaart. Dat is de allereerste kaart. Onze Blauwe Kaart is daar maar een kopie van."
msgstr ""

#. Gesprek diepte_bram_hint, Oudste Bram zegt
#: scripts/data/ext/diepte.gd:24
msgid "Kijk achter in de tempel, waar de Slijmkoning stond. Daar zit een oud zegel in de muur. Pas goed op!"
msgstr ""

#. Gesprek greta_star, Greta zegt
#: scripts/data/ext/diepte.gd:32
msgid "Wacht eens even... Is dat... het STERRENZWAARD?!"
msgstr ""

#. Gesprek greta_star, Greta zegt
#: scripts/data/ext/diepte.gd:33
msgid "Ik ken het alleen uit de oude verhalen van mijn opa. Het is niet van ijzer gemaakt, maar van sterrenlicht!"
msgstr ""

#. Gesprek greta_star, Greta zegt
#: scripts/data/ext/diepte.gd:34
msgid "Daar kan zelfs ik niets meer aan verbeteren. Pas er goed op, held!"
msgstr ""

#. Gesprek greta_star_again, Greta zegt
#: scripts/data/ext/diepte.gd:40
msgid "Mag ik het Sterrenzwaard nog één keertje vasthouden? ... Prachtig. Ga maar, held, de wereld wacht!"
msgstr ""

#. Naam van wie er praat (Gesprek guardian_intro)
#. Naam van wie er praat (Gesprek guardian_defeat)
#. Titel van opdracht diepte
#. Naam van vijand guardian
#: scripts/data/ext/diepte.gd:43 scripts/data/ext/diepte.gd:53 scripts/data/ext/diepte.gd:74 scripts/data/ext/diepte.gd:125
msgid "De Vergeten Wachter"
msgstr ""

#. Gesprek guardian_intro, De Vergeten Wachter zegt
#: scripts/data/ext/diepte.gd:45
msgid "..."
msgstr ""

#. Gesprek guardian_intro, De Vergeten Wachter zegt
#: scripts/data/ext/diepte.gd:46
msgid "Wie... wekt... mij?"
msgstr ""

#. Gesprek guardian_intro, De Vergeten Wachter zegt
#: scripts/data/ext/diepte.gd:47
msgid "Ik ben de Wachter van de Sterrenkaart. Al meer dan duizend jaar waak ik hier."
msgstr ""

#. Gesprek guardian_intro, De Vergeten Wachter zegt
#: scripts/data/ext/diepte.gd:48
msgid "De Blauwe Kaart was maar een kopie. En toch hebben jullie hem aangeraakt!"
msgstr ""

#. Gesprek guardian_intro, De Vergeten Wachter zegt
#: scripts/data/ext/diepte.gd:49
msgid "Alleen wie sterker is dan de Wachter, mag de Sterrenkaart zien. Laat maar zien wat je kunt!"
msgstr ""

#. Gesprek guardian_defeat, De Vergeten Wachter zegt
#: scripts/data/ext/diepte.gd:55
msgid "Je bent sterk. En slim. Je rolde door mijn scherven alsof het niets was."
msgstr ""

#. Gesprek guardian_defeat, De Vergeten Wachter zegt
#: scripts/data/ext/diepte.gd:56
msgid "Meer dan duizend jaar heb ik gewaakt. Nu mag ik eindelijk rusten."
msgstr ""

#. Gesprek guardian_defeat, De Vergeten Wachter zegt
#: scripts/data/ext/diepte.gd:57
msgid "Het Sterrenzwaard is nu van jou. Het is gemaakt van het licht van de Sterrenkaart. Gebruik het goed, held van Azura."
msgstr ""

#. Gesprek guardian_defeat, De Vergeten Wachter zegt
#: scripts/data/ext/diepte.gd:58
msgid "En kijk omhoog... Dit is wat ik al die tijd heb bewaakt."
msgstr ""

#. Gesprek guardian_defeat2, verteller
#: scripts/data/ext/diepte.gd:65
msgid "Boven je hoofd gaan duizenden kleine lichtjes aan. Ze vormen samen een kaart van heel Azura: de Sterrenkaart!"
msgstr ""

#. Gesprek guardian_defeat2, verteller
#: scripts/data/ext/diepte.gd:66
msgid "Het Sterrenzwaard gloeit in je hand. Het is zo licht als een veertje en zo scherp als een sterrenstraal."
msgstr ""

#. Gesprek guardian_defeat2, verteller
#: scripts/data/ext/diepte.gd:67
msgid "Greta de smid gaat hier zeker van opkijken! Laat het haar maar eens zien in de smederij."
msgstr ""

#. Naam van wie er praat (Gesprek arena_bruno_intro)
#. Naam van wie er praat (Gesprek arena_bruno_menu)
