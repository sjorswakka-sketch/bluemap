msgstr "Drink 10 Hero Potions."

#. Naam van prestatie rolls_50
#: scripts/data/achievements.gd:85
msgid "Rolmeester"
msgstr "Roll Master"

#. Uitleg bij prestatie rolls_50
#: scripts/data/achievements.gd:85
