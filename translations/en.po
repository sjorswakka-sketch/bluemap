#. Naam van gebied village
#. Kaart village, sign [21, 8]: tekst op een bord
#: scripts/ui/ending.gd:218 scripts/maps/village.gd:6 scripts/maps/village.gd:66
msgid "Dageraadsdorp"
msgstr "Daybreak Village"

#. Kaart village, sign [21, 8]: tekst op een bord
#: scripts/maps/village.gd:66
msgid "Tempel van de Blauwe Kaart. Bewaker: Oudste Bram."
msgstr "Temple of the Blue Map. Keeper: Elder Bram."

#. Kaart village, sign [37, 12]: tekst op een bord
#: scripts/data/space_maps.gd:11
msgid "Oostelijke weg: Bosrand en Fluisterbos."
msgstr "Eastern road: Forest Edge and Whispering Woods."

#. Kaart village, sign [37, 12]: tekst op een bord
#: scripts/maps/village.gd:67
msgid "Pas op voor slijmen!"
msgstr "Watch out for slimes!"

#. Kaart village, portal [33, 4]: melding als hij op slot zit
#: scripts/maps/village.gd:75
msgid "De arenadeur blijft dicht. Praat eerst met Oudste Bram, en kom terug met een ijzeren zwaard van Greta de smid."
msgstr "The arena door stays shut. Talk to Elder Bram first, then come back with an Iron Sword from Greta the Smith."

#. Kaart village, sign [31, 5]: tekst op een bord
#: scripts/maps/village.gd:76
msgid "Arena van Dageraadsdorp"
msgstr "Daybreak Village Arena"

#. Kaart village, sign [31, 5]: tekst op een bord
#: scripts/maps/village.gd:76
msgid "Voor echte vechters! Praat eerst met Oudste Bram, en kom terug met een ijzeren zwaard van Greta de smid."
msgstr "For true fighters only! Talk to Elder Bram first, then come back with an Iron Sword from Greta the Smith."

#. Kaart village, portal [19, 6]: melding als hij op slot zit
#: scripts/maps/village.gd:81
msgid "De tempeldeur is verzegeld door de gebarsten kaart."
msgstr "The temple door is sealed by the cracked map."

#. Kaart village, sign [29, 17]: tekst op een bord
#: scripts/maps/village.gd:88
msgid "Schietbaan van Tessa."
msgstr "Tessa's Shooting Range."

#. Kaart village, sign [29, 17]: tekst op een bord
#: scripts/maps/village.gd:88
msgid "Raak de doelwitten met je boog. Praat met Tessa om te beginnen."
msgstr "Hit the targets with your bow. Talk to Tessa to start."

#. Kaart village, sign [18, 24]: tekst op een bord
#: scripts/maps/village.gd:90
msgid "Zuidelijke weg: het Zilvermeer."
msgstr "South road: Silver Lake."

#. Kaart village, sign [18, 24]: tekst op een bord
#: scripts/maps/village.gd:90
msgid "Rustig water, grote vissen en een bibliotheek."
msgstr "Calm water, big fish, and a library."

#. Naam van gebied smithy
#: scripts/maps/smithy.gd:6
msgid "Smederij"
msgstr "Smithy"

#. Naam van gebied shop
#: scripts/maps/shop.gd:6
msgid "Winkel van Tobias"
msgstr "Tobias' Shop"

#. Naam van gebied inn
#: scripts/maps/inn.gd:6
msgid "Herberg De Blauwe Slijm"
msgstr "The Blue Slime Inn"

#. Naam van gebied forest
#: scripts/ui/ending.gd:218 scripts/maps/forest.gd:6 scripts/maps/forest.gd:54
msgid "Fluisterbos"
msgstr "Whispering Woods"

#. Kaart forest, sign [5, 19]: tekst op een bord
#: scripts/data/space_maps.gd:16
msgid "Westelijk pad: Bosrand en Dageraadsdorp."
msgstr "Western path: Forest Edge and Daybreak Village."

#. Kaart forest, sign [5, 19]: tekst op een bord
#: scripts/maps/forest.gd:54
msgid "Hier fluisteren de bomen. En de slijmen zijn niet te vertrouwen."
msgstr "Here the trees whisper. And the slimes can't be trusted."

#. Kaart forest, sign [28, 19]: tekst op een bord
#: scripts/maps/forest.gd:55
msgid "Noord: oude stenen ruïne."
msgstr "North: an old stone ruin."

#. Kaart forest, sign [28, 19]: tekst op een bord
#: scripts/maps/forest.gd:55
msgid "Oost: Vergeten Ruïne."
msgstr "East: Forgotten Ruins."

#. Kaart forest, sign [28, 19]: tekst op een bord
#: scripts/maps/forest.gd:55
msgid "Zuid-oost: Echo-grot."
msgstr "Southeast: Echo Cave."

#. Kaart forest, gate [48, 15]: melding als hij op slot zit
#: scripts/maps/forest.gd:61
msgid "Het poortje zit op slot. Je hebt een sleutel nodig."
msgstr "The gate is locked. You need a key."

#. Kaart forest, sign [47, 19]: tekst op een bord
#: scripts/maps/forest.gd:63
msgid "Vergeten Ruïne."
msgstr "Forgotten Ruins."

#. Kaart forest, sign [47, 19]: tekst op een bord
#: scripts/maps/forest.gd:63
msgid "Het poortje is al eeuwen op slot."
msgstr "This gate has been locked for ages."

#. Kaart forest, gate [22, 33]: melding als hij op slot zit
#: scripts/maps/forest.gd:101
msgid "Het poortje is dicht. Schiet met je boog op de twee doelwitten over de rivier!"
msgstr "The gate is shut. Use your bow to shoot the two targets across the river!"

#. Kaart forest, sign [14, 16]: tekst op een bord
#: scripts/maps/forest.gd:109
msgid "Pas op voor slijmspuwers!"
msgstr "Watch out for slime spitters!"

#. Kaart forest, sign [14, 16]: tekst op een bord
#: scripts/maps/forest.gd:109
msgid "Een slijmspuwer spuugt drie slijmballen tegelijk. Rol weg met Shift!"
msgstr "A slime spitter spits three slimeballs at once. Roll away with Shift!"

#. Kaart forest, sign [14, 16]: tekst op een bord
#: scripts/maps/forest.gd:109
msgid "Kom je te dichtbij, dan hupt hij weg."
msgstr "Get too close, and it hops away."

#. Kaart forest, sign [5, 12]: tekst op een bord
#: scripts/maps/forest.gd:116
msgid "Noordelijk pad: Dauwbos"
msgstr "Northern path: Dew Woods"

#. Kaart forest, sign [5, 12]: tekst op een bord
#: scripts/maps/forest.gd:116
msgid "Mistig en stil. Mira bewaakt de dauw."
msgstr "Misty and silent. Mira guards the dew."

#. Kaart forest, sign [3, 16]: tekst op een bord
#: scripts/maps/forest.gd:117
msgid "Westelijk pad: Dageraadsdorp"
msgstr "Western path: Daybreak Village"

#. Kaart forest, sign [3, 16]: tekst op een bord
#: scripts/maps/forest.gd:117
msgid "Terug naar het dorp, waar de geur van vers brood je tegemoet komt."
msgstr "Back to the village, where the smell of fresh bread comes to meet you."

#. Kaart forest, sign [2, 26]: tekst op een bord
#: scripts/data/combat_maps.gd:11
msgid "Oefenerf: stap in de gloed bij het vaandel."
msgstr "Practice Yard: step into the glow beside the banner."

#. Naam van gebied forest_edge
#: scripts/maps/forest_edge.gd:5
msgid "Bosrand"
msgstr "Forest Edge"

#. Kaart forest_edge, sign [3, 11]: tekst op een bord
#: scripts/maps/forest_edge.gd:36
msgid "Westelijk pad: Dageraadsdorp."
msgstr "Western path: Daybreak Village."

#. Kaart forest_edge, sign [40, 8]: tekst op een bord
#: scripts/maps/forest_edge.gd:37
msgid "Oostelijk pad: Fluisterbos."
msgstr "Eastern path: Whispering Woods."

#. Naam van gebied ruins
#: scripts/maps/ruins.gd:6
msgid "De Vergeten Ruïne"
msgstr "The Forgotten Ruins"

#. Naam van gebied ruins midden in een zin ("Reizen naar %s?"); de vorm met hoofdletter is "De Vergeten Ruïne"
msgid "de Vergeten Ruïne"
msgstr "the Forgotten Ruins"

#. Kaart ruins, sign [9, 28]: tekst op een bord
#: scripts/maps/ruins.gd:86
msgid "Hier rust de bewaker van de ruïne."
msgstr "Here rests the keeper of the ruins."

#. Kaart ruins, sign [9, 28]: tekst op een bord
#: scripts/maps/ruins.gd:86
msgid "Wie het kristal wil, moet de golem verslaan."
msgstr "Want the crystal? Then defeat the golem."

#. Kaart ruins, gate [15, 8]: melding als hij op slot zit
#: scripts/maps/ruins.gd:88
msgid "Het poortje is dicht. Schiet met je boog op de twee oude doelwitten in de muren!"
msgstr "The gate is shut. Use your bow to shoot the two old targets in the walls!"

#. Kaart ruins, sign [9, 18]: tekst op een bord
#. Kaart cave, sign [9, 27]: tekst op een bord
#: scripts/maps/cave.gd:98 scripts/maps/ruins.gd:97
msgid "Pas op voor magiërs!"
msgstr "Watch out for mages!"

#. Kaart ruins, sign [9, 18]: tekst op een bord
#: scripts/maps/ruins.gd:97
msgid "Ze verdwijnen in een rookwolkje en schieten een tovervonk. Die is traag: sla hem stuk met je zwaard."
msgstr "They vanish in a puff of smoke and shoot a magic spark. It's slow, so smash it with your sword."

#. Naam van gebied cave
#: scripts/maps/cave.gd:6
msgid "De Echo-grot"
msgstr "The Echo Cave"

#. Naam van gebied cave midden in een zin ("Reizen naar %s?"); de vorm met hoofdletter is "De Echo-grot"
msgid "de Echo-grot"
msgstr "the Echo Cave"

#. Kaart cave, sign [7, 30]: tekst op een bord
#: scripts/ui/ending.gd:218 scripts/maps/cave.gd:52
msgid "Echo-grot"
msgstr "Echo Cave"

#. Kaart cave, sign [7, 30]: tekst op een bord
#: scripts/maps/cave.gd:52
msgid "Het is hier pikkedonker. Volg het licht van de fakkels."
msgstr "It's pitch-dark in here. Follow the light of the torches."

#. Kaart cave, sign [9, 27]: tekst op een bord
#: scripts/maps/cave.gd:98
msgid "Ook in de grot zweven ze rond. Hun tovervonk geeft paars licht: sla hem stuk met je zwaard!"
msgstr "They float around in the cave too. Their magic spark glows purple. Smash it with your sword!"

#. Kaart cave, portal [4, 7]: melding als hij op slot zit
#: scripts/maps/cave.gd:102
msgid "De Prismamijn is gevaarlijk. Haal eerst een ijzeren zwaard bij Greta."
msgstr "The Prism Mine is dangerous. Get an iron sword from Greta first."

#. Kaart cave, sign [6, 7]: tekst op een bord
#: scripts/maps/cave.gd:103
msgid "Westelijke doorgang: Prismamijn"
msgstr "Western passage: Prism Mine"

#. Kaart cave, sign [6, 7]: tekst op een bord
#: scripts/maps/cave.gd:103
msgid "Volg de turquoise kristallen naar twee nieuwe grotten en de Resonantieproef."
msgstr "Follow the turquoise crystals to two new caves and the Resonance Trial."

#. Naam van gebied temple
#: scripts/maps/temple.gd:6
msgid "De Kristaltempel"
msgstr "The Crystal Temple"

#. Naam van gebied temple midden in een zin ("Reizen naar %s?"); de vorm met hoofdletter is "De Kristaltempel"
msgid "de Kristaltempel"
msgstr "the Crystal Temple"

#. Kaart temple, gate [10, 15]: melding als hij op slot zit
#: scripts/maps/temple.gd:47
msgid "De deur zit dicht. Er is geen weg terug!"
msgstr "The door is shut. There's no way back!"

#. Kaart temple, portal [11, 0]: melding als hij op slot zit
#: scripts/maps/temple.gd:51
msgid "Een zegel versperrt de trap."
msgstr "A seal blocks the stairs."

#. Naam van gebied tidal_hollow
#: scripts/maps/tidal_hollow.gd:4
msgid "Tijholte"
msgstr "Tidal Hollow"

#. Kaart tidal_hollow, sign [4, 27]: tekst op een bord
#: scripts/maps/tidal_hollow.gd:77
msgid "Tijholte · terug naar Zilvermonding"
msgstr "Tidal Hollow · back to Silver Estuary"

#. Kaart tidal_hollow, sign [4, 27]: tekst op een bord
#: scripts/maps/tidal_hollow.gd:78
msgid "De brede zuidelijke gang en lange brug blijven veilig. Noordelijke zijpoelen zijn optioneel: amberkleurige schaarwaaiers en lichtkringen met een open sector."
msgstr "The broad southern passage and long bridge stay safe. The northern side pools are optional: amber claw fans and light rings with an open sector."

#. Kaart tidal_hollow, sign [32, 27]: tekst op een bord
#: scripts/maps/tidal_hollow.gd:130
msgid "Zuidelijke omweg: altijd open"
msgstr "Southern detour: always open"

#. Kaart tidal_hollow, sign [32, 27]: tekst op een bord
#: scripts/maps/tidal_hollow.gd:131
msgid "Na herstel van het tijrad kun je ook over de korte brug in het midden. De poelen boven de gang horen bij de dieren; je hoeft daar niet langs."
msgstr "Once the tide wheel is repaired, you can also cross the short central bridge. The pools above the passage belong to the creatures; you do not need to enter them."

#. Naam van gebied river_mouth
#: scripts/maps/river_mouth.gd:4
msgid "Zilvermonding"
msgstr "Silver Estuary"

#. Kaart river_mouth, sign [12, 42]: tekst op een bord
#: scripts/maps/river_mouth.gd:91
msgid "Zuidelijke oever: Blauwe Kust"
msgstr "Southern bank: Blue Coast"

#. Kaart river_mouth, sign [12, 42]: tekst op een bord
#: scripts/maps/river_mouth.gd:92
msgid "Over de brug naar het oosten ligt Rietwenk Haven. Beide oevers blijven rustig."
msgstr "Rietwenk Harbour lies across the bridge to the east. Both banks remain peaceful."

#. Kaart river_mouth, sign [72, 16]: tekst op een bord
#: scripts/maps/river_mouth.gd:115
msgid "Oostelijk pad: Rietwenk Haven"
msgstr "Eastern path: Rietwenk Harbour"

#. Kaart river_mouth, sign [72, 16]: tekst op een bord
#: scripts/maps/river_mouth.gd:116
msgid "Een korte kade, twee werkplekken en de veer. De noordelijke route voert verder naar de kaap."
msgstr "A short quay, two workplaces and the ferry. The northern route continues to the cape."

#. Naam van gebied harbor
#: scripts/maps/harbor.gd:4
msgid "Rietwenk Haven"
msgstr "Rietwenk Harbour"

#. Kaart harbor, sign [3, 16]: tekst op een bord
#: scripts/maps/harbor.gd:95
msgid "Westelijke oever: Zilvermonding"
msgstr "Western bank: Silver Estuary"

#. Kaart harbor, sign [3, 16]: tekst op een bord
#: scripts/maps/harbor.gd:96
msgid "De brug bij de rivier voert naar de Blauwe Kust. Het westelijke grasveld is vrij van werkplekken."
msgstr "The river bridge leads to the Blue Coast. The western meadow is clear of workplaces."

#. Kaart harbor, sign [70, 12]: tekst op een bord
#: scripts/maps/harbor.gd:119
msgid "Oostelijk kustpad: Lichtkaap"
msgstr "Eastern coast path: Light Cape"

#. Kaart harbor, sign [70, 12]: tekst op een bord
#: scripts/maps/harbor.gd:120
msgid "Volg het hoge pad naar de vuurtoren. Je hebt geen uitrusting nodig en kunt altijd terug."
msgstr "Follow the high path to the lighthouse. No equipment is needed, and you can always return."

#. Naam van gebied headland
#: scripts/maps/headland.gd:4
msgid "Lichtkaap"
msgstr "Light Cape"

#. Kaart headland, sign [3, 26]: tekst op een bord
#: scripts/maps/headland.gd:87
msgid "Westelijk kustpad: Rietwenk Haven"
msgstr "Western coast path: Rietwenk Harbour"

#. Kaart headland, sign [3, 26]: tekst op een bord
#: scripts/maps/headland.gd:88
msgid "Het brede hoge pad brengt je terug naar de veer. Het zuidelijke uitzicht is een rustige zijroute."
msgstr "The broad high path leads back to the ferry. The southern viewpoint is a quiet side route."

#. Kaart headland, region_view [49, 33]: tekst op een bord
#: scripts/maps/headland.gd:117
msgid "Vanaf deze lage rand zie je het verschil tussen de rustige riviermonding en de open zee."
msgstr "From this low ledge, you can see the difference between the peaceful estuary and the open sea."

#. Kaart headland, region_view [49, 33]: tekst op een bord
#: scripts/maps/headland.gd:118
msgid "Beneden trekken schuimstrepen langs de rotsen. Achter je voert het hoge pad terug naar de haven."
msgstr "Below, streaks of foam drift past the rocks. Behind you, the high path leads back to the harbour."

#. Naam van gebied tide_cove
#: scripts/maps/tide_cove.gd:4
msgid "Getijdenbaai"
msgstr "Tidal Cove"

#. Kaart tide_cove, sign [3, 24]: tekst op een bord
#: scripts/maps/tide_cove.gd:81
msgid "Westelijke loopbrug: Meeuweneiland"
msgstr "Western boardwalk: Gull Island"

#. Kaart tide_cove, sign [3, 24]: tekst op een bord
#: scripts/maps/tide_cove.gd:82
msgid "Het hoge pad langs de noordkant blijft bij ieder getij open."
msgstr "The high path along the north side stays open at every tide."

#. Naam van gebied coast
#: scripts/maps/coast.gd:4
msgid "Blauwe Kust"
msgstr "Blue Coast"

#. Kaart coast, sign [4, 15]: tekst op een bord
#: scripts/maps/coast.gd:91
msgid "Westelijk pad: Zilvermeer"
msgstr "Western path: Silver Lake"

#. Kaart coast, sign [4, 15]: tekst op een bord
#: scripts/maps/coast.gd:92
msgid "West: Zilvermeer. Oost: strand en veer naar Meeuweneiland."
msgstr "West: Silver Lake. East: beach and ferry to Gull Island."

#. Kaart coast, sign [12, 3]: tekst op een bord
#: scripts/data/coastal_region_maps.gd:10
msgid "Noordelijk oeverpad: Zilvermonding"
msgstr "Northern bank path: Silver Estuary"

#. Kaart coast, sign [12, 3]: tekst op een bord
#: scripts/data/coastal_region_maps.gd:10
msgid "Volg de hoge rivierbrug naar Rietwenk Haven. Naar het westen blijft het Zilvermeer bereikbaar."
msgstr "Follow the high river bridge to Rietwenk Harbour. Silver Lake remains accessible to the west."

#. Naam van gebied gull_island
#: scripts/maps/gull_island.gd:4
msgid "Meeuweneiland"
msgstr "Gull Island"

#. Kaart gull_island, sign [43, 21]: tekst op een bord
#: scripts/data/coast_maps.gd:14
msgid "Oostelijke loopbrug: Getijdenbaai"
msgstr "Eastern boardwalk: Tidal Cove"

#. Kaart gull_island, sign [43, 21]: tekst op een bord
#: scripts/data/coast_maps.gd:14
msgid "Een hoge loopbrug, een zandbank bij laagwater en een gratis te lenen landingslijn. De veer blijft beschikbaar."
msgstr "A high boardwalk, a sandbank at low tide and a free landing line to borrow. The ferry remains available."

#. Naam van gebied watchyard
#: scripts/entities/combat_post.gd:32 scripts/entities/combat_post.gd:41 scripts/maps/watchyard.gd:4
msgid "Oefenerf"
msgstr "Practice Yard"

#. Kaart watchyard, sign [16, 18]: tekst op een bord
#: scripts/maps/watchyard.gd:73
msgid "Terug naar Fluisterbos: volg het zuidelijke pad."
msgstr "Back to Whispering Woods: follow the southern path."

#. Kaart watchyard, sign [16, 18]: tekst op een bord
#: scripts/maps/watchyard.gd:74
msgid "Oranje lijnen: stap opzij. Blauwe vonken: de vijand rust uit. Rotsen houden stormlopen en doornen tegen."
msgstr "Orange lines: step aside. Blue sparks: the enemy is recovering. Rocks stop charges and thorns."

#. Naam van gebied sunwell
#. Kaart dorstvallei, sign [22, 6]: tekst op een bord
#: scripts/data/regional_maps.gd:38 scripts/data/regional_maps.gd:149 scripts/maps/sunwell.gd:4
msgid "De Zonnekloof"
msgstr "The Sun Gorge"

#. Naam van gebied sunwell midden in een zin ("Reizen naar %s?"); de vorm met hoofdletter is "De Zonnekloof"
msgid "de Zonnekloof"
msgstr "the Sun Gorge"

#. Kaart sunwell, regional_object [4, 18]: name
#: scripts/maps/sunwell.gd:53
msgid "De eerste waterluifel"
msgstr "The first water shelter"

#. Kaart sunwell, regional_object [15, 5]: name
#: scripts/maps/sunwell.gd:62
msgid "De hoge waterluifel"
msgstr "The upper water shelter"

#. Kaart sunwell, regional_object [28, 18]: name
#: scripts/maps/sunwell.gd:71
msgid "De zuidelijke waterluifel"
msgstr "The southern water shelter"

#. Kaart sunwell, regional_object [34, 5]: name
#. Naam van wie er praat (Gesprek ra_spring)
#: scripts/data/ext/regional.gd:52 scripts/maps/sunwell.gd:80
msgid "De oude bron"
msgstr "The old spring"

#. Kaart sunwell, sign [6, 20]: tekst op een bord
#: scripts/data/regional_maps.gd:136
msgid "Terug naar Dorstvallei: de zuidelijke opening bij de eerste waterluifel."
msgstr "Back to Dorstvallei: the southern opening beside the first water shelter."

#. Naam van gebied lake
#: scripts/maps/lake.gd:6
msgid "Zilvermeer"
msgstr "Silver Lake"

#. Kaart lake, sign [20, 4]: tekst op een bord
#: scripts/maps/lake.gd:53
msgid "Het Zilvermeer"
msgstr "Silver Lake"

#. Kaart lake, sign [20, 4]: tekst op een bord
#: scripts/maps/lake.gd:53
msgid "Vissen mag. Mopperen ook. Maar niet allebei tegelijk. - Joris"
msgstr "Fishing is allowed. Grumbling too. Just not both at once. - Joris"

#. Kaart lake, sign [23, 13]: tekst op een bord
#: scripts/maps/lake.gd:54
msgid "Steiger"
msgstr "Dock"

#. Kaart lake, sign [23, 13]: tekst op een bord
#: scripts/maps/lake.gd:54
msgid "Niet rennen. Niet duwen. En niet boos worden op de vis."
msgstr "No running. No pushing. And no getting mad at the fish."

#. Kaart lake, sign [36, 19]: tekst op een bord
#: scripts/maps/lake.gd:55
msgid "De verre steiger"
msgstr "The Far Dock"

#. Kaart lake, sign [36, 19]: tekst op een bord
#: scripts/maps/lake.gd:55
msgid "Het water is hier diep. Grote vissen zwemmen graag in diep water."
msgstr "The water is deep here. Big fish love deep water."

#. Kaart lake, sign [10, 7]: tekst op een bord
#. Naam van wie er praat (Gesprek ls_net_done)
#. Naam van wie er praat (Gesprek meer_joris_intro)
#. Naam van wie er praat (Gesprek meer_joris_hengel)
#. Naam van wie er praat (Gesprek meer_joris_menu)
#. Naam van wie er praat (Gesprek meer_joris_na)
#: scripts/entities/supper_actor.gd:38 scripts/data/ext/lake_supper.gd:24 scripts/data/ext/meer.gd:128 scripts/data/ext/meer.gd:159
msgid "Visser Joris"
msgstr "Joris the Fisher"

#. Kaart lake, sign [10, 7]: tekst op een bord
#: scripts/maps/lake.gd:56
msgid "Bellen kan niet, er is geen bel. Kloppen mag."
msgstr "No use ringing. There's no bell. Knocking is fine."

#. Kaart lake, sign [34, 7]: tekst op een bord
#. Naam van gebied library
#: scripts/maps/lake.gd:57 scripts/maps/library.gd:6
msgid "Bibliotheek van Lena"
msgstr "Lena's Library"

#. Kaart lake, sign [34, 7]: tekst op een bord
#: scripts/maps/lake.gd:57
msgid "Stil zijn graag. De boeken slapen."
msgstr "Quiet, please. The books are sleeping."

#. Kaart lake, sign [20, 24]: tekst op een bord
#: scripts/maps/lake.gd:58
msgid "Eilandje"
msgstr "Little Island"

#. Kaart lake, sign [20, 24]: tekst op een bord
#: scripts/maps/lake.gd:58
msgid "Rustig, groen en een beetje nat."
msgstr "Quiet, green, and a little bit wet."

#. Kaart lake, sign [23, 2]: tekst op een bord
#: scripts/maps/lake.gd:59
msgid "Noordelijk pad: Dageraadsdorp"
msgstr "Northern path: Daybreak Village"

#. Kaart lake, sign [23, 2]: tekst op een bord
#: scripts/maps/lake.gd:59
msgid "Over de heuvels ligt het dorp in de morgenzon."
msgstr "Beyond the hills lies the village in the morning sun."

#. Kaart lake, sign [19, 29]: tekst op een bord
#: scripts/maps/lake.gd:60
msgid "Zuidelijk veenpad: Kruipmoeras"
msgstr "Southern peat path: Creeping Swamp"

#. Kaart lake, sign [19, 29]: tekst op een bord
#: scripts/maps/lake.gd:60
msgid "Drassig land met kwakkende vorsten. Stevige schoenen mee!"
msgstr "Soggy land with croaking toads. Bring sturdy shoes!"

#. Kaart lake, sign [40, 7]: tekst op een bord
#: scripts/data/coast_maps.gd:23
msgid "Oostelijk pad: Blauwe Kust"
msgstr "Eastern path: Blue Coast"

#. Kaart lake, sign [40, 7]: tekst op een bord
#: scripts/data/coast_maps.gd:23
msgid "Volg de riviermonding naar het strand. De veerboot brengt je gratis naar Meeuweneiland en terug."
msgstr "Follow the river mouth to the beach. The ferry takes you to Gull Island and back for free."

#. Naam van gebied fisher_hut
#: scripts/maps/fisher_hut.gd:6
msgid "Het huisje van Joris"
msgstr "Joris' Cabin"

#. Naam van gebied fisher_hut midden in een zin ("Reizen naar %s?"); de vorm met hoofdletter is "Het huisje van Joris"
msgid "het huisje van Joris"
msgstr "Joris' Cabin"

#. Kaart fisher_hut, sign [3, 6]: tekst op een bord
#: scripts/maps/fisher_hut.gd:24
msgid "Het visdagboek van Joris"
msgstr "Joris' Fishing Diary"

#. Kaart fisher_hut, sign [3, 6]: tekst op een bord
#: scripts/maps/fisher_hut.gd:24
msgid "Dag 1: geen vis. Dag 2: geen vis. Dag 3: een laars. Dag 4: nog een laars. Dag 5: ik begin een collectie."
msgstr "Day 1: no fish. Day 2: no fish. Day 3: a boot. Day 4: another boot. Day 5: I'm starting a collection."

#. Kaart fisher_hut, sign [8, 5]: tekst op een bord
#: scripts/maps/fisher_hut.gd:25
msgid "Een briefje bij de tafel"
msgstr "A note by the table"

#. Kaart fisher_hut, sign [8, 5]: tekst op een bord
#: scripts/maps/fisher_hut.gd:25
msgid "Voor de Gouden Karper: niet met brood proberen. Hij is te slim voor brood. Probeer het in diep water."
msgstr "For the Golden Carp: don't bother with bread. He's too smart for bread. Try deep water."

#. Naam van gebied depths1
#: scripts/maps/depths1.gd:7
msgid "De Kristalgangen"
msgstr "The Crystal Halls"

#. Naam van gebied depths1 midden in een zin ("Reizen naar %s?"); de vorm met hoofdletter is "De Kristalgangen"
msgid "de Kristalgangen"
msgstr "the Crystal Halls"

#. Kaart depths1, diepte_gate [21, 10]: melding als hij op slot zit
#: scripts/maps/depths1.gd:46
msgid "De kristalpoort zit op slot. Er hoort een sleutel bij."
msgstr "The crystal gate is locked. It needs a key."

#. Kaart depths1, sign [9, 25]: tekst op een bord
#: scripts/maps/depths1.gd:51
msgid "Op de muur staan oude woorden:"
msgstr "Old words are carved into the wall:"

#. Kaart depths1, sign [9, 25]: tekst op een bord
#: scripts/maps/depths1.gd:51
msgid "\"Wie de Wachter wekt, moet zelf wakker blijven.\""
msgstr "\"Whoever wakes the Guardian had better stay awake.\""

#. Kaart depths1, sign [21, 12]: tekst op een bord
#: scripts/maps/depths1.gd:52
msgid "Een kristalpoort met een sleutelgat in de vorm van een ster."
msgstr "A crystal gate with a star-shaped keyhole."

#. Kaart depths1, sign [21, 12]: tekst op een bord
#: scripts/maps/depths1.gd:52
msgid "Ergens in deze gangen moet de sleutel liggen."
msgstr "The key must be somewhere in these halls."

#. Naam van gebied depths2
#: scripts/maps/depths2.gd:7
msgid "Het Hart van de Kaart"
msgstr "The Heart of the Map"

#. Naam van gebied depths2 midden in een zin ("Reizen naar %s?"); de vorm met hoofdletter is "Het Hart van de Kaart"
msgid "het Hart van de Kaart"
msgstr "the Heart of the Map"

#. Kaart depths2, diepte_gate [12, 18]: melding als hij op slot zit
#: scripts/maps/depths2.gd:41
msgid "De deur is dicht. Hij gaat pas weer open als het gevecht voorbij is."
msgstr "The door is shut. It won't open again until the fight is over."

#. Kaart depths2, sign [15, 19]: tekst op een bord
#: scripts/maps/depths2.gd:45
msgid "Hierachter slaapt De Vergeten Wachter. Wie hem wakker maakt, kan pas terug als het gevecht voorbij is."
msgstr "The Forgotten Guardian sleeps behind here. Wake him, and there's no way out until the fight is over."

#. Kaart depths2, sign [15, 19]: tekst op een bord
#: scripts/maps/depths2.gd:46
msgid "Sla dus eerst op bij het altaar en neem genoeg drankjes mee!"
msgstr "So save at the altar first, and bring plenty of potions!"

#. Kaart depths2, sign [15, 19]: tekst op een bord
#: scripts/maps/depths2.gd:47
msgid "Een tip van een oude held: laat hem tegen een muur of een pilaar knallen. Dan is hij even duizelig."
msgstr "A tip from an old hero: make him crash into a wall or a pillar. That makes him dizzy for a bit."

#. Naam van gebied arena_hall
#: scripts/maps/arena_hall.gd:6
msgid "Arenahal"
msgstr "Arena Hall"

#. Kaart arena_hall, portal [8, 3]: melding als hij op slot zit
#: scripts/maps/arena_hall.gd:36
msgid "De arenadeur zit dicht. Schrijf je eerst in bij Bruno."
msgstr "The arena door is shut. Sign up with Bruno first."

#. Naam van gebied arena
#: scripts/maps/arena.gd:7
msgid "De Arena"
msgstr "The Arena"

#. Naam van gebied arena midden in een zin ("Reizen naar %s?"); de vorm met hoofdletter is "De Arena"
msgid "de Arena"
msgstr "the Arena"

#. Kaart arena, gate [12, 16]: melding als hij op slot zit
#. Kaart arena, portal [12, 16]: melding als hij op slot zit
#: scripts/maps/arena.gd:35 scripts/maps/arena.gd:36
msgid "De poorten blijven dicht tot je alle rondes hebt gewonnen. Opgeven kan bij de gong."
msgstr "The gates stay shut until you win every round. Want to give up? Use the gong."

#. Naam van gebied dauwbos
#. Kaart dauwbos, sign [6, 22]: tekst op een bord
#: scripts/maps/dauwbos.gd:8 scripts/maps/dauwbos.gd:58
msgid "Dauwbos"
msgstr "Dew Woods"

#. Kaart dauwbos, sign [46, 18]: tekst op een bord
#: scripts/maps/dauwbos.gd:56
msgid "Oostelijk pad: Dorstvallei"
msgstr "Eastern path: Dorstvallei"

#. Kaart dauwbos, sign [46, 18]: tekst op een bord
#: scripts/maps/dauwbos.gd:56
msgid "Over de heuvelrug begint het zand. De zon is daar niet te doen."
msgstr "Beyond the ridge the sand begins. The sun there is relentless."

#. Kaart dauwbos, sign [6, 22]: tekst op een bord
#: scripts/maps/dauwbos.gd:58
msgid "Hier hangt de dauw zwaar. De bomen fluisteren zachter."
msgstr "The dew hangs heavy here. The trees whisper more softly."

#. Kaart dauwbos, sign [27, 4]: tekst op een bord
#: scripts/maps/dauwbos.gd:59
msgid "Noordelijk pad: IJsdal"
msgstr "Northern path: IJsdal"

#. Kaart dauwbos, sign [27, 4]: tekst op een bord
#: scripts/maps/dauwbos.gd:59
msgid "Hoge toppen, diepe sneeuw. Warm aan de lantaarns blijven."
msgstr "High peaks, deep snow. Stay warm near the lanterns."

#. Kaart dauwbos, sign [4, 19]: tekst op een bord
#: scripts/maps/dauwbos.gd:60
msgid "Westelijk pad: Fluisterbos"
msgstr "Western path: Whispering Woods"

#. Kaart dauwbos, sign [4, 19]: tekst op een bord
#: scripts/maps/dauwbos.gd:60
msgid "Waar de mist dunner wordt, beginnen de vertrouwde bomen."
msgstr "Where the mist grows thinner, the familiar trees begin."

#. Kaart dauwbos, portal [43, 30]: melding als hij op slot zit
#. Kaart ijsdal, portal [43, 3]: melding als hij op slot zit
#. Kaart kruipmoeras, portal [24, 17]: melding als hij op slot zit
#: scripts/data/living_maps.gd:116 scripts/data/living_maps.gd:168 scripts/data/living_maps.gd:213
msgid "Deze route opent zodra je het gebied hebt hersteld. Kijk bij de gemarkeerde wereldopdracht."
msgstr "This route opens when you restore the area. Look for the marked world quest."

#. Kaart dauwbos, sign [42, 31]: tekst op een bord
#: scripts/data/living_maps.gd:245
msgid "Oostelijk lichtpad: De Dauwtuin."
msgstr "Eastern light path: The Dew Garden."

#. Naam van gebied ijsdal
#. Kaart ijsdal, sign [22, 13]: tekst op een bord
#: scripts/maps/ijsdal.gd:8 scripts/maps/ijsdal.gd:54
msgid "IJsdal"
msgstr "IJsdal"

#. Kaart ijsdal, sign [22, 13]: tekst op een bord
#: scripts/maps/ijsdal.gd:54
msgid "Wit en stil. De sneeuw knarst onder je laarzen."
msgstr "White and silent. The snow crunches under your boots."

#. Kaart ijsdal, sign [37, 25]: tekst op een bord
#: scripts/maps/ijsdal.gd:55
msgid "Mijn van IJsdal"
msgstr "IJsdal Mine"

#. Kaart ijsdal, sign [37, 25]: tekst op een bord
#: scripts/maps/ijsdal.gd:55
msgid "Ijskristal diep in de rotsen. Nodig: een koperen pikhouweel."
msgstr "Ice crystal deep in the rocks. Requires: a copper pickaxe."

#. Kaart ijsdal, sign [26, 32]: tekst op een bord
#. Kaart dorstvallei, sign [27, 30]: tekst op een bord
#: scripts/maps/dorstvallei.gd:55 scripts/maps/ijsdal.gd:56
msgid "Zuidelijk pad: Dauwbos"
msgstr "Southern path: Dew Woods"

#. Kaart ijsdal, sign [26, 32]: tekst op een bord
#: scripts/maps/ijsdal.gd:56
msgid "De sneeuw wordt mist en de wind wordt zacht."
msgstr "The snow turns to mist and the wind turns soft."

#. Kaart ijsdal, sign [41, 4]: tekst op een bord
#: scripts/data/living_maps.gd:247
msgid "Noordelijke route: De Bergpas."
msgstr "Northern route: The Mountain Pass."

#. Naam van gebied dorstvallei
#. Kaart dorstvallei, sign [27, 14]: tekst op een bord
#: scripts/maps/dorstvallei.gd:9 scripts/maps/dorstvallei.gd:53
msgid "Dorstvallei"
msgstr "Dorstvallei"

#. Kaart dorstvallei, sign [27, 14]: tekst op een bord
#: scripts/maps/dorstvallei.gd:53
msgid "De zon brandt, het zand waait. De oase geeft leven."
msgstr "The sun scorches, the sand drifts. The oasis gives life."

#. Kaart dorstvallei, sign [40, 21]: tekst op een bord
#. Kaart kruipmoeras, sign [31, 23]: tekst op een bord
#: scripts/maps/dorstvallei.gd:54 scripts/maps/kruipmoeras.gd:57
msgid "Jachtgronden"
msgstr "Hunting grounds"

#. Kaart dorstvallei, sign [40, 21]: tekst op een bord
#: scripts/maps/dorstvallei.gd:54
msgid "Woestijnvossen en zandhazen. Kom je te dichtbij, dan rennen ze weg."
msgstr "Desert foxes and sand hares. Get too close and they bolt."

#. Kaart dorstvallei, sign [27, 30]: tekst op een bord
#: scripts/maps/dorstvallei.gd:55
msgid "Voorbij de rotsen wacht groen en koelte."
msgstr "Beyond the rocks, greenery and coolness await."

#. Kaart dorstvallei, regional_object [14, 11]: name
#: scripts/data/regional_maps.gd:8
msgid "Nours waterpunt"
msgstr "Nour's water station"

#. Kaart dorstvallei, portal [24, 3]: melding als hij op slot zit
#: scripts/data/regional_maps.gd:29
msgid "Vul eerst Nours waterzak bij de blauwe luifel naast Sana."
msgstr "First fill Nour's waterskin at the blue shelter beside Sana."

#. Kaart dorstvallei, sign [22, 6]: tekst op een bord
#: scripts/data/regional_maps.gd:39 scripts/data/regional_maps.gd:149
msgid "Neem water mee van Sana. Blauwe luifels geven schaduw en vers water."
msgstr "Bring water from Sana. Blue shelters offer shade and fresh water."

#. Naam van gebied kruipmoeras
#. Kaart kruipmoeras, sign [26, 4]: tekst op een bord
#: scripts/maps/kruipmoeras.gd:9 scripts/maps/kruipmoeras.gd:54
msgid "Kruipmoeras"
msgstr "Creeping Swamp"

#. Kaart kruipmoeras, sign [22, 3]: tekst op een bord
#: scripts/maps/kruipmoeras.gd:53
msgid "Noordelijk veenpad: Zilvermeer"
msgstr "Northern peat path: Silver Lake"

#. Kaart kruipmoeras, sign [22, 3]: tekst op een bord
#: scripts/maps/kruipmoeras.gd:53
msgid "Voorbij de knotwilgen wordt de grond weer vast en helder."
msgstr "Past the pollard willows the ground turns firm and bright again."

#. Kaart kruipmoeras, sign [26, 4]: tekst op een bord
#: scripts/maps/kruipmoeras.gd:54
msgid "Het land kwakt en borrelt. Blijf op de modderpaden."
msgstr "The land croaks and bubbles. Stay on the mud paths."

#. Kaart kruipmoeras, sign [5, 22]: tekst op een bord
#: scripts/maps/kruipmoeras.gd:55
msgid "Turfvelden"
msgstr "Peat Fields"

#. Kaart kruipmoeras, sign [5, 22]: tekst op een bord
#: scripts/maps/kruipmoeras.gd:55
msgid "Stien steekt hier turf. Let op je voeten: het is drassig."
msgstr "Stien cuts peat here. Mind your step: it is soggy."

#. Kaart kruipmoeras, sign [36, 7]: tekst op een bord
#: scripts/maps/kruipmoeras.gd:56
msgid "Rietland"
msgstr "Reedland"

#. Kaart kruipmoeras, sign [36, 7]: tekst op een bord
#: scripts/maps/kruipmoeras.gd:56
msgid "Mees vlecht riet tot manden. Het riet knettert in de wind."
msgstr "Mees weaves reeds into baskets. The reeds crackle in the wind."

#. Kaart kruipmoeras, sign [31, 23]: tekst op een bord
#: scripts/maps/kruipmoeras.gd:57
msgid "Moerasvorsten en waterslangen. Ze zijn sneller dan ze lijken."
msgstr "Marsh toads and water snakes. They are quicker than they look."

#. Kaart kruipmoeras, regional_object [41, 12]: name
#: scripts/data/regional_maps.gd:121
msgid "Mees’ tentoonstelling"
msgstr "Mees' exhibition"

#. Naam van gebied mistgarden
#: scripts/maps/mistgarden.gd:4
msgid "De Dauwtuin"
msgstr "The Dew Garden"

#. Naam van gebied mistgarden midden in een zin ("Reizen naar %s?"); de vorm met hoofdletter is "De Dauwtuin"
msgid "de Dauwtuin"
msgstr "the Dew Garden"

#. Kaart mistgarden, sign [4, 12]: tekst op een bord
#: scripts/maps/mistgarden.gd:50
msgid "Terug naar Dauwbos: zuidwestelijk lichtpad."
msgstr "Return to Dewwood: southwestern light path."

#. Kaart mistgarden, sign [4, 12]: tekst op een bord
#: scripts/maps/mistgarden.gd:51
msgid "Het licht heeft de tuin gewekt. Dauwklauwen groeien langs de stroom; honingzwammen onder de oude bomen."
msgstr "The light has awakened the garden. Dewclaws grow along the stream; honey mushrooms beneath the old trees."

#. Naam van gebied ridgepass
#: scripts/maps/ridgepass.gd:4
msgid "De Bergpas"
msgstr "The Mountain Pass"

#. Naam van gebied ridgepass midden in een zin ("Reizen naar %s?"); de vorm met hoofdletter is "De Bergpas"
msgid "de Bergpas"
msgstr "the Mountain Pass"

#. Kaart ridgepass, sign [4, 12]: tekst op een bord
#: scripts/data/regional_maps.gd:155 scripts/maps/ridgepass.gd:51
msgid "Terug naar IJsdal: zuidwestelijk lichtpad."
msgstr "Back to IJsdal: southwestern light path."

#. Kaart ridgepass, sign [4, 12]: tekst op een bord
#: scripts/data/regional_maps.gd:155
msgid "Het bergkamp heeft klimtouw. Steek de pas bovenlangs over wanneer de wimpels slap hangen. Zet de oostelijke touwpaal vast en haal de weerkaart bij de zuidoostelijke schuilhut."
msgstr "The mountain camp has climbing rope. Cross the upper pass while the pennants hang loose. Secure the eastern rope post and collect the weather chart at the southeastern shelter."

#. Kaart ridgepass, regional_object [5, 14]: name
#: scripts/data/regional_maps.gd:47
msgid "Het bergkamp"
msgstr "The mountain camp"

#. Kaart ridgepass, regional_object [18, 7]: name
#: scripts/data/regional_maps.gd:56
msgid "De oostelijke touwpaal"
msgstr "The eastern rope post"

#. Kaart ridgepass, regional_object [24, 16]: name
#: scripts/data/regional_maps.gd:65
msgid "De verloren weerkaart"
msgstr "The lost weather chart"

#. Naam van gebied reedvault
#: scripts/maps/reedvault.gd:4
msgid "Het Rietarchief"
msgstr "The Reed Archive"

#. Naam van gebied reedvault midden in een zin ("Reizen naar %s?"); de vorm met hoofdletter is "Het Rietarchief"
msgid "het Rietarchief"
msgstr "the Reed Archive"

#. Kaart reedvault, sign [4, 12]: tekst op een bord
#: scripts/maps/reedvault.gd:51
msgid "Het water verbergt geen geschiedenis meer. De schildwachten beschermen hun zanger; breek de formatie of gebruik de pilaren als dekking."
msgstr "Water no longer hides this history. The shield wardens protect their singer; break the formation or use the pillars as cover."

#. Kaart reedvault, sign [24, 15]: tekst op een bord
#: scripts/maps/reedvault.gd:116
msgid "De bewoners van Azura voerden het licht door de bergen, de wortels en het water. Hun bouwwerken delen dezelfde oorsprong."
msgstr "Azura’s people carried light through mountains, roots and water. Their structures share the same origin."

#. Kaart reedvault, regional_object [12, 15]: name
#. Naam van wie er praat (Gesprek ra_order)
#: scripts/data/regional_maps.gd:76 scripts/data/ext/regional.gd:81
msgid "De leestafel"
msgstr "The reading table"

#. Kaart reedvault, regional_object [5, 15]: name
#: scripts/data/regional_maps.gd:86
msgid "Reliëf: de rietvelden"
msgstr "Relief: the reed beds"

#. Kaart reedvault, regional_object [5, 15]: clue
#: scripts/data/regional_maps.gd:92
msgid "Riet, vissers en een brede oever. Er zijn nog geen huizen of aanlegpalen. Dit is het begin van de nederzetting."
msgstr "Reeds, fishers and a wide bank. There are no houses or mooring posts yet. This is the beginning of the settlement."

#. Kaart reedvault, regional_object [5, 4]: name
#: scripts/data/regional_maps.gd:97
msgid "Reliëf: de aanlegplaats"
msgstr "Relief: the landing"

#. Kaart reedvault, regional_object [5, 4]: clue
#: scripts/data/regional_maps.gd:103
msgid "Huizen staan op de vroegere rietvelden. Lange aanlegpalen steken ver boven het lage water uit. De handel groeit."
msgstr "Houses stand on the former reed beds. Long mooring posts rise far above the low water. Trade is growing."

#. Kaart reedvault, regional_object [23, 4]: name
#: scripts/data/regional_maps.gd:108
msgid "Reliëf: het hoogwater"
msgstr "Relief: the flood"

#. Kaart reedvault, regional_object [23, 4]: clue
#: scripts/data/regional_maps.gd:114
msgid "Het water staat boven dezelfde aanlegpalen. Bewoners verlaten hun huizen en trekken naar het hoge eiland."
msgstr "Water rises above those same mooring posts. Residents leave their homes and move to the high island."

#. Kaart reedvault, regional_object [6, 2]: name
#. Kaart reedvault, regional_object [12, 2]: name
#. Kaart reedvault, regional_object [19, 2]: name
#: scripts/data/regional_maps.gd:134
msgid "Archiefkast"
msgstr "Archive shelf"

#. Naam van gebied prismamine
#. Kaart prismamine, sign [8, 24]: tekst op een bord
#: scripts/maps/prismamine.gd:4 scripts/maps/prismamine.gd:86
msgid "De Prismamijn"
msgstr "The Prism Mine"

#. Naam van gebied prismamine midden in een zin ("Reizen naar %s?"); de vorm met hoofdletter is "De Prismamijn"
msgid "de Prismamijn"
msgstr "the Prism Mine"

#. Kaart prismamine, sign [8, 24]: tekst op een bord
#: scripts/maps/prismamine.gd:87
msgid "Drie snelle zwaardaanvallen vormen een combo. De derde is een brede veeg voor 18 stamina. Zonder energie blijft het een gewone slag."
msgstr "Three quick sword attacks form a combo. The third is a wide sweep costing 18 stamina. Without enough energy, it remains a normal strike."

#. Kaart prismamine, sign [34, 7]: tekst op een bord
#: scripts/maps/prismamine.gd:97
msgid "Naar de Resonantiekamer"
msgstr "To the Resonance Chamber"

#. Kaart prismamine, sign [34, 7]: tekst op een bord
#: scripts/maps/prismamine.gd:98
msgid "Raak daar het zwevende kristal aan om drie golven te beginnen. Je kunt altijd terugtrekken."
msgstr "Touch the floating crystal there to begin three waves. You can retreat at any time."

#. Naam van gebied resonance
#: scripts/maps/resonance.gd:4
msgid "De Resonantiekamer"
msgstr "The Resonance Chamber"

#. Naam van gebied resonance midden in een zin ("Reizen naar %s?"); de vorm met hoofdletter is "De Resonantiekamer"
msgid "de Resonantiekamer"
msgstr "the Resonance Chamber"

#. Kaart resonance, sign [18, 19]: tekst op een bord
#. Legenda op het kaartje (menu): echo_trial
#: scripts/entities/echo_trial.gd:23 scripts/data/ext/echo.gd:19 scripts/maps/resonance.gd:67
msgid "Resonantieproef"
msgstr "Resonance Trial"

#. Kaart resonance, sign [18, 19]: tekst op een bord
#: scripts/maps/resonance.gd:68
msgid "Kristalkevers stormen na hun lichtspoor recht vooruit. Prismamotten schieten tussen drie stralen. Ontwijk opzij of onderbreek de mot met je zwaard."
msgstr "Crystal beetles charge straight ahead after showing their light trail. Prism moths fire along three rays. Dodge sideways or interrupt the moth with your sword."

#. Kaart resonance, sign [18, 19]: tekst op een bord
#: scripts/maps/resonance.gd:69
msgid "Win drie golven voor een kristallen amulet en 120 munten. De beloning krijg je eenmaal per avontuur."
msgstr "Win three waves for a crystal amulet and 120 coins. You receive this reward once per adventure."

#. Blijvend gevolg van opdracht ad_message
#: scripts/data/ext/coastal_adventures.gd:7
msgid "De haven markeert de gevaarlijke buitenbank met een waarschuwingsboei."
msgstr "The harbor marks the dangerous outer shoal with a warning buoy."

#. Blijvend gevolg van opdracht ad_pilot
#: scripts/data/ext/coastal_adventures.gd:8
msgid "Bij de bank staat weer een laag windscherm. De kaap blijft vrij en rustig."
msgstr "A low windbreak stands by the bench again. The headland stays open and quiet."

#. Blijvend gevolg van opdracht ad_wheel
#: scripts/data/ext/coastal_adventures.gd:9
msgid "Het tijrad draait en de korte brug is droog. De lange zuidelijke route blijft altijd open."
msgstr "The tide wheel turns and the short bridge is dry. The long southern route always stays open."

#. Blijvend gevolg van opdracht ad_keeper
#: scripts/data/ext/coastal_adventures.gd:10
msgid "Je keuze verandert de poel of het havenrad. Beide uitkomsten sluiten het verhaal af."
msgstr "Your choice changes the pool or the harbor wheel. Both outcomes complete the story."

#. Blijvend gevolg van opdracht ra_ridge
#: scripts/data/ext/regional.gd:6
msgid "Een vaste klimlijn en klimhandschoenen; de weerkaart helpt IJsdals reizigers."
msgstr "A permanent climbing line and climbing gloves; the weather chart helps IJsdal's travelers."

#. Blijvend gevolg van opdracht ra_archive
#: scripts/data/ext/regional.gd:42
msgid "Een tentoonstelling bij Mees en een archiefkompas voor ontdekkingsreizigers."
msgstr "An exhibition at Mees' and an archive compass for explorers."

#. Blijvend gevolg van opdracht ls_supper
#: scripts/data/ext/lake_supper.gd:4
msgid "Een vaste dorpsmaaltijd bij Mila en twee recepten voor onderweg."
msgstr "A regular village meal at Mila’s and two recipes for the road."

#. Blijvend gevolg van opdracht warmte
#: scripts/data/ext/living.gd:76
msgid "Huizen verwarmd, bewoners terug en Bergpas geopend."
msgstr "Houses heated, residents returned and Mountain Pass opened."

#. Blijvend gevolg van opdracht cactusvijgen
#: scripts/data/ext/dorst.gd:49
msgid "De oase stroomt weer; kies een drinkplaats voor wild of een rustplaats voor reizigers."
msgstr "The oasis flows again; choose a watering hole for wildlife or a rest stop for travelers."

#. Blijvend gevolg van opdracht wilgentwijgen
#: scripts/data/ext/living.gd:94
msgid "Water verlaagd, handelsbrug hersteld, visplek en Rietarchief geopend."
msgstr "Water lowered, trade bridge restored, fishing spot and Reed Archive opened."

#. Blijvend gevolg van opdracht prisma_herstel
#: scripts/data/ext/living.gd:29
msgid "Prismawerkplaats, nieuwe ertsaders en de schildbreker-combo vrijgespeeld."
msgstr "Unlocked the prism workshop, new ore veins and the guard-breaking combo."

#. Blijvend gevolg van opdracht lichtwerk
#: scripts/data/ext/living.gd:38
msgid "Prismalantaarn: onthult bosrunen en houdt mistjagers op afstand."
msgstr "Prism lantern: reveals forest runes and keeps mist stalkers at bay."

#. Blijvend gevolg van opdracht mistsporen
#: scripts/data/ext/living.gd:56
msgid "Mist verdreven, Dauwtuin geopend en verkennersjas ontvangen."
msgstr "Mist dispelled, Dew Garden opened and scout coat received."

#. Blijvend gevolg van opdracht first_water
#: scripts/data/ext/opening.gd:8
msgid "De fontein stroomt, Nelle verzorgt de bloembakken en Greta herkent het oude prismateken."
msgstr "The fountain flows, Nelle tends the flower beds and Greta recognises the old prism symbol."

#. Blijvend gevolg van opdracht rf_memory
#: scripts/data/ext/first_route.gd:4
msgid "Een verlichte herdenkingsplek in de Ruïne; jouw inscriptie blijft staan."
msgstr "A lit memorial in the Ruins; your chosen inscription remains."

#. Blijvend gevolg van opdracht rf_echo
#: scripts/data/ext/first_route.gd:8
msgid "Blijvende lichtbakens wijzen naar de oude schuilplaats met het medaillon."
msgstr "Permanent light markers lead to the old refuge holding the medallion."

#. Naam van wie er praat (Gesprek bram_intro)
#. Naam van wie er praat (Gesprek bram_intro2)
#. Naam van wie er praat (Gesprek bram_explain)
#. Naam van wie er praat (Gesprek bram_accept)
#. Naam van wie er praat (Gesprek bram_later)
#. Naam van wie er praat (Gesprek bram_progress)
#: scripts/ui/ending.gd:54 scripts/data/dialogue.gd:18 scripts/data/dialogue.gd:27 scripts/data/dialogue.gd:39
msgid "Oudste Bram"
msgstr "Elder Bram"

#. Gesprek bram_intro, Oudste Bram zegt
#: scripts/data/dialogue.gd:20
msgid "Ah, een reiziger! Welkom in Dageraadsdorp."
msgstr "Ah, a traveler! Welcome to Daybreak Village."

#. Gesprek bram_intro, Oudste Bram zegt
#: scripts/data/dialogue.gd:21
msgid "Ik ben Bram, de oudste van het dorp en de bewaker van de Blauwe Kaart."
msgstr "I'm Bram, the village elder and the keeper of the Blue Map."

#. Gesprek bram_intro, Oudste Bram zegt
#: scripts/data/dialogue.gd:22
msgid "Kijk, in de tempel hangt de kaart van heel Azura, gemaakt van gloeiend kristal. Hij houdt de slijmen rustig en laat zien waar het land veilig is."
msgstr "You see, our temple holds a map of all of Azura, made of glowing crystal. It keeps the slimes calm and shows where the land is safe."

#. Gesprek bram_intro2, Oudste Bram zegt
#: scripts/data/dialogue.gd:29
msgid "Maar drie nachten geleden barstte de kaart. De drie grote kristallen sprongen eruit en vlogen het land in: naar het Fluisterbos, de Vergeten Ruïne en de Echo-grot."
msgstr "But three nights ago, the map cracked. Its three big crystals popped out and flew off across the land: to the Whispering Woods, the Forgotten Ruins, and the Echo Cave."

#. Gesprek bram_intro2, Oudste Bram zegt
#: scripts/data/dialogue.gd:30
msgid "Sindsdien zijn de slijmen wild geworden. En onder de tempel... daar hoor ik iets groots bewegen."
msgstr "Since then, the slimes have gone wild. And under the temple... I can hear something big moving."

#. Gesprek bram_intro2: keuze van de speler
#. Gesprek bram_explain: keuze van de speler
#: scripts/data/dialogue.gd:33 scripts/data/dialogue.gd:45
msgid "Ik help je!"
msgstr "I'll help you!"

#. Gesprek bram_intro2: keuze van de speler
#: scripts/data/dialogue.gd:34
msgid "Wat moet ik precies doen?"
msgstr "What exactly do I do?"

#. Gesprek bram_intro2: keuze van de speler
#: scripts/data/dialogue.gd:35
msgid "Ik moet er even over nadenken."
msgstr "Let me think about it."

#. Gesprek bram_explain, Oudste Bram zegt
#: scripts/data/dialogue.gd:41
msgid "Zoek de drie kaartkristallen en breng ze naar mij. Het Fluisterbos ligt over de brug in het oosten, de Wachter Hein houdt er een oogje op."
msgstr "Find the three map crystals and bring them to me. The Whispering Woods are across the bridge to the east. Guard Hein keeps an eye on them."

#. Gesprek bram_explain, Oudste Bram zegt
#: scripts/data/dialogue.gd:42
msgid "Met een houten zwaard kom je niet ver. Greta de smid kan beter spul maken als je haar slijmgel brengt, en Tobias verkoopt drankjes."
msgstr "You won't get far with a Wooden Sword. Greta the Smith can make better gear if you bring her Slime Gel, and Tobias sells potions."

#. Gesprek bram_explain: keuze van de speler
#: scripts/data/dialogue.gd:46
msgid "Ik kom straks terug."
msgstr "I'll be back later."

#. Gesprek bram_accept, Oudste Bram zegt
#: scripts/data/dialogue.gd:52
msgid "Dank je, held! Neem dit mee voor onderweg."
msgstr "Thank you, hero! Take this for the road."

#. Gesprek bram_accept, Oudste Bram zegt
#: scripts/data/dialogue.gd:53
msgid "Een helddrank. Druk op H als je gewond bent. En rol met Shift om aanvallen te ontwijken, dan kan niets je raken!"
msgstr "A Hero Potion. Press H when you're hurt. And roll with Shift to dodge attacks. Nothing can hit you while you roll!"

#. Gesprek bram_later, Oudste Bram zegt
#: scripts/data/dialogue.gd:59
msgid "Neem de tijd. Maar de slijmen wachten niet..."
msgstr "Take your time. But the slimes won't wait..."

#. Gesprek bram_progress, Oudste Bram zegt
#: scripts/data/dialogue.gd:64
msgid "Hoe gaat het met de zoektocht? Je hebt {crystals} van de 3 kristallen."
msgstr "How's the quest going? You have {crystals} of the 3 crystals."

#. Gesprek bram_progress, Oudste Bram zegt
#: scripts/data/dialogue.gd:65
msgid "Het Fluisterbos, de Vergeten Ruïne en de Echo-grot. Pas goed op jezelf!"
msgstr "The Whispering Woods, the Forgotten Ruins, and the Echo Cave. Take good care of yourself!"

#. Gesprek bram_crystals, Oudste Bram zegt
#: scripts/data/dialogue.gd:71
msgid "Je hebt ze alle drie! Ik kan het bijna niet geloven..."
msgstr "You have all three! I can hardly believe it..."

#. Gesprek bram_crystals, Oudste Bram zegt
#: scripts/data/dialogue.gd:72
msgid "Geef maar hier. Ik leg ze terug in de Blauwe Kaart."
msgstr "Hand them over. I'll put them back in the Blue Map."

#. Gesprek bram_crystals2, Oudste Bram zegt
#: scripts/data/dialogue.gd:80
msgid "Kijk! De kaart gloeit weer. Maar luister... de deur van de tempel is opengesprongen."
msgstr "Look! The map is glowing again. But listen... the temple door has burst open."

#. Gesprek bram_crystals2, Oudste Bram zegt
#: scripts/data/dialogue.gd:81
msgid "Daarbeneden zit de Slijmkoning. Hij dronk de kracht van de gebarsten kaart en is gigantisch geworden."
msgstr "The Slime King is down there. He drank the power of the cracked map and grew gigantic."

#. Gesprek bram_crystals2, Oudste Bram zegt
#: scripts/data/dialogue.gd:82
msgid "Alleen jij kunt hem nog stoppen. Rust uit in de herberg, drink een drankje en neem je beste zwaard mee."
msgstr "Only you can stop him now. Rest at the inn, drink a potion, and bring your best sword."

#. Gesprek bram_crystals2, Oudste Bram zegt
#: scripts/data/dialogue.gd:83
msgid "Veel succes, held. Heel Azura rekent op je."
msgstr "Good luck, hero. All of Azura is counting on you."

#. Gesprek bram_boss_wait, Oudste Bram zegt
#: scripts/data/dialogue.gd:89
msgid "De tempeldeur staat open. Rust eerst goed uit in de herberg, dan ben je er klaar voor."
msgstr "The temple door is open. Get a good rest at the inn first. Then you'll be ready."

#. Gesprek bram_done, Oudste Bram zegt
#: scripts/data/dialogue.gd:94
msgid "Dankzij jou is de Blauwe Kaart weer heel!"
msgstr "Thanks to you, the Blue Map is whole again!"

#. Gesprek bram_done, Oudste Bram zegt
#: scripts/data/dialogue.gd:95
msgid "Het dorp viert feest. Rust maar uit, held. Je hebt het verdiend."
msgstr "The village is celebrating. Get some rest, hero. You've earned it."

#. Naam van wie er praat (Gesprek greta_intro)
#. Naam van wie er praat (Gesprek greta_menu)
#. Naam van wie er praat (Gesprek greta_iron)
#. Naam van wie er praat (Gesprek greta_iron_ask)
#. Naam van wie er praat (Gesprek greta_iron_no)
#. Naam van wie er praat (Gesprek greta_iron_done)
#: scripts/ui/ending.gd:55 scripts/core/opening.gd:20 scripts/data/dialogue.gd:101 scripts/data/dialogue.gd:110
msgid "Greta"
msgstr "Greta"

#. Gesprek greta_intro, Greta zegt
#: scripts/data/dialogue.gd:103
msgid "Hé! Jij bent dat reizigertje van Bram, hè? Ik ben Greta, de smid."
msgstr "Hey! You're Bram's little traveler, right? I'm Greta, the smith."

#. Gesprek greta_intro, Greta zegt
#: scripts/data/dialogue.gd:104
msgid "Dat houten ding van jou is geen zwaard, het is een stok met ambitie."
msgstr "That wooden thing of yours isn't a sword. It's a stick with big dreams."

#. Gesprek greta_menu, Greta zegt
#: scripts/data/dialogue.gd:111
msgid "Wat kan ik voor je smeden?"
msgstr "What can I forge for you?"

#. Gesprek greta_menu: keuze van de speler
#: scripts/data/dialogue.gd:113
msgid "Een ijzeren zwaard"
msgstr "An Iron Sword"

#. Gesprek greta_menu: keuze van de speler
#: scripts/data/dialogue.gd:114
msgid "Een kristalzwaard"
msgstr "A Crystal Sword"

#. Gesprek greta_menu: keuze van de speler
#: scripts/data/dialogue.gd:115 scripts/data/dialogue.gd:427
msgid "Samen je werkbankklem afstellen."
msgstr "Adjust your workbench clamp together."

#. Gesprek greta_menu: keuze van de speler
#: scripts/data/dialogue.gd:116 scripts/data/dialogue.gd:427
msgid "Niets, bedankt."
msgstr "Nothing, thanks."

#. Gesprek greta_iron, Greta zegt
#: scripts/data/dialogue.gd:121
msgid "Een ijzeren zwaard? Dat kost 5 slijmgel en 40 munten. Je hebt {gel} slijmgel en {coins} munten."
msgstr "An Iron Sword? That costs 5 Slime Gel and 40 coins. You have {gel} Slime Gel and {coins} coins."

#. Gesprek greta_iron_ask, Greta zegt
#: scripts/data/dialogue.gd:129
msgid "Dat kan! Zal ik hem voor je smeden?"
msgstr "You can afford it! Shall I forge it for you?"

#. Gesprek greta_iron_ask: keuze van de speler
#. Gesprek greta_crystal_ask: keuze van de speler
#: scripts/data/dialogue.gd:132 scripts/data/dialogue.gd:163
msgid "Ja, smeed maar!"
msgstr "Yes, forge it!"

#. Gesprek greta_iron_ask: keuze van de speler
#. Gesprek greta_crystal_ask: keuze van de speler
#. Gesprek ls_share: keuze van de speler
#. Gesprek wereld_bed_menu: keuze van de speler
#. Gesprek arena_bronze_ask: keuze van de speler
#. Gesprek arena_silver_ask: keuze van de speler
#: scripts/data/dialogue.gd:136 scripts/data/dialogue.gd:167 scripts/data/ext/arena.gd:139 scripts/data/ext/arena.gd:158
msgid "Nog even niet."
msgstr "Not just yet."

#. Gesprek greta_iron_no, Greta zegt
#: scripts/data/dialogue.gd:141
msgid "Dan ben je nog niet klaar. Slijmen in het bos laten slijmgel vallen. Kom maar terug als je genoeg hebt."
msgstr "Then you're not ready yet. Slimes in the woods drop Slime Gel. Come back when you have enough."

#. Gesprek greta_iron_done, Greta zegt
#: scripts/data/dialogue.gd:145
msgid "Zo! Voel dat gewicht eens. Dit raakt een stuk harder dan je stok."
msgstr "There! Feel that weight. This hits a lot harder than your stick."

#. Gesprek greta_crystal, Greta zegt
#: scripts/data/dialogue.gd:150
msgid "Een kristalzwaard... Dat is werk voor een meester. Ik heb 2 kristalscherven nodig, 8 slijmgel en 80 munten."
msgstr "A Crystal Sword... That's a job for a master. I need 2 Crystal Shards, 8 Slime Gel, and 80 coins."

#. Gesprek greta_crystal, Greta zegt
#: scripts/data/dialogue.gd:151
msgid "Je hebt {shards} scherven, {gel} slijmgel en {coins} munten. Golems in de ruïne en de grot laten scherven vallen."
msgstr "You have {shards} shards, {gel} Slime Gel, and {coins} coins. Golems in the ruins and the cave drop shards."

#. Gesprek greta_crystal_ask, Greta zegt
#: scripts/data/dialogue.gd:160
msgid "Je hebt alles! Dit wordt mijn mooiste zwaard. Zal ik beginnen?"
msgstr "You have everything! This will be my finest sword ever. Shall I start?"

#. Gesprek greta_crystal_no, Greta zegt
#: scripts/data/dialogue.gd:172
msgid "Nog niet genoeg. Kom terug als je alles hebt, dan maak ik er iets moois van."
msgstr "Not enough yet. Come back when you have it all, and I'll make something beautiful."

#. Gesprek greta_crystal_done, Greta zegt
#: scripts/data/dialogue.gd:176
msgid "Kijk dat nou... het gloeit! Pas er goed op, dit is het beste wat ik ooit gemaakt heb."
msgstr "Look at that... it glows! Take good care of it. It's the best thing I've ever made."

#. Gesprek greta_max, Greta zegt
#: scripts/data/dialogue.gd:180
msgid "Dat kristalzwaard is mijn beste werk. Meer kan ik er niet aan doen. Ga ze maar een lesje leren!"
msgstr "That Crystal Sword is my best work. I can't make it any better. Now go teach them a lesson!"

#. Gesprek greta_done, Greta zegt
#: scripts/data/dialogue.gd:185
msgid "De held van Azura in mijn smederij! Ik heb net nieuwe zwaarden gesmeed, voor op het feest. Nou ja, voor de taart."
msgstr "The hero of Azura in my smithy! I just forged some new swords for the party. Well... for cutting the cake."

#. Naam van wie er praat (Gesprek tobias_intro)
#. Naam van wie er praat (Gesprek tobias_menu)
#. Naam van wie er praat (Gesprek tobias_sell)
#. Naam van wie er praat (Gesprek tobias_sold)
#. Naam van wie er praat (Gesprek tobias_done)
#: scripts/ui/ending.gd:56 scripts/data/dialogue.gd:195 scripts/data/dialogue.gd:201 scripts/data/dialogue.gd:210
msgid "Tobias"
msgstr "Tobias"

#. Gesprek tobias_intro, Tobias zegt
#: scripts/data/dialogue.gd:196
msgid "Welkom, welkom! Tobias, koopman van de beste waar van heel Azura!"
msgstr "Welcome, welcome! I'm Tobias, seller of the finest goods in all of Azura!"

#. Gesprek tobias_intro, Tobias zegt
#: scripts/data/dialogue.gd:196
msgid "Of eigenlijk van het hele dorp. Maar dat is wel eerlijk gezegd het enige."
msgstr "Well, the finest in the village. But to be fair, mine's the only shop here."

#. Gesprek tobias_menu, Tobias zegt
#: scripts/data/dialogue.gd:202
msgid "Zeg het maar, wat mag het zijn?"
msgstr "So, what'll it be?"

#. Gesprek tobias_menu: keuze van de speler
#: scripts/data/dialogue.gd:204
msgid "Ik wil iets kopen."
msgstr "I want to buy something."

#. Gesprek tobias_menu: keuze van de speler
#: scripts/data/dialogue.gd:205
msgid "Ik wil slijmgel verkopen."
msgstr "I want to sell Slime Gel."

#. Gesprek tobias_menu: keuze van de speler
#. Gesprek meer_joris_menu: keuze van de speler
#. Gesprek arena_bruno_menu: keuze van de speler
#. Gesprek noor_menu: keuze van de speler
#. Gesprek vera_menu: keuze van de speler
#: scripts/data/dialogue.gd:206 scripts/data/ext/arena.gd:110 scripts/data/ext/meer.gd:187 scripts/data/ext/polijst.gd:294
msgid "Tot ziens."
msgstr "Goodbye."

#. Gesprek tobias_sell, Tobias zegt
#: scripts/data/dialogue.gd:211
msgid "Slijmgel? Prima spul! Ik geef 3 munten per stuk. Je hebt {gel} stuks. Pas op: Greta en Mila hebben het ook nodig."
msgstr "Slime Gel? Great stuff! I'll pay 3 coins each. You have {gel}. Careful though: Greta and Mila need it too."

#. Gesprek tobias_sell: keuze van de speler
#: scripts/data/dialogue.gd:213
msgid "Verkoop alles."
msgstr "Sell it all."

#. Gesprek tobias_sell: keuze van de speler
#. Gesprek arena_bruno_ranks: keuze van de speler
#: scripts/data/dialogue.gd:214 scripts/data/ext/arena.gd:120
msgid "Toch maar niet."
msgstr "Never mind."

#. Gesprek tobias_sold, Tobias zegt
#: scripts/data/dialogue.gd:219
msgid "Prima zaken doen met jou!"
msgstr "Pleasure doing business with you!"

#. Gesprek tobias_done, Tobias zegt
#: scripts/data/dialogue.gd:224
msgid "Mijn omzet is verdubbeld sinds de Slijmkoning weg is! Alles blijft voor jou gewoon hetzelfde. Maar dan wel met een knipoog."
msgstr "My sales have doubled since the Slime King left! Don't worry, your prices stay the same. *wink*"

#. Naam van wie er praat (Gesprek mila_intro)
#. Naam van wie er praat (Gesprek mila_menu)
#. Naam van wie er praat (Gesprek mila_rest)
#. Naam van wie er praat (Gesprek mila_quest)
#. Naam van wie er praat (Gesprek mila_quest_ok)
#. Naam van wie er praat (Gesprek mila_potion_progress)
#: scripts/ui/ending.gd:57 scripts/data/dialogue.gd:231 scripts/data/dialogue.gd:240 scripts/data/dialogue.gd:252
msgid "Mila"
msgstr "Mila"

#. Gesprek mila_intro, Mila zegt
#: scripts/data/dialogue.gd:233
msgid "Welkom in de herberg! Ik ben Mila."
msgstr "Welcome to the inn! I'm Mila."

#. Gesprek mila_intro, Mila zegt
#: scripts/data/dialogue.gd:234
msgid "Je mag hier altijd uitrusten, dat is gratis voor een held. Je wordt helemaal beter en ik schrijf op waar je gebleven was."
msgstr "You can always rest here. It's free for a hero. You'll be fully healed, and I'll write down where you left off."

#. Gesprek mila_menu, Mila zegt
#: scripts/data/dialogue.gd:241
msgid "Hoe kan ik je helpen?"
msgstr "How can I help you?"

#. Gesprek mila_menu: keuze van de speler
#: scripts/data/dialogue.gd:243
msgid "Ik wil uitrusten."
msgstr "I'd like to rest."

#. Gesprek mila_menu: keuze van de speler
#: scripts/data/dialogue.gd:244
msgid "Ik heb verse vis voor je! ({visgeld} munten)"
msgstr "I've got fresh fish for you! ({visgeld} coins)"

#. Gesprek mila_menu: keuze van de speler
#. Gesprek meer_joris_menu: keuze van de speler
#. Gesprek meer_lena_menu: keuze van de speler
#: scripts/data/dialogue.gd:245 scripts/data/ext/meer.gd:182 scripts/data/ext/meer.gd:331
msgid "Heb je werk voor me?"
msgstr "Got any work for me?"

#. Gesprek mila_menu: keuze van de speler
#: scripts/data/dialogue.gd:246
msgid "Mag ik hier slapen?"
msgstr "Can I sleep here?"

#. Gesprek mila_menu: keuze van de speler
#: scripts/data/dialogue.gd:247
msgid "Vertel over de dorpstafel."
msgstr "Tell me about the village table."

#. Gesprek mila_menu: keuze van de speler
#. Gesprek meer_lena_menu: keuze van de speler
#: scripts/data/dialogue.gd:248 scripts/data/ext/meer.gd:335
msgid "Nee, bedankt."
msgstr "No, thanks."

#. Gesprek mila_rest, Mila zegt
#: scripts/data/dialogue.gd:253
msgid "Zo, helemaal opgeknapt! Ik heb je voortgang opgeschreven."
msgstr "There, good as new! I wrote down your progress."

#. Gesprek mila_quest, Mila zegt
#: scripts/data/dialogue.gd:258
msgid "Eigenlijk wel! Ik wil helddrankjes brouwen voor het dorp, maar ik heb slijmgel nodig. Vijf stuks."
msgstr "Actually, yes! I want to brew Hero Potions for the village, but I need Slime Gel. Five blobs of it."

#. Gesprek mila_quest, Mila zegt
#: scripts/data/dialogue.gd:259
msgid "Breng je ze mij, dan krijg je er drie drankjes en wat munten voor je moeite."
msgstr "Bring them to me, and you'll get three potions and some coins for your trouble."

#. Gesprek mila_quest: keuze van de speler
#: scripts/data/dialogue.gd:262
msgid "Dat doe ik."
msgstr "I'll do it."

#. Gesprek mila_quest: keuze van de speler
#. Gesprek pim_intro: keuze van de speler
#. Gesprek meer_joris_karper_vraag: keuze van de speler
#. Gesprek meer_lena_vraag: keuze van de speler
#. Gesprek elke_vraag: keuze van de speler
#: scripts/data/dialogue.gd:263 scripts/data/dialogue.gd:296 scripts/data/ext/meer.gd:268 scripts/data/ext/meer.gd:367
msgid "Misschien later."
msgstr "Maybe later."

#. Gesprek mila_quest_ok, Mila zegt
#: scripts/data/dialogue.gd:268
msgid "Fijn! Slijmen in het bos laten het vaak vallen."
msgstr "Great! Slimes in the woods often drop it."

#. Gesprek mila_potion_progress, Mila zegt
#: scripts/data/dialogue.gd:272
msgid "Heb je al genoeg slijmgel? Je hebt er {gel} van de 5."
msgstr "Got enough Slime Gel yet? You have {gel} of 5."

#. Gesprek mila_potion_done, Mila zegt
#: scripts/data/dialogue.gd:276
msgid "Slijmgel! Vijf stuks! Dan ga ik meteen aan de slag."
msgstr "Slime Gel! Five blobs! I'll get brewing right away."

#. Gesprek mila_potion_done, Mila zegt
#: scripts/data/dialogue.gd:276
msgid "Hier, drie helddrankjes en 25 munten. Dank je wel!"
msgstr "Here, three Hero Potions and 25 coins. Thank you!"

#. Gesprek mila_done, Mila zegt
#: scripts/data/dialogue.gd:282
msgid "De herberg zit vol met mensen die jou willen zien. Jouw bed is altijd vrij, held."
msgstr "The inn is packed with people who want to meet you. Your bed is always ready, hero."

#. Naam van wie er praat (Gesprek pim_intro)
#. Naam van wie er praat (Gesprek pim_ok)
#. Naam van wie er praat (Gesprek pim_progress)
#. Naam van wie er praat (Gesprek pim_cat_back)
#. Naam van wie er praat (Gesprek pim_done)
#. Naam van personage pim (boven zijn hoofd)
#: scripts/ui/ending.gd:58 scripts/data/dialogue.gd:289 scripts/data/dialogue.gd:300 scripts/data/dialogue.gd:304
msgid "Pim"
msgstr "Pim"

#. Gesprek pim_intro, Pim zegt
#: scripts/data/dialogue.gd:291
msgid "Snif... Muis is weg!"
msgstr "Sniff... Mouse is gone!"

#. Gesprek pim_intro, Pim zegt
#: scripts/data/dialogue.gd:292
msgid "Mijn kat Muis is gisteren het bos in gerend. Het is daar zo eng... Wil jij haar zoeken?"
msgstr "My cat Mouse ran into the woods yesterday. It's so scary in there... Will you look for her?"

#. Gesprek pim_intro: keuze van de speler
#: scripts/data/dialogue.gd:295
msgid "Ik zoek haar wel!"
msgstr "I'll find her!"

#. Gesprek pim_ok, Pim zegt
#: scripts/data/dialogue.gd:301
msgid "Echt waar?! Ze is wit met een zwart vlekje op haar neus. Volg de pootafdrukken ten zuiden van het bospad. Ze schrikt van rennen: praat rustig en wacht tot ze je vertrouwt."
msgstr "Really?! She is white with a black spot on her nose. Follow the pawprints south of the forest path. Running frightens her: speak gently and wait for her to trust you."

#. Gesprek pim_progress, Pim zegt
#: scripts/data/dialogue.gd:305
msgid "Heb je Muis al gezien? Zoek de pootafdrukken bij het zuidelijke bospad. Geef haar rust als ze schrikt."
msgstr "Have you seen Muis? Look for pawprints by the southern forest path. Give her time to settle if she gets scared."

#. Gesprek pim_cat_back, Pim zegt
#: scripts/data/dialogue.gd:310
msgid "Muis!!! Je hebt haar gevonden!"
msgstr "Mouse!!! You found her!"

#. Gesprek pim_cat_back, Pim zegt
#: scripts/data/dialogue.gd:311
msgid "Dankjewel, dankjewel! Hier, dit vond ik in het bos. Het is vast iets waard."
msgstr "Thank you, thank you! Here, I found this in the woods. It must be worth something."

#. Gesprek pim_done, Pim zegt
#: scripts/data/dialogue.gd:317
msgid "Muis ligt weer naast me te spinnen. Zodra iemand begint te rennen, steekt ze haar oren op. Bij jou voelt ze zich veilig."
msgstr "Muis is purring beside me again. Her ears prick up whenever someone runs. She feels safe with you."

#. Naam van wie er praat (Gesprek muis_bos)
#. Naam van wie er praat (Gesprek muis_dorp)
#. Naam van personage muis_bos (boven zijn hoofd)
#. Naam van personage muis_dorp (boven zijn hoofd)
#: scripts/data/dialogue.gd:320 scripts/data/dialogue.gd:328 scripts/data/npcs.gd:89 scripts/data/npcs.gd:93
msgid "Muis"
msgstr "Mouse"

#. Gesprek muis_bos, Muis zegt
#: scripts/data/dialogue.gd:322
msgid "Miauw?"
msgstr "Meow?"

#. Gesprek muis_bos, Muis zegt
#: scripts/data/dialogue.gd:323
msgid "Muis snuffelt aan je hand en rent met een grote boog het bos uit, richting het dorp."
msgstr "Mouse sniffs your hand, then runs out of the woods in a big loop, toward the village."

#. Gesprek muis_dorp, Muis zegt
#: scripts/data/dialogue.gd:329
msgid "Miauw. (Ze rolt zich op en begint te spinnen.)"
msgstr "Meow. (She curls up and starts to purr.)"

#. Naam van wie er praat (Gesprek hein_talk)
#. Naam van wie er praat (Gesprek hein_done)
#. Naam van personage hein (boven zijn hoofd)
#: scripts/data/dialogue.gd:334 scripts/data/dialogue.gd:341 scripts/data/npcs.gd:58
msgid "Wachter Hein"
msgstr "Guard Hein"

#. Gesprek hein_talk, Wachter Hein zegt
#: scripts/data/dialogue.gd:336
msgid "Halt! Oh, jij bent het. Het Fluisterbos is gevaarlijk: slijmen en vleermuizen overal."
msgstr "Halt! Oh, it's you. The Whispering Woods are dangerous. Slimes and bats everywhere."

#. Gesprek hein_talk, Wachter Hein zegt
#: scripts/data/dialogue.gd:337
msgid "Een tip: met Shift rol je weg en kan niets je raken. En de blauwe altaren slaan je voortgang op."
msgstr "A tip: roll away with Shift, and nothing can hit you. And the blue altars save your progress."

#. Gesprek hein_done, Wachter Hein zegt
#: scripts/data/dialogue.gd:342
msgid "Het bos is veel rustiger sinds je de Slijmkoning hebt verslagen. Bedankt, held!"
msgstr "The woods are much calmer since you beat the Slime King. Thanks, hero!"

#. Naam van wie er praat (Gesprek anja_talk)
#. Naam van wie er praat (Gesprek anja_done)
#. Naam van personage anja (boven zijn hoofd)
#: scripts/data/dialogue.gd:345 scripts/data/dialogue.gd:352 scripts/data/npcs.gd:65
msgid "Anja"
msgstr "Anja"

#. Gesprek anja_talk, Anja zegt
#: scripts/data/dialogue.gd:347
msgid "De Blauwe Kaart is al duizend jaar oud. Mijn oma zei altijd dat hij het land beschermt."
msgstr "The Blue Map is a thousand years old. My grandma always said it protects the land."

#. Gesprek anja_talk, Anja zegt
#: scripts/data/dialogue.gd:348
msgid "Als die kaart echt breekt, wordt Azura weer wild. Gelukkig heb jij nu die opdracht!"
msgstr "If that map really breaks, Azura will go wild again. Good thing you're on the job now!"

#. Gesprek anja_done, Anja zegt
#: scripts/data/dialogue.gd:353
msgid "Heb je het gehoord? De Blauwe Kaart straalt weer helderblauw! Alles dankzij jou."
msgstr "Did you hear? The Blue Map is glowing bright blue again! All thanks to you."

#. Naam van wie er praat (Gesprek joost_done)
#. Naam van wie er praat (Gesprek joost_talk)
#. Naam van wie er praat (Gesprek joost_key)
#. Naam van personage joost (boven zijn hoofd)
#: scripts/data/dialogue.gd:356 scripts/data/dialogue.gd:360 scripts/data/dialogue.gd:367 scripts/data/npcs.gd:72
msgid "Joost"
msgstr "Joost"

#. Gesprek joost_done, Joost zegt
#: scripts/data/dialogue.gd:357
msgid "De slijmen zijn rustiger nu de kaart weer heel is. Ik gaf er een een appel. Hij at hem op. Het was raar."
msgstr "The slimes are calmer now that the map is whole again. I gave one an apple. It ate it. That was weird."

#. Gesprek joost_talk, Joost zegt
#: scripts/data/dialogue.gd:362
msgid "De Vergeten Ruïne is dichtgemetseld met een poortje. Je hebt de sleutel nodig."
msgstr "The Forgotten Ruins are locked up behind a little gate. You need the key."

#. Gesprek joost_talk, Joost zegt
#: scripts/data/dialogue.gd:363
msgid "Ik hoorde dat er ergens in het bos een kist ligt, bewaakt door slijmen. Misschien zit daar iets in..."
msgstr "I heard there's a chest somewhere in the woods, guarded by slimes. Maybe there's something inside..."

#. Gesprek joost_key, Joost zegt
#: scripts/data/dialogue.gd:368
msgid "Is dat een sleutel? Dan weet je wat je moet doen: naar het poortje van de ruïne, in het noordoosten van het bos!"
msgstr "Is that a key? Then you know what to do: go to the gate of the ruins, in the northeast of the woods!"

#. Naam van wie er praat (Gesprek wilfred_intro)
#. Naam van wie er praat (Gesprek wilfred_ok)
#. Naam van wie er praat (Gesprek wilfred_progress)
#. Naam van wie er praat (Gesprek wilfred_return)
#. Naam van wie er praat (Gesprek wilfred_done)
#. Naam van personage wilfred (boven zijn hoofd)
#: scripts/data/dialogue.gd:373 scripts/data/dialogue.gd:384 scripts/data/dialogue.gd:388 scripts/data/dialogue.gd:392
msgid "Wilfred"
msgstr "Wilfred"

#. Gesprek wilfred_intro, Wilfred zegt
#: scripts/data/dialogue.gd:375
msgid "Ooooh... een levende! Wees niet bang, ik bijt niet. Ik ben Wilfred."
msgstr "Ooooh... someone alive! Don't be scared, I don't bite. I'm Wilfred."

#. Gesprek wilfred_intro, Wilfred zegt
#: scripts/data/dialogue.gd:376
msgid "Ik was hier bewaker. Mijn medaillon ligt in de Echo-grot, maar ik weet niet meer waarom ik bleef. Het reliëf in de westelijke zaal en het boek in de zuidoostelijke kamer kunnen het vertellen."
msgstr "I was a guard here. My medallion is in the Echo Cave, but I cannot remember why I stayed. The relief in the western hall and the book in the southeast room may tell us."

#. Gesprek wilfred_intro: keuze van de speler
#: scripts/data/dialogue.gd:379
msgid "Ik breng het terug."
msgstr "I'll bring it back."

#. Gesprek wilfred_intro: keuze van de speler
#: scripts/data/dialogue.gd:380
msgid "Sorry, geen tijd."
msgstr "Sorry, no time."

#. Gesprek wilfred_ok, Wilfred zegt
#: scripts/data/dialogue.gd:385
msgid "Wat aardig van je. Het is een zilveren medaillon met mijn naam erin."
msgstr "How kind of you. It's a silver medallion with my name inside."

#. Gesprek wilfred_progress, Wilfred zegt
#: scripts/data/dialogue.gd:389
msgid "Zoek je mijn medaillon nog? Het ligt in de Echo-grot, ergens diep onder de grond."
msgstr "Still looking for my medallion? It's in the Echo Cave, somewhere deep underground."

#. Gesprek wilfred_return, Wilfred zegt
#: scripts/data/dialogue.gd:394
msgid "Mijn medaillon! Na al die jaren!"
msgstr "My medallion! After all these years!"

#. Gesprek wilfred_return, Wilfred zegt
#: scripts/data/dialogue.gd:395
msgid "Neem deze kristalscherven als dank. Ze zijn van een kaartkristal dat hier ooit brak."
msgstr "Take these Crystal Shards as thanks. They come from a map crystal that broke here long ago."

#. Gesprek wilfred_done, Wilfred zegt
#: scripts/data/dialogue.gd:401
msgid "Nu kan ik eindelijk rusten. Dank je, vriend."
msgstr "Now I can finally rest. Thank you, friend."

#. Naam van wie er praat (Gesprek king_intro)
#. Naam van vijand king
#: scripts/data/dialogue.gd:406 scripts/data/enemies.gd:62
msgid "De Slijmkoning"
msgstr "The Slime King"

#. Gesprek king_intro, De Slijmkoning zegt
#: scripts/data/dialogue.gd:408
msgid "Blub... blub blub..."
msgstr "Bloop... bloop bloop..."

#. Gesprek king_intro, De Slijmkoning zegt
#: scripts/data/dialogue.gd:409
msgid "WIE DURFT MIJN TEMPEL BINNEN TE KOMEN?!"
msgstr "WHO DARES TO ENTER MY TEMPLE?!"

#. Gesprek king_intro, De Slijmkoning zegt
#: scripts/data/dialogue.gd:410
msgid "De kaart is van MIJ! Ik zal je tot gel verwerken!"
msgstr "The map is MINE! I'll squish you into goo!"

#. Gesprek king_intro, De Slijmkoning zegt
#: scripts/data/dialogue.gd:411
msgid "Zie je die ring op de vloer? Daar land ik. Blijf vooral staan, als je durft!"
msgstr "See that ring on the floor? That's where I land. Stay right there, if you dare!"

#. Naam van wie er praat (Gesprek rg_ise)
#. Naam van personage rg_ise (boven zijn hoofd)
#: scripts/data/ext/coastal_region.gd:8 scripts/data/ext/coastal_region.gd:12
msgid "Ise de veervrouw"
msgstr "Ise the ferry keeper"

#. Gesprek rg_ise, Ise de veervrouw zegt
#: scripts/data/ext/coastal_region.gd:12
msgid "Ik houd de overtochten kort. De veer vaart naar de Blauwe Kust, Meeuweneiland en de Getijdenbaai, ook bij hoogwater."
msgstr "I keep the crossings short. The ferry sails to the Blue Coast, Gull Island and Tidal Cove, even at high tide."

#. Gesprek rg_ise, Ise de veervrouw zegt
#: scripts/data/ext/coastal_region.gd:12
msgid "Liever wandelen? Achter de kade loopt een vrij hoog pad naar Lichtkaap. Over de westelijke rivierbrug kom je terug aan de Blauwe Kust."
msgstr "Prefer to walk? An open high path behind the quay leads to Light Cape. The western river bridge takes you back to the Blue Coast."

#. Gesprek rg_ise: keuze van de speler
#: scripts/data/ext/coastal_region.gd:12
msgid "Bekijk de veerbestemmingen."
msgstr "Show the ferry destinations."

#. Gesprek rg_ise: keuze van de speler
#: scripts/data/ext/coastal_region.gd:12
msgid "Ik loop zelf verder."
msgstr "I'll keep walking."

#. Naam van wie er praat (Gesprek rg_raf)
#. Naam van personage rg_raf (boven zijn hoofd)
#: scripts/data/ext/coastal_region.gd:9 scripts/data/ext/coastal_region.gd:13
msgid "Raf de nettenmaker"
msgstr "Raf the net maker"

#. Gesprek rg_raf, Raf de nettenmaker zegt
#: scripts/data/ext/coastal_region.gd:13
msgid "Ik knoop mijn netten hier, uit de loop. De weidse riviermonding ligt achter de westelijke brug; de vuurtoren staat op de oostelijke kaap."
msgstr "I knot my nets here, out of the way. The wide estuary lies beyond the western bridge; the lighthouse stands on the eastern cape."

#. Gesprek rg_raf, Raf de nettenmaker zegt
#: scripts/data/ext/coastal_region.gd:13
msgid "Ik teken de paden en veerroutes op dezelfde kaart. De hoge loopbruggen blijven bij hoogwater vrij, zodat iedereen weer naar huis kan."
msgstr "I draw the paths and ferry routes on the same map. The high boardwalks stay clear at high tide, so everyone can get home."

#. Gesprek rg_raf: keuze van de speler
#: scripts/data/ext/coastal_region.gd:13
msgid "Laat de regiokaart zien."
msgstr "Show the regional map."

#. Gesprek rg_raf: keuze van de speler
#: scripts/data/ext/coastal_region.gd:13
msgid "Ik kijk rustig rond."
msgstr "I'll look around for a while."

#. Naam van wie er praat (Gesprek ce_sail_island)
#. Naam van wie er praat (Gesprek ce_sail_coast)
#: scripts/ui/coast_voyage.gd:57 scripts/data/ext/coast.gd:10 scripts/data/ext/coast.gd:11
msgid "Veerboot"
msgstr "Ferry"

#. Gesprek ce_sail_island, Veerboot zegt
#: scripts/data/ext/coast.gd:10
msgid "De riviermonding komt hier uit op de Blauwe Kust. De kleine veerboot ligt klaar voor Meeuweneiland."
msgstr "The river reaches the sea here on the Blue Coast. The small ferry is ready for Gull Island."

#. Gesprek ce_sail_island, Veerboot zegt
#: scripts/data/ext/coast.gd:10
msgid "De overtocht is gratis. Op het eiland ligt dezelfde boot klaar voor de terugvaart."
msgstr "The crossing is free. The same boat waits on the island for the return trip."

#. Gesprek ce_sail_island: keuze van de speler
#: scripts/data/ext/coast.gd:10
msgid "Vaar naar Meeuweneiland."
msgstr "Sail to Gull Island."

#. Gesprek ce_sail_island: keuze van de speler
#: scripts/data/ext/coast.gd:10
msgid "Blijf op de kust."
msgstr "Stay on the coast."

#. Gesprek ce_sail_coast, Veerboot zegt
#: scripts/data/ext/coast.gd:11
msgid "De veerboot brengt je terug naar de Blauwe Kust. Vanaf daar volg je het westelijke pad naar het Zilvermeer."
msgstr "The ferry takes you back to the Blue Coast. From there, follow the western path to Silver Lake."

#. Gesprek ce_sail_coast, Veerboot zegt
#: scripts/data/ext/coast.gd:11
msgid "De overtocht is gratis; je spullen en gezondheid blijven zoals ze zijn."
msgstr "The crossing is free; your belongings and health stay as they are."

#. Gesprek ce_sail_coast: keuze van de speler
#: scripts/data/ext/coast.gd:11
msgid "Vaar terug naar de kust."
msgstr "Sail back to the coast."

#. Gesprek ce_sail_coast: keuze van de speler
#: scripts/data/ext/coast.gd:11
msgid "Blijf op het eiland."
msgstr "Stay on the island."

#. Gesprek ra_spring, De oude bron zegt
#: scripts/data/ext/regional.gd:54
msgid "De bron is vrij. De oase krijgt altijd water; kies waar het overschot stroomt. Je kunt later hier terugkomen om de aftakking te veranderen."
msgstr "The spring is clear. The oasis always gets water; choose where the surplus flows. You can come back here later to change the branch."

#. Gesprek ra_spring: keuze van de speler
#: scripts/data/ext/regional.gd:58
msgid "Maak een drinkplaats voor het wild."
msgstr "Make a watering hole for wildlife."

#. Gesprek ra_spring: keuze van de speler
#: scripts/data/ext/regional.gd:67
msgid "Vul de rustplaats voor reizigers."
msgstr "Fill the travelers' rest stop."

#. Gesprek ra_spring: keuze van de speler
#: scripts/data/ext/regional.gd:76
msgid "Ik kijk nog even rond."
msgstr "I'll look around a little more."

#. Gesprek ra_order, De leestafel zegt
#: scripts/data/ext/regional.gd:83
msgid "Welke geschiedenis vertellen de reliëfs? Let op de huizen, de aanlegpalen en de hoogte van het water."
msgstr "What history do the reliefs reveal? Look at the houses, the mooring posts and the water level."

#. Gesprek ra_order: keuze van de speler
#: scripts/data/ext/regional.gd:87
msgid "Rietvelden → aanlegplaats → hoogwater."
msgstr "Reed beds → landing → flood."

#. Gesprek ra_order: keuze van de speler
#: scripts/data/ext/regional.gd:97
msgid "Hoogwater → rietvelden → aanlegplaats."
msgstr "Flood → reed beds → landing."

#. Gesprek ra_order: keuze van de speler
#: scripts/data/ext/regional.gd:106
msgid "Aanlegplaats → hoogwater → rietvelden."
msgstr "Landing → flood → reed beds."

#. Gesprek ra_order: keuze van de speler
#: scripts/data/ext/regional.gd:115
msgid "Ik bekijk de reliëfs opnieuw."
msgstr "I'll examine the reliefs again."

#. Naam van wie er praat (Gesprek ra_exhibit)
#: scripts/data/ext/regional.gd:120
msgid "Het verhaal van het moeras"
msgstr "The story of the marsh"

#. Gesprek ra_exhibit, Het verhaal van het moeras zegt
#: scripts/data/ext/regional.gd:122
msgid "Eerst leefden de bewoners tussen het riet. Daarna bouwden ze een aanlegplaats. Het hoge water verdreef hen naar het eiland. Hun kennis kan nu weer worden gedeeld."
msgstr "First the residents lived among the reeds. Then they built a landing. The flood drove them to the island. Their knowledge can now be shared again."

#. Gesprek ra_exhibit, Het verhaal van het moeras zegt
#: scripts/data/ext/regional.gd:123
msgid "Wat laat je bij Mees zien? Beide keuzes houden alle routes en beloningen beschikbaar. Je kunt de tentoonstelling later veranderen."
msgstr "What will you show at Mees'? Both choices keep all routes and rewards available. You can change the exhibition later."

#. Gesprek ra_exhibit: keuze van de speler
#: scripts/data/ext/regional.gd:127
msgid "Toon de oude vluchtroutes."
msgstr "Show the old escape routes."

#. Gesprek ra_exhibit: keuze van de speler
#: scripts/data/ext/regional.gd:136
msgid "Toon verhalen van de bewoners."
msgstr "Show stories of the residents."

#. Gesprek ra_exhibit: keuze van de speler
#: scripts/data/ext/regional.gd:145
msgid "Laat de tentoonstelling zo."
msgstr "Leave the exhibition as it is."

#. Naam van wie er praat (Gesprek ra_sana_done)
#. Naam van wie er praat (Gesprek sana_intro)
#. Naam van wie er praat (Gesprek sana_vraag)
#. Naam van wie er praat (Gesprek sana_ok)
#. Naam van wie er praat (Gesprek sana_menu)
#. Naam van wie er praat (Gesprek sana_klaar)
#: scripts/data/ext/dorst.gd:166 scripts/data/ext/dorst.gd:172 scripts/data/ext/dorst.gd:193 scripts/data/ext/dorst.gd:205
msgid "Sana"
msgstr "Sana"

#. Gesprek ra_sana_done, Sana zegt
#: scripts/data/ext/regional.gd:152
msgid "De bron voedt de oase weer. Het extra water gaat naar jouw gekozen plek: de drinkplaats ten oosten van mij of de rustplaats naast Jelles huis."
msgstr "The spring feeds the oasis again. The surplus goes to your chosen place: the watering hole east of me or the rest stop beside Jelle's house."

#. Gesprek ra_sana_done, Sana zegt
#: scripts/data/ext/regional.gd:153
msgid "De bron blijft bereikbaar. Daar kun je de aftakking veranderen; bij mijn blauwe waterpunt kun je altijd je waterzak vullen."
msgstr "The spring remains accessible. You can change the branch there; you can always fill your waterskin at my blue water station."

#. Gesprek ls_after, Mila zegt
#: scripts/data/ext/lake_supper.gd:16
msgid "Jouw gerecht staat op de kaart! Kom gerust koken of praat met de gasten aan de dorpstafel. Er is altijd een plek vrij."
msgstr "Your dish is on the menu! Come and cook, or chat with the guests at the village table. There is always a seat for you."

#. Gesprek ls_ready, Mila zegt
#: scripts/data/ext/lake_supper.gd:17
msgid "De vangst is gered. Bij het fornuis rechts kies je tussen stevige stoof en lichte bouillon. Kook twee porties en deel er één aan de grote tafel."
msgstr "The catch is safe. At the stove on the right, choose a hearty stew or a light broth. Cook two portions and share one at the big table."

#. Gesprek ls_start, Mila zegt
#: scripts/data/ext/lake_supper.gd:18
msgid "Joris brengt vis, Bo brengt brood. Maar aan mijn grote tafel zitten we zelden samen. Help je de eerste maaltijd op tafel zetten?"
msgstr "Joris brings fish, Bo brings bread. But we rarely sit together at my big table. Will you help serve our first meal?"

#. Gesprek ls_start, Mila zegt
#: scripts/data/ext/lake_supper.gd:18
msgid "Zijn mand is losgeraakt bij de middelste steiger. Met een hengel haal je hem vanaf de planken binnen. Joris leent je er een. Mijn fornuis staat rechts in de herberg."
msgstr "His basket came loose by the middle pier. Use a fishing rod from the planks to reel it in. Joris will lend you one. My stove is on the right inside the inn."

#. Naam van wie er praat (Gesprek ls_net)
#: scripts/entities/supper_object.gd:44 scripts/data/ext/lake_supper.gd:19
msgid "Joris' nettenrek"
msgstr "Joris’ net rack"

#. Gesprek ls_net, Joris' nettenrek zegt
#: scripts/data/ext/lake_supper.gd:19
msgid "Volg de gekleurde draad: boven, onder, boven. Steek {ls_stitch} van 3."
msgstr "Follow the coloured thread: over, under, over. Stitch {ls_stitch} of 3."

#. Gesprek ls_net: keuze van de speler
#: scripts/data/ext/lake_supper.gd:20
msgid "Haal de draad bovenlangs."
msgstr "Pass the thread over."

#. Gesprek ls_net: keuze van de speler
#: scripts/data/ext/lake_supper.gd:21
msgid "Haal de draad onderlangs."
msgstr "Pass the thread under."

#. Gesprek ls_net: keuze van de speler
#: scripts/data/ext/lake_supper.gd:22
msgid "Laat het net even liggen."
msgstr "Leave the net for now."

#. Gesprek ls_net_done, Visser Joris zegt
#: scripts/data/ext/lake_supper.gd:24
msgid "Dat houdt! Mijn reservevangst is voor jou: twee baarzen en wat zilverkruid. Daarmee kun je later weer bij Mila koken."
msgstr "That will hold! My spare catch is yours: two perch and some silverleaf. You can use them to cook at Mila’s again."

#. Naam van wie er praat (Gesprek ls_share)
#: scripts/data/ext/lake_supper.gd:25
msgid "De dorpsmaaltijd"
msgstr "The village meal"

#. Gesprek ls_share, De dorpsmaaltijd zegt
#: scripts/data/ext/lake_supper.gd:25
msgid "Bo heeft brood gebracht. Zet één portie neer; Mila maakt er een maaltijd voor de tafel van. Je overige porties blijven in je tas."
msgstr "Bo has brought bread. Put down one portion; Mila will turn it into a meal for the table. Your other portions stay in your bag."

#. Gesprek ls_share: keuze van de speler
#: scripts/data/ext/lake_supper.gd:26
msgid "Deel Zilvermeerstoof."
msgstr "Share Silverlake stew."

#. Gesprek ls_share: keuze van de speler
#: scripts/data/ext/lake_supper.gd:27
msgid "Deel Oeverbouillon."
msgstr "Share Lakeside broth."

#. Naam van wie er praat (Gesprek tessa_nobow)
#. Naam van wie er praat (Gesprek tessa_intro)
#. Naam van wie er praat (Gesprek tessa_menu)
#. Naam van wie er praat (Gesprek tessa_go)
#. Naam van wie er praat (Gesprek tessa_howto)
#. Naam van wie er praat (Gesprek tessa_active)
#: scripts/data/ext/boog.gd:77 scripts/data/ext/boog.gd:85 scripts/data/ext/boog.gd:94 scripts/data/ext/boog.gd:114
msgid "Tessa"
msgstr "Tessa"

#. Gesprek tessa_nobow, Tessa zegt
#: scripts/data/ext/boog.gd:79
msgid "Hoi! Ik ben Tessa. Dit is mijn schietbaan."
msgstr "Hi! I'm Tessa. This is my shooting range."

#. Gesprek tessa_nobow, Tessa zegt
#: scripts/data/ext/boog.gd:80
msgid "Zonder boog kun je hier niets doen, hoor. Tobias verkoopt ze in zijn winkel."
msgstr "You can't do much here without a bow, though. Tobias sells them in his shop."

#. Gesprek tessa_nobow, Tessa zegt
#: scripts/data/ext/boog.gd:81
msgid "Kom terug als je er een hebt. Dan leer ik je schieten!"
msgstr "Come back when you have one. Then I'll teach you how to shoot!"

#. Gesprek tessa_intro, Tessa zegt
#: scripts/data/ext/boog.gd:87
msgid "Hé, een boog! Kom maar hier."
msgstr "Hey, a bow! Come on over."

#. Gesprek tessa_intro, Tessa zegt
#: scripts/data/ext/boog.gd:88
msgid "Ik ben Tessa. Wachter Hein vindt het goed dat ik mijn schietbaan hier neerzet, vlak bij zijn post."
msgstr "I'm Tessa. Guard Hein lets me keep my shooting range here, right next to his post."

#. Gesprek tessa_intro, Tessa zegt
#: scripts/data/ext/boog.gd:89
msgid "Zie je die drie doelwitten? Raak ze alle drie binnen 20 seconden, dan krijg je een beloning."
msgstr "See those three targets? Hit all three within 20 seconds and you'll get a reward."

#. Gesprek tessa_menu, Tessa zegt
#: scripts/data/ext/boog.gd:95
msgid "Zullen we schieten?"
msgstr "Ready to shoot?"

#. Gesprek tessa_menu: keuze van de speler
#: scripts/data/ext/boog.gd:98
msgid "Ik doe mee!"
msgstr "I'm in!"

#. Gesprek tessa_menu: keuze van de speler
#: scripts/data/ext/boog.gd:102
msgid "Nog een poging!"
msgstr "One more try!"

#. Gesprek tessa_menu: keuze van de speler
#: scripts/data/ext/boog.gd:106
msgid "Oefenen, zonder beloning"
msgstr "Practice, no reward"

#. Gesprek tessa_menu: keuze van de speler
#: scripts/data/ext/boog.gd:109
msgid "Hoe schiet ik?"
msgstr "How do I shoot?"

#. Gesprek tessa_menu: keuze van de speler
#: scripts/data/ext/boog.gd:110
msgid "Straks misschien."
msgstr "Maybe later."

#. Gesprek tessa_go, Tessa zegt
#: scripts/data/ext/boog.gd:116
msgid "Ga op de planken van de schietlijn staan. Van daar zie je alle drie de doelwitten."
msgstr "Stand on the planks at the shooting line. From there you can see all three targets."

#. Gesprek tessa_go, Tessa zegt
#: scripts/data/ext/boog.gd:117
msgid "Ik tel af: 3, 2, 1... Bij \"Af!\" begint de tijd."
msgstr "I'll count down: 3, 2, 1... The clock starts at \"Go!\""

#. Gesprek tessa_go, Tessa zegt
#: scripts/data/ext/boog.gd:118
msgid "Tijdens een poging schiet je met mijn pijlen. Dat kost jou dus niks. Succes!"
msgstr "During a try, you shoot with my arrows. So it costs you nothing. Good luck!"

#. Gesprek tessa_howto, Tessa zegt
#: scripts/data/ext/boog.gd:124
msgid "Druk op F om een pijl te schieten. Je schiet de kant op waarin je kijkt."
msgstr "Press F to shoot an arrow. You shoot in the direction you're facing."

#. Gesprek tessa_howto, Tessa zegt
#: scripts/data/ext/boog.gd:125
msgid "Loop je schuin? Dan vliegt je pijl ook schuin. Muren stoppen een pijl, maar over water vliegt hij gewoon heen."
msgstr "Walking diagonally? Then your arrow flies diagonally too. Walls stop arrows, but they fly right over water."

#. Gesprek tessa_howto, Tessa zegt
#: scripts/data/ext/boog.gd:126
msgid "Elk schot kost een pijl uit je pijlenkoker. Je kunt er 40 dragen. Hier op mijn baan leen je mijn pijlen."
msgstr "Every shot uses one arrow from your quiver. You can carry 40. Here on my range, you borrow my arrows."

#. Gesprek tessa_active, Tessa zegt
#: scripts/data/ext/boog.gd:132
msgid "Het is je nog niet gelukt, hè? Geen zorgen. Iedereen mist wel eens."
msgstr "Haven't done it yet, huh? Don't worry. Everybody misses sometimes."

#. Gesprek tessa_done, Tessa zegt
#: scripts/data/ext/boog.gd:138
msgid "Daar is mijn beste schutter! De baan is altijd open."
msgstr "There's my best archer! The range is always open."

#. Gesprek tessa_done, Tessa zegt
#: scripts/data/ext/boog.gd:139
msgid "Een beloning krijg je maar één keer, maar oefenen mag zo vaak je wilt."
msgstr "You only get the reward once, but you can practice as often as you like."

#. Gesprek tessa_reward, Tessa zegt
#: scripts/data/ext/boog.gd:145
msgid "Alle drie raak! En nog binnen de tijd ook!"
msgstr "All three hit! And in time, too!"

#. Gesprek tessa_reward_pay, Tessa zegt
#: scripts/data/ext/boog.gd:154
msgid "Hier is je beloning: 25 munten en 10 pijlen. Goed geschoten!"
msgstr "Here's your reward: 25 coins and 10 arrows. Nice shooting!"

#. Gesprek tessa_reward_full, Tessa zegt
#: scripts/data/ext/boog.gd:160
msgid "Maar je pijlenkoker zit bijna vol. Mijn beloning past er dan niet meer in!"
msgstr "But your quiver is almost full. My reward won't fit in it!"

#. Gesprek tessa_reward_full, Tessa zegt
#: scripts/data/ext/boog.gd:161
msgid "Schiet eerst een paar pijlen af en kom dan terug."
msgstr "Shoot a few arrows first, then come back."

#. Gesprek meer_joris_intro, Visser Joris zegt
#: scripts/data/ext/meer.gd:161
msgid "Hmpf. Een bezoeker. Ik dacht dat de vissen het ergste waren, maar nee: mensen."
msgstr "Hmph. A visitor. I thought fish were the worst, but no: people."

#. Gesprek meer_joris_intro, Visser Joris zegt
#: scripts/data/ext/meer.gd:162
msgid "...Grapje. Ik ben Joris, visser van het Zilvermeer. Al veertig jaar. Ik heb meer vissen gezien dan jij haren hebt."
msgstr "...Just kidding. I'm Joris, fisher of Silver Lake. For forty years now. I've seen more fish than you have hairs on your head."

#. Gesprek meer_joris_intro, Visser Joris zegt
#: scripts/data/ext/meer.gd:163
msgid "Je staat naar mijn hengel te kijken. Je wilt vissen, hè? Ik zie het aan je ogen. Ze glimmen als een baars."
msgstr "You're staring at my fishing rod. You want to fish, huh? I can see it in your eyes. They're shining like a perch."

#. Gesprek meer_joris_hengel, Visser Joris zegt
#: scripts/data/ext/meer.gd:171
msgid "Hier, neem mijn reservehengel. Gratis. Maar behandel hem lief."
msgstr "Here, take my spare fishing rod. Free. But be nice to it."

#. Gesprek meer_joris_hengel, Visser Joris zegt
#: scripts/data/ext/meer.gd:172
msgid "Je vist bij een visplek: dat zijn de kringetjes in het water. Ga ernaast staan en druk op E. Wacht dan op een beet, en wees snel!"
msgstr "You fish at a fishing spot: those are the little ripples in the water. Stand next to one and press E. Then wait for a bite, and be quick!"

#. Gesprek meer_joris_menu, Visser Joris zegt
#: scripts/data/ext/meer.gd:179
msgid "Nou? Wat kan ik voor je doen?"
msgstr "Well? What can I do for you?"

#. Gesprek meer_joris_menu: keuze van de speler
#: scripts/data/ext/meer.gd:181
msgid "Verkoop al mijn vis ({visgeld} munten)"
msgstr "Sell all my fish ({visgeld} coins)"

#. Gesprek meer_joris_menu: keuze van de speler
#: scripts/data/ext/meer.gd:183
msgid "Hoe is het met de Gouden Karper?"
msgstr "Any news on the Golden Carp?"

#. Gesprek meer_joris_menu: keuze van de speler
#: scripts/data/ext/meer.gd:184
msgid "Heb je tips over vissen?"
msgstr "Got any fishing tips?"

#. Gesprek meer_joris_menu: keuze van de speler
#: scripts/data/ext/meer.gd:185
msgid "Hoe gaat het nu de Slijmkoning weg is?"
msgstr "How are things now that the Slime King is gone?"

#. Gesprek meer_joris_menu: keuze van de speler
#: scripts/data/ext/meer.gd:186
msgid "Waar is de mand voor Mila?"
msgstr "Where is the basket for Mila?"

#. Gesprek meer_joris_na, Visser Joris zegt
#: scripts/data/ext/meer.gd:193
msgid "De Slijmkoning is weg? Dat wist ik al. De vissen bijten weer als vanouds. Alleen die slijmen aan de overkant blijven brutaal."
msgstr "The Slime King is gone? I knew that already. The fish are biting like in the good old days. Only those slimes across the water are still cheeky."

#. Gesprek meer_joris_na, Visser Joris zegt
#: scripts/data/ext/meer.gd:194
msgid "Ze eten nog steeds mijn aas. Maar ik begin ze bijna aardig te vinden. Vertel het niet door, ik heb een reputatie."
msgstr "They still eat my bait. But I'm almost starting to like them. Don't tell anyone, I have a reputation."

#. Gesprek meer_joris_verkoop, Visser Joris zegt
#: scripts/data/ext/meer.gd:200
msgid "Laat maar zien... Hm. Hm-hm. Die zijn goed. Ik geef er een eerlijke prijs voor."
msgstr "Let's have a look... Hm. Hm-hm. These are good. I'll give you a fair price."

#. Gesprek meer_joris_verkocht, Visser Joris zegt
#: scripts/data/ext/meer.gd:210
msgid "Zo. Eerlijk zaken doen, dat vind ik prettig. Kom maar terug als je meer hebt."
msgstr "There. I like an honest deal. Come back when you have more."

#. Gesprek meer_joris_vol, Visser Joris zegt
#: scripts/data/ext/meer.gd:215
msgid "Pfff. Het hele dorp zit vol met vis. Ik heb vis in de kast, vis in de la en vis in mijn laarzen."
msgstr "Phew. The whole village is full of fish. I've got fish in the cupboard, fish in the drawer and fish in my boots."

#. Gesprek meer_joris_vol, Visser Joris zegt
#: scripts/data/ext/meer.gd:216
msgid "Vanaf nu betaal ik maar de helft. Dat is niet persoonlijk, hoor. Zo werkt de vismarkt."
msgstr "From now on I only pay half. Nothing personal. That's just how the fish market works."

#. Gesprek meer_joris_vol_kort, Visser Joris zegt
#: scripts/data/ext/meer.gd:222
msgid "Hmpf. Het dorp zit nog steeds vol met vis. Ik betaal de helft, weet je nog?"
msgstr "Hmph. The village is still full of fish. I pay half, remember?"

#. Gesprek meer_joris_tips, Visser Joris zegt
#: scripts/data/ext/meer.gd:226
msgid "Tips? Ik heb alleen maar tips. Wat wil je weten?"
msgstr "Tips? I'm full of tips. What do you want to know?"

#. Gesprek meer_joris_tips: keuze van de speler
#: scripts/data/ext/meer.gd:228
msgid "Hoe vang ik een vis?"
msgstr "How do I catch a fish?"

#. Gesprek meer_joris_tips: keuze van de speler
#: scripts/data/ext/meer.gd:229
msgid "Waar zitten de grote vissen?"
msgstr "Where are the big fish?"

#. Gesprek meer_joris_tips: keuze van de speler
#: scripts/data/ext/meer.gd:230
msgid "Wat doe ik met mijn vis?"
msgstr "What do I do with my fish?"

#. Gesprek meer_joris_tips: keuze van de speler
#: scripts/data/ext/meer.gd:231
msgid "Dank je, genoeg."
msgstr "Thanks, that's all."

#. Gesprek meer_joris_tip_vangen, Visser Joris zegt
#: scripts/data/ext/meer.gd:237
msgid "Gooi uit bij een visplek. Wacht tot de dobber zakt en er een uitroepteken verschijnt. Druk dan snel op E!"
msgstr "Cast your line at a fishing spot. Wait until the bobber sinks and an exclamation mark appears. Then press E, quick!"

#. Gesprek meer_joris_tip_vangen, Visser Joris zegt
#: scripts/data/ext/meer.gd:238
msgid "Houd daarna E ingedrukt: dan stijgt de groene zone. Laat los, dan zakt hij. Houd de vis in het groen tot de balk vol is."
msgstr "Then hold E: the green zone goes up. Let go, and it goes down. Keep the fish in the green until the bar is full."

#. Gesprek meer_joris_tip_diep, Visser Joris zegt
#: scripts/data/ext/meer.gd:245
msgid "In diep water. Aan het eind van de verre steiger, helemaal aan de oostkant van het meer."
msgstr "In deep water. At the end of the far dock, all the way on the east side of the lake."

#. Gesprek meer_joris_tip_diep, Visser Joris zegt
#: scripts/data/ext/meer.gd:246
msgid "Daar zwemt de grootste vis van het meer. Ik heb hem één keer gezien. En nul keer gevangen."
msgstr "That's where the biggest fish in the lake swims. I've seen him once. And caught him zero times."

#. Gesprek meer_joris_tip_verkopen, Visser Joris zegt
#: scripts/data/ext/meer.gd:253
msgid "Verkopen, natuurlijk! Aan mij, of aan Mila in de herberg. Zij maakt er soep van."
msgstr "Sell it, of course! To me, or to Mila at the inn. She makes soup out of it."

#. Gesprek meer_joris_tip_verkopen, Visser Joris zegt
#: scripts/data/ext/meer.gd:254
msgid "Maar pas op: als het dorp te veel vis heeft, gaat de prijs omlaag. Dat gaat zo met vis. Ook met mensen, trouwens."
msgstr "But watch out: if the village has too much fish, the price goes down. That's how it goes with fish. And with people, come to think of it."

#. Gesprek meer_joris_karper_vraag, Visser Joris zegt
#: scripts/data/ext/meer.gd:261
msgid "Werk? Hmpf. Ja, eigenlijk wel. Maar je gaat me uitlachen."
msgstr "Work? Hmph. Yes, actually. But you're going to laugh at me."

#. Gesprek meer_joris_karper_vraag, Visser Joris zegt
#: scripts/data/ext/meer.gd:262
msgid "Ik droom al jaren van de Gouden Karper. Een vis van puur goud. Grote ogen, glimmende schubben, veel te slim."
msgstr "For years I've dreamed of the Golden Carp. A fish of pure gold. Big eyes, shiny scales, way too smart."

#. Gesprek meer_joris_karper_vraag, Visser Joris zegt
#: scripts/data/ext/meer.gd:263
msgid "Ik heb hem één keer gezien, vanaf de verre steiger. Hij zwom langs, keek me aan en... lachte. Echt waar."
msgstr "I saw him once, from the far dock. He swam by, looked at me and... laughed. I'm serious."

#. Gesprek meer_joris_karper_vraag, Visser Joris zegt
#: scripts/data/ext/meer.gd:264
msgid "Vang hem voor me. Dan weet ik tenminste dat hij echt bestaat."
msgstr "Catch him for me. Then at least I'll know he's real."

#. Gesprek meer_joris_karper_vraag: keuze van de speler
#: scripts/data/ext/meer.gd:267
msgid "Ik ga hem vangen!"
msgstr "I'll catch him!"

#. Gesprek meer_joris_karper_ok, Visser Joris zegt
#: scripts/data/ext/meer.gd:274
msgid "Echt? Goed zo. Probeer het in diep water, aan het eind van de verre steiger. Hij is niet gek: een gewone plek haalt hem niet."
msgstr "Really? Good for you. Try deep water, at the end of the far dock. He's no fool: an ordinary spot won't catch him."

#. Gesprek meer_joris_karper_ok, Visser Joris zegt
#: scripts/data/ext/meer.gd:275
msgid "En geduld, hè. Veel geduld. Vissen is vooral wachten. En mopperen."
msgstr "And be patient, okay? Very patient. Fishing is mostly waiting. And grumbling."

#. Gesprek meer_joris_karper_voortgang, Visser Joris zegt
#: scripts/data/ext/meer.gd:282
msgid "Nog geen gouden vis? Diep water, aan het eind van de verre steiger. Hij laat zich niet zomaar zien."
msgstr "No golden fish yet? Deep water, at the end of the far dock. He doesn't show himself to just anyone."

#. Gesprek meer_joris_karper_voortgang, Visser Joris zegt
#: scripts/data/ext/meer.gd:283
msgid "Hoe vaker je het probeert, hoe nieuwsgieriger hij wordt. Dat zeg ik tenminste tegen mezelf."
msgstr "The more you try, the more curious he gets. At least, that's what I tell myself."

#. Gesprek meer_joris_karper_direct, Visser Joris zegt
#: scripts/data/ext/meer.gd:289
msgid "Wat heb je daar in je tas? Is dat... Nee. Dat kan niet."
msgstr "What's that in your bag? Is that... No. It can't be."

#. Gesprek meer_joris_karper_direct, Visser Joris zegt
#: scripts/data/ext/meer.gd:290
msgid "Je hebt hem gewoon gevangen, zonder dat ik het je vroeg? Ik moet even gaan zitten."
msgstr "You just caught him, without me even asking? I need to sit down."

#. Gesprek meer_joris_karper_klaar, Visser Joris zegt
#: scripts/data/ext/meer.gd:298
msgid "De Gouden Karper! Hij glimt! Hij kijkt me aan! Hij lacht! Ik wist het!"
msgstr "The Golden Carp! He's shining! He's looking at me! He's laughing! I knew it!"

#. Gesprek meer_joris_karper_klaar, Visser Joris zegt
#: scripts/data/ext/meer.gd:299
msgid "Veertig jaar heb ik gewacht. Hier, hier, neem dit. Het is minder dan hij waard is, maar het is alles wat ik heb."
msgstr "Forty years I've waited. Here, here, take this. It's less than he's worth, but it's all I've got."

#. Gesprek meer_joris_karper_na, Visser Joris zegt
#: scripts/data/ext/meer.gd:310
msgid "Mijn Visserspet. Ik draag hem al veertig jaar. Nu is hij van jou. Ik heb er thuis nog drie, maar deze brengt geluk."
msgstr "My Fisher's Cap. I've worn it for forty years. Now it's yours. I have three more at home, but this one brings luck."

#. Gesprek meer_joris_karper_na, Visser Joris zegt
#: scripts/data/ext/meer.gd:311
msgid "En voor je vis betalen Mila en ik voortaan 10% extra. Dat heet respect."
msgstr "And from now on, Mila and I pay 10% extra for your fish. That's called respect."

#. Gesprek meer_joris_karper_na, Visser Joris zegt
#: scripts/data/ext/meer.gd:312
msgid "De Gouden Karper zet ik terug in het meer. Hij heeft het verdiend. Aan een haak hapt hij nooit meer, zo slim is hij wel. Maar soms zie je hem glinsteren."
msgstr "I'm putting the Golden Carp back in the lake. He's earned it. He'll never bite a hook again, he's way too smart for that. But sometimes you'll see him sparkle."

#. Naam van wie er praat (Gesprek meer_lena_intro)
#. Naam van wie er praat (Gesprek meer_lena_menu)
#. Naam van wie er praat (Gesprek meer_lena_over)
#. Naam van wie er praat (Gesprek meer_lena_diepte)
#. Naam van wie er praat (Gesprek meer_lena_vraag)
#. Naam van wie er praat (Gesprek meer_lena_ok)
#: scripts/data/ext/meer.gd:318 scripts/data/ext/meer.gd:328 scripts/data/ext/meer.gd:339 scripts/data/ext/meer.gd:348
msgid "Lena"
msgstr "Lena"

#. Gesprek meer_lena_intro, Lena zegt
#: scripts/data/ext/meer.gd:320
msgid "Welkom in de bibliotheek van het Zilvermeer. Ik ben Lena."
msgstr "Welcome to the Silver Lake library. I'm Lena."

#. Gesprek meer_lena_intro, Lena zegt
#: scripts/data/ext/meer.gd:321
msgid "Je mag alles lezen. Alleen niet met natte vingers. En niet hardop. En niet... ach, ik zie dat je het begrijpt."
msgstr "You may read anything. Just not with wet fingers. And not out loud. And not... oh, I can see you get it."

#. Gesprek meer_lena_intro, Lena zegt
#: scripts/data/ext/meer.gd:322
msgid "De lessenaars met een open boek erop zijn voor jou: loop erheen en druk op E. Elk boek vertelt een stukje van Azura."
msgstr "The reading stands with an open book on them are for you: walk up and press E. Each book tells a little piece of Azura's story."

#. Gesprek meer_lena_menu, Lena zegt
#: scripts/data/ext/meer.gd:329
msgid "Kan ik je ergens mee helpen?"
msgstr "Can I help you with anything?"

#. Gesprek meer_lena_menu: keuze van de speler
#: scripts/data/ext/meer.gd:332
msgid "Wat weet je over de Diepte?"
msgstr "What do you know about the Depths?"

#. Gesprek meer_lena_menu: keuze van de speler
#: scripts/data/ext/meer.gd:333
msgid "Vertel eens iets over de boeken."
msgstr "Tell me about the books."

#. Gesprek meer_lena_menu: keuze van de speler
#: scripts/data/ext/meer.gd:334
msgid "Samen een kruidendrankje bereiden."
msgstr "Prepare an herbal potion together."

#. Gesprek meer_lena_over, Lena zegt
#: scripts/data/ext/meer.gd:341
msgid "Alles wat de mensen van Azura ooit hebben opgeschreven, staat hier. Over de Blauwe Kaart, over de oude wachters, over slijmen."
msgstr "Everything the people of Azura ever wrote down is here. About the Blue Map, about the old guardians, about slimes."

#. Gesprek meer_lena_over, Lena zegt
#: scripts/data/ext/meer.gd:342
msgid "Sommige boeken zijn zo oud dat ze 'Azura' nog met een andere letter schrijven. Die laat ik liever niet los."
msgstr "Some books are so old they still spell 'Azura' with a different letter. I'd rather not let those out of my hands."

#. Gesprek meer_lena_over, Lena zegt
#: scripts/data/ext/meer.gd:343
msgid "Lees maar op de lessenaars. Daar staan de korte verhalen. De dikke boeken blijven in de kast. Die zijn zwaar."
msgstr "Just read at the reading stands. That's where the short stories are. The thick books stay on the shelves. They're heavy reading. Really heavy."

#. Gesprek meer_lena_diepte, Lena zegt
#: scripts/data/ext/meer.gd:350
msgid "De Diepte? Ik hoopte al dat je dat ging vragen. Het staat in alle boeken, maar op geen enkele bladzijde die je kunt vinden."
msgstr "The Depths? I was hoping you'd ask. It's in every book, but never on a page you can find."

#. Gesprek meer_lena_diepte, Lena zegt
#: scripts/data/ext/meer.gd:351
msgid "De Blauwe Kaart is een kopie. Het origineel, de Sterrenkaart, ligt ergens onder de Kristaltempel. Een oude Wachter bewaakt hem. Hij slaapt, maar hij slaapt licht."
msgstr "The Blue Map is a copy. The original, the Star Map, lies somewhere under the Crystal Temple. An old Guardian watches over it. He sleeps, but he's a light sleeper."

#. Gesprek meer_lena_diepte, Lena zegt
#: scripts/data/ext/meer.gd:352
msgid "De oude boeken zeggen: als de kaart weer heel is, gaat de weg naar beneden open. Of dat klopt, weet niemand. Ga je kijken? Neem dan veel drankjes mee."
msgstr "The old books say: once the map is whole again, the way down will open. Nobody knows if that's true. Going to take a look? Then bring lots of potions."

#. Gesprek meer_lena_vraag, Lena zegt
#: scripts/data/ext/meer.gd:359
msgid "Nu je het zegt... ja! Ik mis drie boeken. Ze zijn nooit teruggebracht."
msgstr "Now that you mention it... yes! Three of my books are missing. They were never returned."

#. Gesprek meer_lena_vraag, Lena zegt
#: scripts/data/ext/meer.gd:360
msgid "Eén heb ik uitgeleend aan iemand die naar het eiland in het meer ging. Hij kwam nooit terug. Het boek ook niet."
msgstr "I lent one to someone who went to the island in the lake. He never came back. Neither did the book."

#. Gesprek meer_lena_vraag, Lena zegt
#: scripts/data/ext/meer.gd:361
msgid "Eén ligt vast in het huisje van Joris. Hij gebruikte het als onderzetter en heeft het daarna ergens opgeborgen. Ik wil er niet over nadenken."
msgstr "One is probably in Joris' Cabin. He used it as a coaster and then put it away somewhere. I don't want to think about it."

#. Gesprek meer_lena_vraag, Lena zegt
#: scripts/data/ext/meer.gd:362
msgid "En eentje heeft Sanne meegenomen. Ze vindt boeken zonder plaatjes saai, maar ze neemt ze wel mee. Kinderen!"
msgstr "And Sanne took one. She thinks books without pictures are boring, but she takes them anyway. Kids!"

#. Gesprek meer_lena_vraag, Lena zegt
#: scripts/data/ext/meer.gd:363
msgid "Wil je ze voor me zoeken? Dan krijg je een beloning. En iets bijzonders, achterin."
msgstr "Will you find them for me? You'll get a reward. And something special, in the back."

#. Gesprek meer_lena_vraag: keuze van de speler
#: scripts/data/ext/meer.gd:366
msgid "Ik zoek ze wel!"
msgstr "I'll find them!"

#. Gesprek meer_lena_ok, Lena zegt
#: scripts/data/ext/meer.gd:372
msgid "Wat fijn! Eén op het eiland, één in het huisje van Joris en één bij Sanne. Je kunt ze niet missen. Nou ja, wel. Maar ze zijn er."
msgstr "Wonderful! One on the island, one in Joris' Cabin and one with Sanne. You can't miss them. Well, you can. But they're there."

#. Gesprek meer_lena_voortgang, Lena zegt
#: scripts/data/ext/meer.gd:378
msgid "Hoe gaat het met mijn boeken? Eén ligt op het eiland, één in het huisje van Joris en één is bij Sanne."
msgstr "How's the book hunt going? One is on the island, one is in Joris' Cabin and one is with Sanne."

#. Gesprek meer_lena_voortgang_0, Lena zegt
#: scripts/data/ext/meer.gd:385
msgid "Nog niets gevonden? Geen haast hoor. Boeken lopen niet weg. Nou ja, deze wel."
msgstr "Nothing yet? No rush. Books don't run away. Well, these ones did."

#. Gesprek meer_lena_voortgang_1, Lena zegt
#: scripts/data/ext/meer.gd:386
msgid "Eén boek al! Dan zijn het er nog twee. Je bent een echte boekenzoeker."
msgstr "One book already! Just two more to go. You're a real book hunter."

#. Gesprek meer_lena_voortgang_2, Lena zegt
#: scripts/data/ext/meer.gd:387
msgid "Twee boeken al! Nog eentje. Ik hoor de kasten al juichen."
msgstr "Two books already! Just one more. I can hear the shelves cheering."

#. Gesprek meer_lena_boeken_terug, Lena zegt
#: scripts/data/ext/meer.gd:391
msgid "Jij hebt ze! Alle drie! Laat eens kijken..."
msgstr "You found them! All three! Let me see..."

#. Gesprek meer_lena_boeken_terug, Lena zegt
#: scripts/data/ext/meer.gd:392
msgid "'Sagen van het Zilvermeer', nog droog. 'Het Grote Vissenboek', met een koffiekring. En 'Sterren boven Azura'... met kleurpotloodvlekken."
msgstr "'Legends of Silver Lake', still dry. 'The Big Book of Fish', with a coffee ring. And 'Stars over Azura'... with crayon smudges."

#. Gesprek meer_lena_boeken_terug, Lena zegt
#: scripts/data/ext/meer.gd:393
msgid "Het is perfect. Ik zet ze meteen terug. Hier is je beloning: dertig munten."
msgstr "It's perfect. I'll put them back right away. Here's your reward: thirty coins."

#. Gesprek meer_lena_achterkamer, Lena zegt
#: scripts/data/ext/meer.gd:404
msgid "En nu iets bijzonders. Achter de kast aan de rechterkant van de zaal zit een geheim kamertje. Alleen leden mogen erin."
msgstr "And now for something special. Behind the bookcase on the right side of the hall is a secret little room. Members only."

#. Gesprek meer_lena_achterkamer, Lena zegt
#: scripts/data/ext/meer.gd:405
msgid "Vanaf nu ben jij lid. Kijk maar eens goed naar de rechterwand..."
msgstr "And now you're a member. Take a good look at the right wall..."

#. Gesprek meer_lena_achterkamer, Lena zegt
#: scripts/data/ext/meer.gd:406
msgid "Straks, als we uitgepraat zijn, schuift de kast opzij. Hij klemde al jaren. Achterin ligt het laatste boek van de oude bibliothecarissen, en een klein cadeautje."
msgstr "When we're done talking, the bookcase will slide aside. It's been stuck for years. In the back is the last book of the old librarians, and a little gift."

#. Gesprek meer_lena_klaar, Lena zegt
#: scripts/data/ext/meer.gd:412
msgid "Mijn favoriete lezer! Het achterkamertje staat altijd voor je open. Lees vooral alles. Lessenaars bijten niet."
msgstr "My favorite reader! The back room is always open for you. Read everything you can. The reading stands don't bite."

#. Gesprek meer_lena_alles_gelezen, Lena zegt
#: scripts/data/ext/meer.gd:421
msgid "Wacht eens... heb je álle lessenaars gelezen? Zelfs die in het geheime kamertje?"
msgstr "Wait a minute... have you read ALL the reading stands? Even the ones in the secret room?"

#. Gesprek meer_lena_alles_gelezen, Lena zegt
#: scripts/data/ext/meer.gd:422
msgid "Ik heb nog nooit zo'n goede lezer ontmoet. Jij weet nu meer over Azura dan Oudste Bram. Zeg dat maar niet tegen hem."
msgstr "I've never met such a good reader. You know more about Azura than Elder Bram now. Just don't tell him that."

#. Naam van wie er praat (Gesprek meer_sanne_intro)
#. Naam van wie er praat (Gesprek meer_sanne_menu)
#. Naam van wie er praat (Gesprek meer_sanne_boek)
#. Naam van wie er praat (Gesprek meer_sanne_laars)
#. Naam van wie er praat (Gesprek meer_sanne_klaar)
#. Naam van personage meer_sanne (boven zijn hoofd)
#: scripts/data/ext/meer.gd:147 scripts/data/ext/meer.gd:430 scripts/data/ext/meer.gd:440 scripts/data/ext/meer.gd:450
msgid "Sanne"
msgstr "Sanne"

#. Gesprek meer_sanne_intro, Sanne zegt
#: scripts/data/ext/meer.gd:432
msgid "Sssst! Je maakt de vissen bang!"
msgstr "Shhhh! You're scaring the fish!"

#. Gesprek meer_sanne_intro, Sanne zegt
#: scripts/data/ext/meer.gd:433
msgid "Oh, sorry. Ik ben Sanne. Ik ben acht. En driekwart."
msgstr "Oh, sorry. I'm Sanne. I'm eight. And three quarters."

#. Gesprek meer_sanne_intro, Sanne zegt
#: scripts/data/ext/meer.gd:434
msgid "Ik probeer al de hele dag een vis te vangen. Maar ik vang alleen laarzen. Kijk, ik heb er maar één aan. De andere is... ergens."
msgstr "I've been trying to catch a fish all day. But I only catch boots. Look, I'm only wearing one. The other one is... somewhere."

#. Gesprek meer_sanne_menu, Sanne zegt
#: scripts/data/ext/meer.gd:441
msgid "Als jij een echte vis voor me hebt, geef ik je mijn schat. Het is een boek. Ik vind het saai, er staan geen plaatjes in."
msgstr "If you bring me a real fish, I'll give you my treasure. It's a book. It's boring, it has no pictures."

#. Gesprek meer_sanne_menu: keuze van de speler
#: scripts/data/ext/meer.gd:443
msgid "Hier, een baars voor jou!"
msgstr "Here, a perch for you!"

#. Gesprek meer_sanne_menu: keuze van de speler
#: scripts/data/ext/meer.gd:444
msgid "Hier, een snoek voor jou!"
msgstr "Here, a pike for you!"

#. Gesprek meer_sanne_menu: keuze van de speler
#: scripts/data/ext/meer.gd:445
msgid "Is dit jouw laars?"
msgstr "Is this your boot?"

#. Gesprek meer_sanne_menu: keuze van de speler
#: scripts/data/ext/meer.gd:446
msgid "Ik kom terug met een vis."
msgstr "I'll be back with a fish."

#. Gesprek meer_sanne_boek, Sanne zegt
#: scripts/data/ext/meer.gd:452
msgid "Een echte vis! Hij is zo glad! En hij kijkt boos! Dankjewel!"
msgstr "A real fish! He's so slippery! And he looks grumpy! Thank you!"

#. Gesprek meer_sanne_boek, Sanne zegt
#: scripts/data/ext/meer.gd:453
msgid "Hier is mijn schat. Hij zat in mijn tas, maar er past niks meer in. Veel plezier ermee."
msgstr "Here's my treasure. It was in my bag, but nothing else fits in there. Have fun with it."

#. Gesprek meer_sanne_laars, Sanne zegt
#: scripts/data/ext/meer.gd:460
msgid "MIJN LAARS! Ik zocht hem al een week! Hij stinkt precies zoals ik me herinner!"
msgstr "MY BOOT! I've been looking for it for a week! It smells just like I remember!"

#. Gesprek meer_sanne_laars, Sanne zegt
#: scripts/data/ext/meer.gd:461
msgid "Je bent de beste. Hier, neem mijn schat maar. Ik moet nu eerst mijn laars aantrekken."
msgstr "You're the best. Here, take my treasure. Now I have to put my boot on."

#. Gesprek meer_sanne_klaar, Sanne zegt
#: scripts/data/ext/meer.gd:468
msgid "Bedankt voor je hulp! Ik ga nu nog meer vangen. Ik wil de Gouden Karper. Joris zegt dat hij lacht. Vissen lachen niet. Toch?"
msgstr "Thanks for your help! Now I'm going to catch even more. I want the Golden Carp. Joris says it laughs. Fish don't laugh. Right?"

#. Gesprek meer_sanne_klaar, Sanne zegt
#: scripts/data/ext/meer.gd:469
msgid "Maar eerst moet ik stil zijn. Sssst."
msgstr "But first I have to be quiet. Shhhh."

#. Gesprek meer_mila_vis, Mila zegt
#: scripts/data/ext/meer.gd:476
msgid "Verse vis! Daar maak ik soep van. Laat maar zien..."
msgstr "Fresh fish! I'll make soup with that. Let's have a look..."

#. Gesprek meer_mila_klaar, Mila zegt
#: scripts/data/ext/meer.gd:485
msgid "Mmm, dit wordt de beste soep van het dorp. Dank je wel!"
msgstr "Mmm, this will be the best soup in the village. Thank you!"

#. Gesprek meer_mila_vol, Mila zegt
#: scripts/data/ext/meer.gd:489
msgid "Mmm, soep! Al zit het dorp wel vol met vis: ik kan niet meer dan de halve prijs betalen. Maar dank je wel!"
msgstr "Mmm, soup! But the village is full of fish right now, so I can only pay half price. Thanks anyway!"

#. Gesprek wereld_bed_info, Mila zegt
#: scripts/data/ext/wereld.gd:20
msgid "Uitrusten blijft gratis, hoor! Maar in een echt bed slapen kost 5 munten."
msgstr "Resting is still free, don't worry! But sleeping in a real bed costs 5 coins."

#. Gesprek wereld_bed_info, Mila zegt
#: scripts/data/ext/wereld.gd:21
msgid "Dan slaap je door tot de ochtend, en je wordt ook helemaal beter. Fijn als het buiten donker is!"
msgstr "You'll sleep until morning, and you'll be fully healed too. Nice when it's dark outside!"

#. Naam van wie er praat (Gesprek wereld_bed)
#. Naam van wie er praat (Gesprek wereld_bed_menu)
#. Naam van wie er praat (Gesprek wereld_bed_poor)
#: scripts/data/ext/wereld.gd:26 scripts/data/ext/wereld.gd:33 scripts/data/ext/wereld.gd:41
msgid "Bed"
msgstr "Bed"

#. Gesprek wereld_bed_menu, Bed zegt
#: scripts/data/ext/wereld.gd:34
msgid "Een zacht bed met een blauwe deken. Wil je slapen tot het ochtend is?"
msgstr "A soft bed with a blue blanket. Do you want to sleep until morning?"

#. Gesprek wereld_bed_menu: keuze van de speler
#: scripts/data/ext/wereld.gd:36
msgid "Slapen (5 munten)"
msgstr "Sleep (5 coins)"

#. Gesprek wereld_bed_poor, Bed zegt
#: scripts/data/ext/wereld.gd:42
msgid "Een zacht bed met een blauwe deken. Een nachtje slapen kost 5 munten, en zoveel heb je nu niet."
msgstr "A soft bed with a blue blanket. A night's sleep costs 5 coins, and you don't have that much right now."

#. Gesprek diepte_bram_hint, Oudste Bram zegt
#: scripts/data/ext/diepte.gd:20
msgid "Held! Wacht even, voor je gaat rusten."
msgstr "Hero! Hold on, before you go and rest."

#. Gesprek diepte_bram_hint, Oudste Bram zegt
#: scripts/data/ext/diepte.gd:21
msgid "Sinds de Blauwe Kaart weer heel is, hoor ik een zacht gerommel onder de tempel."
msgstr "Ever since the Blue Map was made whole again, I've heard a soft rumbling under the temple."

#. Gesprek diepte_bram_hint, Oudste Bram zegt
#: scripts/data/ext/diepte.gd:22
msgid "Mijn oma vertelde over een oude bewaker die diep onder de grond slaapt: De Vergeten Wachter."
msgstr "My grandma told stories about an old guardian who sleeps deep underground: the Forgotten Guardian."

#. Gesprek diepte_bram_hint, Oudste Bram zegt
#: scripts/data/ext/diepte.gd:23
msgid "Hij bewaakt de Sterrenkaart. Dat is de allereerste kaart. Onze Blauwe Kaart is daar maar een kopie van."
msgstr "He guards the Star Map. That's the very first map. Our Blue Map is just a copy of it."

#. Gesprek diepte_bram_hint, Oudste Bram zegt
#: scripts/data/ext/diepte.gd:24
msgid "Kijk achter in de tempel, waar de Slijmkoning stond. Daar zit een oud zegel in de muur. Pas goed op!"
msgstr "Look at the back of the temple, where the Slime King stood. There's an old seal in the wall. Be very careful!"

#. Gesprek greta_star, Greta zegt
#: scripts/data/ext/diepte.gd:32
msgid "Wacht eens even... Is dat... het STERRENZWAARD?!"
msgstr "Wait a minute... Is that... the STARSWORD?!"

#. Gesprek greta_star, Greta zegt
#: scripts/data/ext/diepte.gd:33
msgid "Ik ken het alleen uit de oude verhalen van mijn opa. Het is niet van ijzer gemaakt, maar van sterrenlicht!"
msgstr "I only know it from my grandpa's old stories. It isn't made of iron, it's made of starlight!"

#. Gesprek greta_star, Greta zegt
#: scripts/data/ext/diepte.gd:34
msgid "Daar kan zelfs ik niets meer aan verbeteren. Pas er goed op, held!"
msgstr "Not even I could make it any better. Take good care of it, hero!"

#. Gesprek greta_star_again, Greta zegt
#: scripts/data/ext/diepte.gd:40
msgid "Mag ik het Sterrenzwaard nog één keertje vasthouden? ... Prachtig. Ga maar, held, de wereld wacht!"
msgstr "Can I hold the Starsword just one more time? ... Beautiful. Off you go, hero, the world is waiting!"

#. Naam van wie er praat (Gesprek guardian_intro)
#. Naam van wie er praat (Gesprek guardian_defeat)
#. Titel van opdracht diepte
#. Naam van vijand guardian
#: scripts/data/ext/diepte.gd:43 scripts/data/ext/diepte.gd:53 scripts/data/ext/diepte.gd:74 scripts/data/ext/diepte.gd:125
msgid "De Vergeten Wachter"
msgstr "The Forgotten Guardian"

#. Gesprek guardian_intro, De Vergeten Wachter zegt
#: scripts/data/ext/diepte.gd:45
msgid "..."
msgstr "..."

#. Gesprek guardian_intro, De Vergeten Wachter zegt
#: scripts/data/ext/diepte.gd:46
msgid "Wie... wekt... mij?"
msgstr "Who... wakes... me?"

#. Gesprek guardian_intro, De Vergeten Wachter zegt
#: scripts/data/ext/diepte.gd:47
msgid "Ik ben de Wachter van de Sterrenkaart. Al meer dan duizend jaar waak ik hier."
msgstr "I am the Guardian of the Star Map. I have kept watch here for more than a thousand years."

#. Gesprek guardian_intro, De Vergeten Wachter zegt
#: scripts/data/ext/diepte.gd:48
msgid "De Blauwe Kaart was maar een kopie. En toch hebben jullie hem aangeraakt!"
msgstr "The Blue Map was only a copy. And still you dared to touch it!"

#. Gesprek guardian_intro, De Vergeten Wachter zegt
#: scripts/data/ext/diepte.gd:49
msgid "Alleen wie sterker is dan de Wachter, mag de Sterrenkaart zien. Laat maar zien wat je kunt!"
msgstr "Only one who is stronger than the Guardian may see the Star Map. Show me what you can do!"

#. Gesprek guardian_defeat, De Vergeten Wachter zegt
#: scripts/data/ext/diepte.gd:55
msgid "Je bent sterk. En slim. Je rolde door mijn scherven alsof het niets was."
msgstr "You are strong. And clever. You rolled through my shards like they were nothing."

#. Gesprek guardian_defeat, De Vergeten Wachter zegt
#: scripts/data/ext/diepte.gd:56
msgid "Meer dan duizend jaar heb ik gewaakt. Nu mag ik eindelijk rusten."
msgstr "For more than a thousand years I have kept watch. Now, at last, I may rest."

#. Gesprek guardian_defeat, De Vergeten Wachter zegt
#: scripts/data/ext/diepte.gd:57
msgid "Het Sterrenzwaard is nu van jou. Het is gemaakt van het licht van de Sterrenkaart. Gebruik het goed, held van Azura."
msgstr "The Starsword is yours now. It is made from the light of the Star Map. Use it well, hero of Azura."

#. Gesprek guardian_defeat, De Vergeten Wachter zegt
#: scripts/data/ext/diepte.gd:58
msgid "En kijk omhoog... Dit is wat ik al die tijd heb bewaakt."
msgstr "And look up... This is what I have guarded all this time."

#. Gesprek guardian_defeat2, verteller
#: scripts/data/ext/diepte.gd:65
msgid "Boven je hoofd gaan duizenden kleine lichtjes aan. Ze vormen samen een kaart van heel Azura: de Sterrenkaart!"
msgstr "Above your head, thousands of tiny lights blink on. Together they form a map of all of Azura: the Star Map!"

#. Gesprek guardian_defeat2, verteller
#: scripts/data/ext/diepte.gd:66
msgid "Het Sterrenzwaard gloeit in je hand. Het is zo licht als een veertje en zo scherp als een sterrenstraal."
msgstr "The Starsword glows in your hand. It's as light as a feather and as sharp as a beam of starlight."

#. Gesprek guardian_defeat2, verteller
#: scripts/data/ext/diepte.gd:67
msgid "Greta de smid gaat hier zeker van opkijken! Laat het haar maar eens zien in de smederij."
msgstr "Greta the Smith is going to be amazed! Go show it to her at the Smithy."

#. Naam van wie er praat (Gesprek arena_bruno_intro)
#. Naam van wie er praat (Gesprek arena_bruno_menu)
#. Naam van wie er praat (Gesprek arena_bruno_ranks)
#. Naam van wie er praat (Gesprek arena_bronze_info)
#. Naam van wie er praat (Gesprek arena_bronze_ask)
#. Naam van wie er praat (Gesprek arena_silver_info)
#: scripts/data/ext/arena.gd:78 scripts/data/ext/arena.gd:94 scripts/data/ext/arena.gd:104 scripts/data/ext/arena.gd:114
msgid "Arenameester Bruno"
msgstr "Arena Master Bruno"

#. Gesprek arena_bruno_intro, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:96
msgid "HA! Een nieuwe vechter! Welkom in de arena van Dageraadsdorp. Ik ben Bruno, de arenameester."
msgstr "HA! A new fighter! Welcome to the arena of Daybreak Village. I'm Bruno, the Arena Master."

#. Gesprek arena_bruno_intro, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:97
msgid "Hier vecht je tegen golven vijanden, en het hele dorp kijkt toe. Dat hoor je aan het gejuich!"
msgstr "Here you fight wave after wave of enemies, and the whole village watches. Just listen to them cheer!"

#. Gesprek arena_bruno_intro, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:98
msgid "Na elke ronde krijg je even rust en een hartje van het publiek. Maar de poorten gaan pas weer open als je alle rondes hebt gewonnen."
msgstr "After each round you get a short break and a heart from the crowd. But the gates won't open again until you've won every round."

#. Gesprek arena_bruno_menu, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:105
msgid "Hé {arena_title}! Wat kan ik voor je doen?"
msgstr "Hey {arena_title}! What can I do for you?"

#. Gesprek arena_bruno_menu: keuze van de speler
#: scripts/data/ext/arena.gd:107
msgid "Ik wil meedoen."
msgstr "I want to fight."

#. Gesprek arena_bruno_menu: keuze van de speler
#: scripts/data/ext/arena.gd:108
msgid "Hoe werkt het?"
msgstr "How does it work?"

#. Gesprek arena_bruno_menu: keuze van de speler
#: scripts/data/ext/arena.gd:109
msgid "Mijn records."
msgstr "My records."

#. Gesprek arena_bruno_ranks, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:115
msgid "Welke rang wil je proberen?"
msgstr "Which rank do you want to try?"

#. Gesprek arena_bruno_ranks: keuze van de speler
#: scripts/data/ext/arena.gd:117
msgid "Brons: 3 rondes, 10 munten"
msgstr "Bronze: 3 rounds, 10 coins"

#. Gesprek arena_bruno_ranks: keuze van de speler
#: scripts/data/ext/arena.gd:118
msgid "Zilver: 5 rondes, 25 munten"
msgstr "Silver: 5 rounds, 25 coins"

#. Gesprek arena_bruno_ranks: keuze van de speler
#: scripts/data/ext/arena.gd:119
msgid "Goud: 7 rondes, 50 munten"
msgstr "Gold: 7 rounds, 50 coins"

#. Gesprek arena_bronze_info, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:126
msgid "Brons: drie rondes met slijmen en vleermuizen. Pas op voor de rode slijmen aan het eind! Inschrijven kost 10 munten."
msgstr "Bronze: three rounds of slimes and bats. Watch out for the Red Slimes at the end! The entry fee is 10 coins."

#. Gesprek arena_bronze_info, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:127
msgid "Win je, dan krijg je 50 munten en een bronzen trofee."
msgstr "If you win, you get 50 coins and a Bronze Trophy."

#. Gesprek arena_bronze_ask, Arenameester Bruno zegt
#. Gesprek arena_silver_ask, Arenameester Bruno zegt
#. Gesprek arena_gold_ask, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:136 scripts/data/ext/arena.gd:155 scripts/data/ext/arena.gd:174
msgid "Zal ik je inschrijven?"
msgstr "Shall I sign you up?"

#. Gesprek arena_bronze_ask: keuze van de speler
#. Gesprek arena_silver_ask: keuze van de speler
#. Gesprek arena_gold_ask: keuze van de speler
#: scripts/data/ext/arena.gd:138 scripts/data/ext/arena.gd:157 scripts/data/ext/arena.gd:176
msgid "Ja, schrijf me in!"
msgstr "Yes, sign me up!"

#. Gesprek arena_silver_info, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:145
msgid "Zilver: vijf rondes, nu ook met skeletten die pijlen schieten. Inschrijven kost 25 munten."
msgstr "Silver: five rounds, now with skeletons that shoot arrows too. The entry fee is 25 coins."

#. Gesprek arena_silver_info, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:146
msgid "Win je, dan krijg je 150 munten en een zilveren trofee."
msgstr "If you win, you get 150 coins and a Silver Trophy."

#. Gesprek arena_gold_info, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:164
msgid "Goud: zeven rondes, en in de laatste ronde komt er een kristalgolem uit de poort. Inschrijven kost 50 munten."
msgstr "Gold: seven rounds, and in the last round a Crystal Golem comes out of the gate. The entry fee is 50 coins."

#. Gesprek arena_gold_info, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:165
msgid "Win je, dan krijg je 400 munten, een gouden trofee en een verrassing van mij. Tip: met een kristalzwaard kom je een stuk verder!"
msgstr "If you win, you get 400 coins, a Gold Trophy and a surprise from me. Tip: a Crystal Sword will get you a lot further!"

#. Gesprek arena_no_money, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:183
msgid "Hmm, je hebt niet genoeg munten voor de inschrijving."
msgstr "Hmm, you don't have enough coins for the entry fee."

#. Gesprek arena_no_money, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:184
msgid "Versla wat slijmen en kom dan terug!"
msgstr "Go beat some slimes and come back!"

#. Gesprek arena_bruno_go, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:190
msgid "Je staat op de lijst! Loop maar door de grote deur naar de arena. Succes, {arena_title}!"
msgstr "You're on the list! Head through the big door into the arena. Good luck, {arena_title}!"

#. Gesprek arena_bruno_rules, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:195
msgid "De regels zijn simpel. Zodra je binnen bent, sluiten de poorten. Je kunt pas weg als je alle rondes hebt gewonnen."
msgstr "The rules are simple. Once you're inside, the gates close. You can't leave until you've won every round."

#. Gesprek arena_bruno_rules, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:196
msgid "Na elke ronde heb je drie seconden rust, en het publiek gooit je een hartje toe. Gaat het tijdens een ronde heel slecht? Dan gooit het publiek er nog eentje."
msgstr "After each round you get three seconds of rest, and the crowd throws you a heart. Is a round going really badly? Then the crowd throws you another one."

#. Gesprek arena_bruno_rules, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:197
msgid "Word je verslagen? Dan ben je je inschrijving kwijt, maar je bent meteen weer helemaal beter. Opgeven kan ook: sla op de gong bij de uitgang."
msgstr "Knocked out? Then you lose your entry fee, but you're fully healed right away. You can also give up: hit the gong by the exit."

#. Gesprek arena_bruno_rules, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:198
msgid "Zilver gaat open als je Brons hebt gehaald, en Goud als je Zilver hebt gehaald. Let op: vijanden in de arena laten niets vallen. Het gaat om de eer!"
msgstr "Silver opens once you've beaten Bronze, and Gold once you've beaten Silver. Heads up: enemies in the arena don't drop anything. You fight for glory!"

#. Gesprek arena_bruno_rules, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:199
msgid "Een rang nog een keer winnen mag altijd. Dan krijg je de helft van de munten, en misschien een nieuw record op het scorebord!"
msgstr "You can always win a rank again. Then you get half the coins, and maybe a new record on the scoreboard!"

#. Gesprek arena_bruno_records, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:206
msgid "Jouw titel: {arena_title}."
msgstr "Your title: {arena_title}."

#. Gesprek arena_bruno_records, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:207
msgid "Je beste tijden. Brons: {arena_best_bronze}. Zilver: {arena_best_silver}. Goud: {arena_best_gold}."
msgstr "Your best times. Bronze: {arena_best_bronze}. Silver: {arena_best_silver}. Gold: {arena_best_gold}."

#. Gesprek arena_bruno_records, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:208
msgid "Ben je sneller? Dan zet ik je nieuwe tijd meteen op het scorebord."
msgstr "Beat your time? Then I'll put your new time on the scoreboard right away."

#. Gesprek arena_bruno_registered, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:214
msgid "Je staat al op de lijst! De grote deur naar de arena staat voor je open."
msgstr "You're already on the list! The big door to the arena is open for you."

#. Gesprek arena_bruno_registered: keuze van de speler
#: scripts/data/ext/arena.gd:216
msgid "Top, ik ga!"
msgstr "Great, let's go!"

#. Gesprek arena_bruno_registered: keuze van de speler
#: scripts/data/ext/arena.gd:217
msgid "Toch niet. Geef mijn munten maar terug."
msgstr "Never mind. I'd like my coins back."

#. Gesprek arena_bruno_cancelled, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:222
msgid "Geen probleem. Hier zijn je munten. Kom maar terug als je er klaar voor bent!"
msgstr "No problem. Here are your coins. Come back when you're ready!"

#. Gesprek arena_bruno_won_bronze, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:229
msgid "Wat een gevecht! Het publiek roept nog steeds je naam."
msgstr "What a fight! The crowd is still chanting your name."

#. Gesprek arena_bruno_first_bronze, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:239
msgid "Je eerste rang! Vanaf nu ben je een Arenastrijder. Je trofee staat op de plank."
msgstr "Your first rank! From now on you're an Arena Fighter. Your trophy is on the shelf."

#. Gesprek arena_bruno_first_bronze, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:240
msgid "Zilver staat nu ook voor je open: vijf rondes, met skeletten die pijlen schieten. Succes!"
msgstr "Silver is open for you now too: five rounds, with skeletons that shoot arrows. Good luck!"

#. Gesprek arena_bruno_won_silver, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:247
msgid "Zilver! Dat doet niet iedereen je na."
msgstr "Silver! Not everyone can pull that off."

#. Gesprek arena_bruno_first_silver, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:257
msgid "Arenaridder! Zo mag ik je nu noemen. Nog één rang te gaan: Goud."
msgstr "Arena Knight! That's what I get to call you now. Just one more rank to go: Gold."

#. Gesprek arena_bruno_first_silver, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:258
msgid "Zeven rondes, en in de laatste komt een kristalgolem uit de poort. Neem je beste zwaard mee!"
msgstr "Seven rounds, and in the last one a Crystal Golem comes out of the gate. Bring your best sword!"

#. Gesprek arena_bruno_won_gold, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:265
msgid "GOUD! Het dak ging bijna van de arena af!"
msgstr "GOLD! The crowd nearly blew the roof off the arena!"

#. Gesprek arena_bruno_first_gold, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:275
msgid "Jij bent de nieuwe Arenakampioen! Er is niemand in heel Azura die dit beter kan."
msgstr "You're the new Arena Champion! Nobody in all of Azura does it better."

#. Gesprek arena_bruno_first_gold, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:276
msgid "En dit is mijn verrassing: de Arenahelm! Een echte kampioen draagt hem met trots. Kijk maar op de plank: er staat nu van alles op!"
msgstr "And here's my surprise: the Arena Helmet! A true champion wears it with pride. Take a look at the shelf: it's full of goodies now!"

#. Gesprek arena_bruno_lost, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:284
msgid "Au! Dat was een zware. Maar je bent weer helemaal beter, dat regel ik altijd."
msgstr "Ouch! That was a tough one. But you're fully healed again, I always take care of that."

#. Gesprek arena_bruno_lost, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:285
msgid "Je inschrijving ben je wel kwijt. Probeer het nog eens: vallen en opstaan, zo word je sterker!"
msgstr "You did lose your entry fee, though. Try again: fall down, get back up, that's how you get stronger!"

#. Gesprek arena_bruno_quit, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:293
msgid "Opgegeven? Geen schande hoor. Soms is stoppen slimmer dan doorvechten."
msgstr "Gave up? No shame in that. Sometimes stopping is smarter than fighting on."

#. Gesprek arena_bruno_quit, Arenameester Bruno zegt
#: scripts/data/ext/arena.gd:294
msgid "Je inschrijving ben je wel kwijt, maar je bent weer helemaal beter. Kom maar terug als je klaar bent!"
msgstr "You did lose your entry fee, but you're fully healed again. Come back when you're ready!"

#. Naam van wie er praat (Gesprek arena_forfeit_ask)
#: scripts/data/ext/arena.gd:302
msgid "Arenagong"
msgstr "Arena Gong"

#. Gesprek arena_forfeit_ask, Arenagong zegt
#: scripts/data/ext/arena.gd:304
msgid "Wil je opgeven? Dan galmt de gong en stopt het gevecht."
msgstr "Do you want to give up? Then the gong will ring and the fight will stop."

#. Gesprek arena_forfeit_ask, Arenagong zegt
#: scripts/data/ext/arena.gd:305
msgid "Je inschrijving ben je dan kwijt. Je bent wel meteen weer helemaal beter."
msgstr "You'll lose your entry fee. But you'll be fully healed right away."

#. Gesprek arena_forfeit_ask: keuze van de speler
#: scripts/data/ext/arena.gd:308
msgid "Ja, ik geef op."
msgstr "Yes, I give up."

#. Gesprek arena_forfeit_ask: keuze van de speler
#: scripts/data/ext/arena.gd:309
msgid "Nee, ik vecht door!"
msgstr "No, I'll keep fighting!"

#. Naam van wie er praat (Gesprek lotte_intro)
#. Naam van wie er praat (Gesprek lotte_vraag)
#. Naam van wie er praat (Gesprek lotte_ok)
#. Naam van wie er praat (Gesprek lotte_menu)
#. Naam van wie er praat (Gesprek lotte_klaar)
#: scripts/data/ext/polijst.gd:135 scripts/data/ext/polijst.gd:141 scripts/data/ext/polijst.gd:148 scripts/data/ext/polijst.gd:149
msgid "Lotte"
msgstr "Lotte"

#. Gesprek lotte_intro, Lotte zegt
#: scripts/data/ext/polijst.gd:136
msgid "Ik ben Lotte. Ik maak lantaarns voor het dorp."
msgstr "I'm Lotte. I make lanterns for the village."

#. Gesprek lotte_intro, Lotte zegt
#: scripts/data/ext/polijst.gd:136
msgid "Mijn beste werk, de nachtlantaarn, is verdwenen. Ik had hem meegenomen naar de ruïne en daar gelaten."
msgstr "My finest work, the night lantern, has gone missing. I took it to the ruins and left it there."

#. Gesprek lotte_vraag, Lotte zegt
#: scripts/data/ext/polijst.gd:142
msgid "Wil je hem voor me zoeken? Hij geeft veel beter licht in het donker."
msgstr "Will you find it for me? It gives much better light in the dark."

#. Gesprek lotte_vraag: keuze van de speler
#: scripts/data/ext/polijst.gd:144
msgid "Ik zoek hem wel."
msgstr "I'll find it."

#. Gesprek lotte_vraag: keuze van de speler
#. Gesprek mira_mist_vraag: keuze van de speler
#. Gesprek fenna_vraag: keuze van de speler
#. Gesprek jelle_vraag: keuze van de speler
#. Gesprek mees_vraag: keuze van de speler
#: scripts/data/ext/dorst.gd:154 scripts/data/ext/moeras.gd:140 scripts/data/ext/polijst.gd:145 scripts/data/ext/polijst.gd:251
msgid "Later misschien."
msgstr "Maybe later."

#. Gesprek lotte_ok, Lotte zegt
#: scripts/data/ext/polijst.gd:148
msgid "Dank je. Kijk in de Vergeten Ruïne, ergens bij de oude gangen."
msgstr "Thank you. Look in the Forgotten Ruins, somewhere near the old corridors."

#. Gesprek lotte_menu, Lotte zegt
#: scripts/data/ext/polijst.gd:149
msgid "Heb je de nachtlantaarn al gevonden?"
msgstr "Have you found the night lantern yet?"

#. Gesprek lotte_menu: keuze van de speler
#. Gesprek elke_menu: keuze van de speler
#. Gesprek mira_menu: keuze van de speler
#. Gesprek mira_mist_menu: keuze van de speler
#. Gesprek noor_menu: keuze van de speler
#. Gesprek roos_menu: keuze van de speler
#: scripts/data/ext/dorst.gd:158 scripts/data/ext/moeras.gd:105 scripts/data/ext/polijst.gd:149 scripts/data/ext/polijst.gd:189
msgid "Nog niet."
msgstr "Not yet."

#. Gesprek lotte_menu: keuze van de speler
#. Gesprek kasper_menu: keuze van de speler
#. Gesprek tomas_menu: keuze van de speler
#. Gesprek roos_menu: keuze van de speler
#: scripts/data/ext/polijst.gd:149 scripts/data/ext/polijst.gd:168 scripts/data/ext/polijst.gd:273 scripts/data/ext/sneeuw.gd:129
msgid "Tot later."
msgstr "See you later."

#. Gesprek lotte_klaar, Lotte zegt
#: scripts/data/ext/polijst.gd:152
msgid "Je hebt hem! Hij werkt nog. Neem hem maar, hij helpt je beter in het donker dan een gewone."
msgstr "You found it! It still works. Take it — it will help you in the dark far better than a normal one."

#. Gesprek lotte_klaar, Lotte zegt
#: scripts/data/ext/polijst.gd:152
msgid "En hier wat munten voor de moeite."
msgstr "And here are some coins for your trouble."

#. Naam van wie er praat (Gesprek kasper_intro)
#. Naam van wie er praat (Gesprek kasper_menu)
#. Naam van wie er praat (Gesprek kasper_bijzonder)
#. Naam van wie er praat (Gesprek kasper_handel)
#: scripts/data/ext/polijst.gd:157 scripts/data/ext/polijst.gd:163 scripts/data/ext/polijst.gd:171 scripts/data/ext/polijst.gd:172
msgid "Kasper"
msgstr "Kasper"

#. Gesprek kasper_intro, Kasper zegt
#: scripts/data/ext/polijst.gd:158
msgid "Ha, een reiziger! Ik ben Kasper. Ik verhandel alles wat de slijmen niet opeten."
msgstr "Ha, a traveller! I'm Kasper. I trade everything the slimes won't eat."

#. Gesprek kasper_intro, Kasper zegt
#: scripts/data/ext/polijst.gd:158
msgid "Munten, kruiden, geruchten... als het waarde heeft, koop of verkoop ik het."
msgstr "Coins, herbs, rumours... if it has value, I buy or sell it."

#. Gesprek kasper_menu, Kasper zegt
#: scripts/data/ext/polijst.gd:164
msgid "Wat brengt je naar mijn kraam?"
msgstr "What brings you to my stall?"

#. Gesprek kasper_menu: keuze van de speler
#: scripts/data/ext/polijst.gd:166
msgid "Heb je iets bijzonders?"
msgstr "Got anything special?"

#. Gesprek kasper_menu: keuze van de speler
#: scripts/data/ext/polijst.gd:167
msgid "Hoe gaat de handel?"
msgstr "How's business?"

#. Gesprek kasper_bijzonder, Kasper zegt
#: scripts/data/ext/polijst.gd:171
msgid "Bijzonders? Alles is bijzonder als je het hard genoeg wilt. Maar echte schatten liggen buiten het dorp."
msgstr "Special? Everything is special if you want it badly enough. But real treasures lie outside the village."

#. Gesprek kasper_handel, Kasper zegt
#: scripts/data/ext/polijst.gd:172
msgid "De handel bloeit. Zolang de Slijmkoning weg blijft, blijft mijn tas vol."
msgstr "Business is blooming. As long as the Slime King stays away, my bag stays full."

#. Naam van wie er praat (Gesprek elke_intro)
#. Naam van wie er praat (Gesprek elke_vraag)
#. Naam van wie er praat (Gesprek elke_ok)
#. Naam van wie er praat (Gesprek elke_menu)
#. Naam van wie er praat (Gesprek elke_klaar)
#: scripts/data/ext/polijst.gd:175 scripts/data/ext/polijst.gd:181 scripts/data/ext/polijst.gd:188 scripts/data/ext/polijst.gd:189
msgid "Elke"
msgstr "Elke"

#. Gesprek elke_intro, Elke zegt
#: scripts/data/ext/polijst.gd:176
msgid "Welkom bij mijn kruiden. Ik ben Elke. Ik droog, maal en brouw alles wat groen is."
msgstr "Welcome to my herbs. I'm Elke. I dry, grind and brew everything green."

#. Gesprek elke_intro, Elke zegt
#: scripts/data/ext/polijst.gd:176
msgid "De verse kruiden uit het bos zijn het beste. Die mis ik nu."
msgstr "Fresh herbs from the forest are the best. Those I am missing now."

#. Gesprek elke_vraag, Elke zegt
#: scripts/data/ext/polijst.gd:182
msgid "Wil je 4 verse kruiden voor me plukken in het Fluisterbos of Dauwbos?"
msgstr "Will you pick 4 fresh herbs for me in the Whispering Woods or Dew Woods?"

#. Gesprek elke_vraag: keuze van de speler
#: scripts/data/ext/polijst.gd:184
msgid "Ik haal ze."
msgstr "I'll get them."

#. Gesprek elke_ok, Elke zegt
#: scripts/data/ext/polijst.gd:188
msgid "Fijn. Ze liggen in kisten of op de grond in de bossen."
msgstr "Good. They lie in chests or on the ground in the woods."

#. Gesprek elke_menu, Elke zegt
#: scripts/data/ext/polijst.gd:189
msgid "Heb je de kruiden al?"
msgstr "Do you have the herbs yet?"

#. Gesprek elke_menu: keuze van de speler
#. Gesprek mira_menu: keuze van de speler
#. Gesprek mira_mist_menu: keuze van de speler
#. Gesprek fenna_menu: keuze van de speler
#. Gesprek jelle_menu: keuze van de speler
#. Gesprek sana_menu: keuze van de speler
#: scripts/data/ext/dorst.gd:158 scripts/data/ext/dorst.gd:214 scripts/data/ext/moeras.gd:105 scripts/data/ext/moeras.gd:145
msgid "Tot zo."
msgstr "See you soon."

#. Gesprek elke_klaar, Elke zegt
#: scripts/data/ext/polijst.gd:192
msgid "Prachtig vers! Hier, een drankje en wat munten. Kom gerust terug."
msgstr "Beautifully fresh! Here, a potion and some coins. Come back anytime."

#. Naam van wie er praat (Gesprek willem_intro)
#. Naam van wie er praat (Gesprek willem_menu)
#. Naam van wie er praat (Gesprek willem_kaart)
#. Naam van wie er praat (Gesprek willem_diepte)
#: scripts/data/ext/polijst.gd:197 scripts/data/ext/polijst.gd:203 scripts/data/ext/polijst.gd:211 scripts/data/ext/polijst.gd:212
msgid "Willem"
msgstr "Willem"

#. Gesprek willem_intro, Willem zegt
#: scripts/data/ext/polijst.gd:198
msgid "Ah, een luisteraar! Ik ben Willem. Ik ken alle verhalen van Azura."
msgstr "Ah, a listener! I'm Willem. I know all the stories of Azura."

#. Gesprek willem_intro, Willem zegt
#: scripts/data/ext/polijst.gd:198
msgid "Van de gebarsten kaart tot de oude wachters in de Diepte."
msgstr "From the cracked map to the old watchers in the Depths."

#. Gesprek willem_menu, Willem zegt
#: scripts/data/ext/polijst.gd:204
msgid "Welk verhaal wil je horen?"
msgstr "Which story do you want to hear?"

#. Gesprek willem_menu: keuze van de speler
#: scripts/data/ext/polijst.gd:206
msgid "Over de Blauwe Kaart."
msgstr "About the Blue Map."

#. Gesprek willem_menu: keuze van de speler
#: scripts/data/ext/polijst.gd:207
msgid "Over de Diepte."
msgstr "About the Depths."

#. Gesprek willem_menu: keuze van de speler
#. Gesprek olav_menu: keuze van de speler
#: scripts/data/ext/polijst.gd:208 scripts/data/ext/sneeuw.gd:149
msgid "Een ander keer."
msgstr "Another time."

#. Gesprek willem_kaart, Willem zegt
#: scripts/data/ext/polijst.gd:211
msgid "De Blauwe Kaart hield Azura bijeen. Toen hij barstte, vlogen de kristallen het land in. Zonder hen raakt alles uit balans."
msgstr "The Blue Map held Azura together. When it cracked, the crystals flew into the land. Without them, everything falls out of balance."

#. Gesprek willem_diepte, Willem zegt
#: scripts/data/ext/polijst.gd:212
msgid "Onder de tempel slaapt een oude wachter. Hij bewaakt het origineel van de kaart. Wees voorzichtig als je hem wekt."
msgstr "An old watcher sleeps beneath the temple. He guards the original of the map. Be careful if you wake him."

#. Naam van wie er praat (Gesprek mira_intro)
#. Naam van wie er praat (Gesprek mira_vraag)
#. Naam van wie er praat (Gesprek mira_ok)
#. Naam van wie er praat (Gesprek mira_menu)
#. Naam van wie er praat (Gesprek mira_steen)
#. Naam van wie er praat (Gesprek mira_klaar)
#: scripts/data/ext/polijst.gd:215 scripts/data/ext/polijst.gd:221 scripts/data/ext/polijst.gd:228 scripts/data/ext/polijst.gd:229
msgid "Mira"
msgstr "Mira"

#. Gesprek mira_intro, Mira zegt
#: scripts/data/ext/polijst.gd:216
msgid "Welkom in het Dauwbos. Ik ben Mira. Ik bewaar de dauw hier."
msgstr "Welcome to the Dew Woods. I'm Mira. I keep the dew here."

#. Gesprek mira_intro, Mira zegt
#: scripts/data/ext/polijst.gd:216
msgid "De mist wordt dikker. Ik zoek een oude dauwsteen om het evenwicht te herstellen."
msgstr "The mist is growing thicker. I'm looking for an old dew stone to restore the balance."

#. Gesprek mira_vraag, Mira zegt
#: scripts/data/ext/polijst.gd:222
msgid "Wil je de dauwsteen voor me zoeken? Hij ligt ergens in dit bos."
msgstr "Will you find the dew stone for me? It lies somewhere in this forest."

#. Gesprek mira_vraag: keuze van de speler
#: scripts/data/ext/polijst.gd:224
msgid "Ik zoek hem."
msgstr "I'll find it."

#. Gesprek mira_vraag: keuze van de speler
#: scripts/data/ext/polijst.gd:225
msgid "Later."
msgstr "Later."

#. Gesprek mira_ok, Mira zegt
#: scripts/data/ext/polijst.gd:228
msgid "Dank je. Zoek in het noorden of bij de kisten."
msgstr "Thank you. Search the north or near the chests."

#. Gesprek mira_menu, Mira zegt
#: scripts/data/ext/polijst.gd:229
msgid "Heb je de steen al?"
msgstr "Do you have the stone yet?"

#. Gesprek mira_steen, Mira zegt
#: scripts/data/ext/polijst.gd:232
msgid "Je hebt de steen! Prachtig. Nu moet ik het oude verhaal horen. Praat met Tomas."
msgstr "You have the stone! Wonderful. Now I must hear the old story. Talk to Tomas."

#. Gesprek mira_klaar, Mira zegt
#: scripts/data/ext/polijst.gd:237
msgid "Het verhaal klopt. De steen werkt. De dauw blijft, maar de mist wordt zachter."
msgstr "The story is true. The stone works. The dew stays, but the mist softens."

#. Gesprek mira_klaar, Mira zegt
#: scripts/data/ext/polijst.gd:237
msgid "Hier, een beloning voor je hulp."
msgstr "Here, a reward for your help."

#. Gesprek mira_mist_intro, Mira zegt
#: scripts/data/ext/polijst.gd:242
msgid "De mist is zacht nu, dankzij jou. Precies goed voor de dauwklauw: een bleke bloem die alleen in zachte mist bloeit."
msgstr "The mist is soft now, thanks to you. Just right for the dewclaw: a pale flower that only blooms in soft mist."

#. Gesprek mira_mist_intro, Mira zegt
#: scripts/data/ext/polijst.gd:242
msgid "Ik brouw er mistedrank van — koel en helder, net als het bos zelf."
msgstr "I brew mist tonic from it — cool and clear, just like the forest itself."

#. Gesprek mira_mist_vraag, Mira zegt
#: scripts/data/ext/polijst.gd:248
msgid "Wil je 3 dauwklauwen voor me plukken? Bij de vijver en langs de westelijke paden groeien ze het dichtst."
msgstr "Will you pick 3 dewclaws for me? They grow thickest by the pond and along the western paths."

#. Gesprek mira_mist_vraag: keuze van de speler
#: scripts/data/ext/polijst.gd:250
msgid "Ik pluk ze wel."
msgstr "I'll pick them."

#. Gesprek mira_mist_ok, Mira zegt
#: scripts/data/ext/polijst.gd:254
msgid "Dank je. Zoek de bleke bloemen met de dauwdruppels — die glinsteren zelfs in de mist."
msgstr "Thank you. Look for the pale flowers with dewdrops — they glisten even in the mist."

#. Gesprek mira_mist_menu, Mira zegt
#: scripts/data/ext/polijst.gd:255
msgid "Heb je de dauwklauwen al?"
msgstr "Do you have the dewclaws yet?"

#. Gesprek mira_mist_klaar, Mira zegt
#: scripts/data/ext/polijst.gd:258
msgid "Prachtig, ze zijn vers. Kijk — zo brouw ik het mistedrank."
msgstr "Beautiful, they're fresh. Look — this is how I brew the mist tonic."

#. Gesprek mira_mist_klaar, Mira zegt
#: scripts/data/ext/polijst.gd:258
msgid "De eerste fles is voor jou. En leer het recept: zo kun je er zelf meer maken in de bibliotheek."
msgstr "The first bottle is for you. And learn the recipe: that way you can brew more yourself in the library."

#. Naam van wie er praat (Gesprek tomas_intro)
#. Naam van wie er praat (Gesprek tomas_menu)
#. Naam van wie er praat (Gesprek tomas_verhaal)
#: scripts/data/ext/polijst.gd:263 scripts/data/ext/polijst.gd:269 scripts/data/ext/polijst.gd:277
msgid "Tomas"
msgstr "Tomas"

#. Gesprek tomas_intro, Tomas zegt
#: scripts/data/ext/polijst.gd:264
msgid "Ik ben Tomas. Ik woon al lang in dit bos. De dauw kent me."
msgstr "I'm Tomas. I have lived in this forest for a long time. The dew knows me."

#. Gesprek tomas_menu, Tomas zegt
#: scripts/data/ext/polijst.gd:270
msgid "Wat wil je weten?"
msgstr "What do you want to know?"

#. Gesprek tomas_menu: keuze van de speler
#: scripts/data/ext/polijst.gd:272
msgid "Vertel het oude verhaal."
msgstr "Tell me the old story."

#. Gesprek tomas_verhaal, Tomas zegt
#: scripts/data/ext/polijst.gd:278
msgid "Lang geleden viel de dauwsteen uit de sterren. Hij houdt de mist levend. Zonder hem wordt het bos dor."
msgstr "Long ago the dew stone fell from the stars. It keeps the mist alive. Without it the forest turns dry."

#. Gesprek tomas_verhaal, Tomas zegt
#: scripts/data/ext/polijst.gd:278
msgid "Mira weet wat ze doet. Geef haar de steen."
msgstr "Mira knows what she is doing. Give her the stone."

#. Naam van wie er praat (Gesprek noor_intro)
#. Naam van wie er praat (Gesprek noor_menu)
#: scripts/data/ext/polijst.gd:284 scripts/data/ext/polijst.gd:290
msgid "Noor"
msgstr "Noor"

#. Gesprek noor_intro, Noor zegt
#: scripts/data/ext/polijst.gd:285
msgid "Ik ben Noor. Ik verzamel alles wat glimt in de dauw."
msgstr "I'm Noor. I collect everything that glimmers in the dew."

#. Gesprek noor_menu, Noor zegt
#: scripts/data/ext/polijst.gd:291
msgid "Heb je iets moois gevonden in het bos?"
msgstr "Have you found anything beautiful in the forest?"

#. Naam van wie er praat (Gesprek fenna_intro)
#. Naam van wie er praat (Gesprek fenna_vraag)
#. Naam van wie er praat (Gesprek fenna_ok)
#. Naam van wie er praat (Gesprek fenna_menu)
#. Naam van wie er praat (Gesprek fenna_klaar)
#: scripts/data/ext/sneeuw.gd:56 scripts/data/ext/sneeuw.gd:69 scripts/data/ext/sneeuw.gd:87 scripts/data/ext/sneeuw.gd:88
msgid "Fenna"
msgstr "Fenna"

#. Gesprek fenna_intro, Fenna zegt
#: scripts/data/ext/sneeuw.gd:58
msgid "De noordelijke huizen zijn verlaten sinds hun vuurkorven uitgingen. Help je de warmte terugbrengen? Takken vind je langs het plein; koken of prismatechniek werkt ook."
msgstr "The northern houses have been abandoned since their braziers went out. Will you bring back their warmth? Find branches around the square; cooking or prism technology works too."

#. Gesprek fenna_vraag, Fenna zegt
#: scripts/data/ext/sneeuw.gd:70
msgid "Help je de warmte terugbrengen?"
msgstr "Will you help bring back the warmth?"

#. Gesprek fenna_vraag: keuze van de speler
#: scripts/data/ext/sneeuw.gd:73
msgid "Ik herstel de vuurkorven."
msgstr "I will restore the braziers."

#. Gesprek fenna_ok, Fenna zegt
#. Gesprek fenna_menu, Fenna zegt
#: scripts/data/ext/sneeuw.gd:87 scripts/data/ext/sneeuw.gd:88
msgid "De vuurkorven staan voor de twee noordelijke huizen. Houd vijanden uit de buurt tot het vuur stabiel is. Samen brengen we de warmte terug."
msgstr "The braziers stand outside the two northern houses. Keep enemies away until the fire is stable. Together we will bring back the warmth."

#. Gesprek fenna_klaar, Fenna zegt
#: scripts/data/ext/sneeuw.gd:92
msgid "De ramen gloeien weer! De families keren terug en de bergpas is open. Draag dit wachtharnas als je bescherming boven snelheid kiest."
msgstr "The windows glow again! Families are returning and the mountain pass is open. Wear this warden coat when you value protection over speed."

#. Naam van wie er praat (Gesprek roos_intro)
#. Naam van wie er praat (Gesprek roos_vraag)
#. Naam van wie er praat (Gesprek roos_ok)
#. Naam van wie er praat (Gesprek roos_menu)
#. Naam van wie er praat (Gesprek roos_klaar)
#: scripts/data/ext/sneeuw.gd:115 scripts/data/ext/sneeuw.gd:121 scripts/data/ext/sneeuw.gd:128 scripts/data/ext/sneeuw.gd:129
msgid "Roos"
msgstr "Roos"

#. Gesprek roos_intro, Roos zegt
#: scripts/data/ext/sneeuw.gd:116
msgid "Stil maar. Ik ben Roos, jageres van IJsdal. Ik houd de paden vrij van slijmen."
msgstr "Quiet now. I am Roos, huntress of IJsdal. I keep the paths clear of slimes."

#. Gesprek roos_intro, Roos zegt
#: scripts/data/ext/sneeuw.gd:116
msgid "De ijsblauwe slijmen worden brutaal deze winter. Ze verschuilen zich tussen de rotsen."
msgstr "The ice-blue slimes grow bold this winter. They hide among the rocks."

#. Gesprek roos_vraag, Roos zegt
#: scripts/data/ext/sneeuw.gd:122
msgid "Wil je de ijswacht helpen? Versla 4 ijsblauwe slijmen in het dal."
msgstr "Will you help the ice watch? Defeat 4 ice-blue slimes in the valley."

#. Gesprek roos_vraag: keuze van de speler
#: scripts/data/ext/sneeuw.gd:124
msgid "Ik regel het."
msgstr "I'm on it."

#. Gesprek roos_vraag: keuze van de speler
#. Gesprek sana_vraag: keuze van de speler
#: scripts/data/ext/dorst.gd:188 scripts/data/ext/sneeuw.gd:125
msgid "Niet nu."
msgstr "Not now."

#. Gesprek roos_ok, Roos zegt
#: scripts/data/ext/sneeuw.gd:128
msgid "Goed. Ze zitten bij de mijnhoek en het westelijke bosje. Kijk uit voor het gladde ijs."
msgstr "Good. They lurk by the mine corner and the western copse. Watch out for the slippery ice."

#. Gesprek roos_menu, Roos zegt
#: scripts/data/ext/sneeuw.gd:129
msgid "Zijn de paden al veilig?"
msgstr "Are the paths safe yet?"

#. Gesprek roos_klaar, Roos zegt
#: scripts/data/ext/sneeuw.gd:132
msgid "Vier stuks? Netjes. Het dal ademt weer."
msgstr "Four of them? Well done. The valley breathes again."

#. Gesprek roos_klaar, Roos zegt
#: scripts/data/ext/sneeuw.gd:132
msgid "Hier, een warme wintergloed en wat munten. De ijswacht vergeet dit niet."
msgstr "Here, a warm winter glow and some coins. The ice watch will not forget this."

#. Naam van wie er praat (Gesprek olav_intro)
#. Naam van wie er praat (Gesprek olav_menu)
#. Naam van wie er praat (Gesprek olav_dorp)
#. Naam van wie er praat (Gesprek olav_altaar)
#. Naam van wie er praat (Gesprek olav_kristal)
#: scripts/data/ext/sneeuw.gd:137 scripts/data/ext/sneeuw.gd:143 scripts/data/ext/sneeuw.gd:152 scripts/data/ext/sneeuw.gd:153
msgid "Olav"
msgstr "Olav"

#. Gesprek olav_intro, Olav zegt
#: scripts/data/ext/sneeuw.gd:138
msgid "Ah, een nieuw gezicht bij het altaar. Ik ben Olav. Ik bewaar de kaarten van het noorden."
msgstr "Ah, a new face at the altar. I am Olav. I keep the maps of the north."

#. Gesprek olav_intro, Olav zegt
#: scripts/data/ext/sneeuw.gd:138
msgid "IJsdal staat op geen enkele oude kaart. Wij vonden het toen de sneeuw ons hier dreef."
msgstr "IJsdal is on no old map. We found it when the snow drove us here."

#. Gesprek olav_menu, Olav zegt
#: scripts/data/ext/sneeuw.gd:144
msgid "Wat wil je weten van het noorden?"
msgstr "What do you want to know about the north?"

#. Gesprek olav_menu: keuze van de speler
#: scripts/data/ext/sneeuw.gd:146
msgid "Over IJsdal."
msgstr "About IJsdal."

#. Gesprek olav_menu: keuze van de speler
#: scripts/data/ext/sneeuw.gd:147
msgid "Over het altaar."
msgstr "About the altar."

#. Gesprek olav_menu: keuze van de speler
#: scripts/data/ext/sneeuw.gd:148
msgid "Over het ijskristal."
msgstr "About the ice crystal."

#. Gesprek olav_dorp, Olav zegt
#: scripts/data/ext/sneeuw.gd:152
msgid "IJsdal leeft van de mijn en de kruiden. De sneeuw geeft en de sneeuw neemt."
msgstr "IJsdal lives off the mine and the herbs. The snow gives and the snow takes."

#. Gesprek olav_dorp, Olav zegt
#: scripts/data/ext/sneeuw.gd:152
msgid "Het meer is dichtgevroren. De vissen slapen eronder tot de lente, zeggen ze."
msgstr "The lake has frozen over. The fish sleep beneath it until spring, they say."

#. Gesprek olav_altaar, Olav zegt
#: scripts/data/ext/sneeuw.gd:153
msgid "Het blauwe altaar hier is ouder dan het dorp. Raak het aan en je reist ermee naar elk altaar dat je kent."
msgstr "The blue altar here is older than the village. Touch it and you can travel to any altar you know."

#. Gesprek olav_altaar, Olav zegt
#: scripts/data/ext/sneeuw.gd:153
msgid "Handig, als je ten zuiden weer groen gras wilt zien."
msgstr "Handy, when you want to see green grass in the south again."

#. Gesprek olav_kristal, Olav zegt
#: scripts/data/ext/sneeuw.gd:154
msgid "In de mijnhoek groeit ijskristal: koud, helder en harder dan koper."
msgstr "Ice crystal grows in the mine corner: cold, clear and harder than copper."

#. Gesprek olav_kristal, Olav zegt
#: scripts/data/ext/sneeuw.gd:154
msgid "Je hebt er een koperen pikhouweel en wat mijnservaring voor nodig. Alchemisten betalen goed."
msgstr "You need a copper pickaxe and some mining experience for it. Alchemists pay well."

#. Naam van wie er praat (Gesprek jelle_intro)
#. Naam van wie er praat (Gesprek jelle_vraag)
#. Naam van wie er praat (Gesprek jelle_ok)
#. Naam van wie er praat (Gesprek jelle_menu)
#. Naam van wie er praat (Gesprek jelle_klaar)
#: scripts/data/ext/dorst.gd:144 scripts/data/ext/dorst.gd:150 scripts/data/ext/dorst.gd:157 scripts/data/ext/dorst.gd:158
msgid "Jelle"
msgstr "Jelle"

#. Gesprek jelle_intro, Jelle zegt
#: scripts/data/ext/dorst.gd:145
msgid "Vreemdeling! Welkom in de Dorstvallei. Ik ben Jelle; ik handel in vellen en vlees."
msgstr "Stranger! Welcome to Dorstvallei. I am Jelle; I trade in hides and meat."

#. Gesprek jelle_intro, Jelle zegt
#: scripts/data/ext/dorst.gd:145
msgid "De vossen hier hebben de zachtste vacht van het land. Maar vangen... dat is een ander verhaal."
msgstr "The foxes here have the softest coats in the land. But catching them... that's another story."

#. Gesprek jelle_vraag, Jelle zegt
#: scripts/data/ext/dorst.gd:151
msgid "Wil je voor me jagen? Breng me 2 dierenvachten en 2 stukken rauw vlees van het wild hier."
msgstr "Will you hunt for me? Bring me 2 hides and 2 pieces of raw meat from the game here."

#. Gesprek jelle_vraag: keuze van de speler
#: scripts/data/ext/dorst.gd:153
msgid "Ik ga op jacht."
msgstr "I'll go hunting."

#. Gesprek jelle_ok, Jelle zegt
#: scripts/data/ext/dorst.gd:157
msgid "Mooi. De vossen zitten in het oosten, de hazen in het zuiden. Ze rennen weg als je te dichtbij komt, dus zet aan met een sprint. Of neem een boog mee."
msgstr "Good. The foxes are in the east, the hares in the south. They bolt when you get close, so charge with a sprint. Or bring a bow."

#. Gesprek jelle_menu, Jelle zegt
#: scripts/data/ext/dorst.gd:158
msgid "Heb je de vellen en het vlees al?"
msgstr "Do you have the hides and the meat yet?"

#. Gesprek jelle_klaar, Jelle zegt
#: scripts/data/ext/dorst.gd:161
msgid "Ah, prachtig spul! Zulke vellen zie je zelden."
msgstr "Ah, fine goods! You rarely see hides like these."

#. Gesprek jelle_klaar, Jelle zegt
#: scripts/data/ext/dorst.gd:161
msgid "Hier, je deel van de opbrengst. En een braadstuk van mijn eigen voorraad, je hebt het verdiend."
msgstr "Here, your share of the proceeds. And a roast from my own stock, you've earned it."

#. Gesprek sana_intro, Sana zegt
#: scripts/data/ext/dorst.gd:167
msgid "Welkom bij de oase, reiziger. Ik ben Sana. Dit water is het hart van de vallei."
msgstr "Welcome to the oasis, traveller. I am Sana. This water is the heart of the valley."

#. Gesprek sana_intro, Sana zegt
#: scripts/data/ext/dorst.gd:167
msgid "Ik maak koele drankjes van cactusvijgen. Zoet, en je houdt er de hitte mee uit."
msgstr "I make cool drinks from cactus figs. Sweet, and they keep the heat at bay."

#. Gesprek sana_vraag, Sana zegt
#: scripts/data/ext/dorst.gd:174
msgid "Meer vijgen helpen niet zolang de bron achter het zand dichtzit. Wil je de oude waterroute onderzoeken? Nour heeft een waterzak klaargelegd bij de blauwe luifel naast mij."
msgstr "More figs won't help while the spring behind the sand is blocked. Will you investigate the old water route? Nour left a waterskin at the blue shelter beside me."

#. Gesprek sana_vraag: keuze van de speler
#: scripts/data/ext/dorst.gd:178
msgid "Ik zoek de bron."
msgstr "I'll find the spring."

#. Gesprek sana_ok, Sana zegt
#: scripts/data/ext/dorst.gd:195
msgid "Vul eerst de waterzak naast mij. Zoek daarna de opening in de noordelijke zandsteenwand, rechts van de oase. Rust onder blauwe luifels en vul daar gratis bij."
msgstr "First fill the waterskin beside me. Then find the opening in the northern sandstone wall, to the right of the oasis. Rest under blue shelters and refill there for free."

#. Gesprek sana_menu, Sana zegt
#: scripts/data/ext/dorst.gd:207
msgid "Volg de blauwe luifels in de Zonnekloof naar de oude bron. De ingang ligt in de noordelijke zandsteenwand, rechts van de oase."
msgstr "Follow the blue shelters in the Sun Gorge to the old spring. The entrance is in the northern sandstone wall, to the right of the oasis."

#. Gesprek sana_menu: keuze van de speler
#: scripts/data/ext/dorst.gd:211
msgid "Ik ga kijken."
msgstr "I'll take a look."

#. Gesprek sana_klaar, Sana zegt
#: scripts/data/ext/dorst.gd:221
msgid "Ik hoor het water alweer! Je hebt de bron teruggevonden. De oase krijgt genoeg, en jouw aftakking helpt de rest van de vallei."
msgstr "I can hear the water again! You found the spring. The oasis gets enough, and your branch helps the rest of the valley."

#. Gesprek sana_klaar, Sana zegt
#: scripts/data/ext/dorst.gd:222
msgid "Neem mijn zandbalsem mee voor je volgende reis."
msgstr "Take my sand balm for your next journey."

#. Naam van wie er praat (Gesprek nour_intro)
#. Naam van wie er praat (Gesprek nour_menu)
#. Naam van wie er praat (Gesprek nour_oase)
#. Naam van wie er praat (Gesprek nour_wild)
#. Naam van wie er praat (Gesprek nour_hitte)
#: scripts/data/ext/dorst.gd:248 scripts/data/ext/dorst.gd:254 scripts/data/ext/dorst.gd:263 scripts/data/ext/dorst.gd:264
msgid "Nour"
msgstr "Nour"

#. Gesprek nour_intro, Nour zegt
#: scripts/data/ext/dorst.gd:249
msgid "Ah, iemand van over de heuvelrug. Ik ben Nour; ik gids reizigers door het zand."
msgstr "Ah, someone from beyond the ridge. I am Nour; I guide travellers through the sand."

#. Gesprek nour_intro, Nour zegt
#: scripts/data/ext/dorst.gd:249
msgid "De Dorstvallei is hard maar eerlijk. De oase geeft water, de cactus geeft fruit, het wild geeft vlees."
msgstr "Dorstvallei is harsh but fair. The oasis gives water, the cactus gives fruit, the game gives meat."

#. Gesprek nour_menu, Nour zegt
#: scripts/data/ext/dorst.gd:255
msgid "Wat wil je weten van de vallei?"
msgstr "What do you want to know about the valley?"

#. Gesprek nour_menu: keuze van de speler
#: scripts/data/ext/dorst.gd:257
msgid "Over de oase."
msgstr "About the oasis."

#. Gesprek nour_menu: keuze van de speler
#: scripts/data/ext/dorst.gd:258
msgid "Over het wild."
msgstr "About the game."

#. Gesprek nour_menu: keuze van de speler
#: scripts/data/ext/dorst.gd:259
msgid "Over de hitte."
msgstr "About the heat."

#. Gesprek nour_menu: keuze van de speler
#. Gesprek wouda_menu: keuze van de speler
#: scripts/data/ext/dorst.gd:260 scripts/data/ext/moeras.gd:197
msgid "Een andere keer."
msgstr "Another time."

#. Gesprek nour_oase, Nour zegt
#: scripts/data/ext/dorst.gd:263
msgid "De oase is ouder dan elk dorp in het westen. Zonder dit water was hier alleen zand geweest."
msgstr "The oasis is older than any village in the west. Without this water there would be only sand."

#. Gesprek nour_oase, Nour zegt
#: scripts/data/ext/dorst.gd:263
msgid "Sana waakt erover. Pluk gerust vijgen, maar laat het water met rust."
msgstr "Sana watches over it. Pick figs as you like, but leave the water be."

#. Gesprek nour_wild, Nour zegt
#: scripts/data/ext/dorst.gd:264
msgid "De vossen en hazen zijn schuw, niet gevaarlijk. Kom je te dichtbij, dan verdwijnen ze als een stofwolk."
msgstr "The foxes and hares are shy, not dangerous. Get too close and they vanish like a dust cloud."

#. Gesprek nour_wild, Nour zegt
#: scripts/data/ext/dorst.gd:264
msgid "Jelle betaalt goed voor vel en vlees. En met een boog haal je ze neer voordat ze weg zijn."
msgstr "Jelle pays well for hide and meat. And with a bow you take them down before they bolt."

#. Gesprek nour_hitte, Nour zegt
#: scripts/data/ext/dorst.gd:268
msgid "Bij Sana staat mijn blauwe waterpunt. Neem gratis een waterzak mee voor de Zonnekloof. Je drinkt daar vanzelf; onder blauwe luifels kun je hem hervullen."
msgstr "My blue water station is beside Sana. Take a free waterskin for the Sun Gorge. You drink automatically there; refill it under the blue shelters."

#. Gesprek nour_hitte, Nour zegt
#: scripts/data/ext/dorst.gd:269
msgid "Zonder water keer je terug naar je laatste schuilplek. Je verliest geen spullen of hartjes. De bron ligt achterin de kloof."
msgstr "Without water, you return to your last shelter. You lose no items or hearts. The spring is at the far end of the gorge."

#. Naam van wie er praat (Gesprek vera_intro)
#. Naam van wie er praat (Gesprek vera_menu)
#. Naam van wie er praat (Gesprek vera_verf)
#: scripts/data/ext/uiterlijk.gd:250 scripts/data/ext/uiterlijk.gd:260 scripts/data/ext/uiterlijk.gd:269
msgid "Vera"
msgstr "Vera"

#. Gesprek vera_intro, Vera zegt
#: scripts/data/ext/uiterlijk.gd:252
msgid "Ah, een nieuw gezicht! Ik ben Vera, kleermaakster van Dageraadsdorp."
msgstr "Ah, a new face! I'm Vera, the tailor of Daybreak Village."

#. Gesprek vera_intro, Vera zegt
#: scripts/data/ext/uiterlijk.gd:253
msgid "Ik maak kleding die je gewoon óver je uitrusting draagt. Geen gedoe met omkleden: het gaat er zo overheen."
msgstr "I make clothing you simply wear over your equipment. No fussing with changing clothes: it goes right on top."

#. Gesprek vera_intro, Vera zegt
#: scripts/data/ext/uiterlijk.gd:254
msgid "En met mijn verfpotten maak je elk stuk in de kleur die jij mooi vindt. Kijk maar in het tabblad Uiterlijk van je menu!"
msgstr "And with my dye pots you can make every piece any color you like. Just look at the Appearance tab in your menu!"

#. Gesprek vera_menu, Vera zegt
#: scripts/data/ext/uiterlijk.gd:261
msgid "Zeg het maar, mag het een beetje kleur zijn?"
msgstr "Tell me, can I interest you in a little color?"

#. Gesprek vera_menu: keuze van de speler
#: scripts/data/ext/uiterlijk.gd:263
msgid "Ik wil kleding kopen."
msgstr "I want to buy clothing."

#. Gesprek vera_menu: keuze van de speler
#: scripts/data/ext/uiterlijk.gd:264
msgid "Hoe werkt het verven?"
msgstr "How does dyeing work?"

#. Gesprek vera_verf, Vera zegt
#: scripts/data/ext/uiterlijk.gd:271
msgid "Open je menu en ga naar het tabblad Uiterlijk. Daar trek je een kledingstuk aan en kies je er een verfkleur bij — twintig potten heb ik inmiddels op voorraad."
msgstr "Open your menu and go to the Appearance tab. There you put on a piece of clothing and pick a dye colour — I have twenty pots in stock by now."

#. Gesprek vera_verf, Vera zegt
#: scripts/data/ext/uiterlijk.gd:272
msgid "Je haar en je ogen kun je daar trouwens ook helemaal veranderen. Vijfenveertig kapsels! Ik knip ze allemaal zelf."
msgstr "You can change your hair and your eyes there too, by the way. Forty-five haircuts! I cut them all myself."

#. Naam van wie er praat (Gesprek stien_intro)
#. Naam van wie er praat (Gesprek stien_vraag)
#. Naam van wie er praat (Gesprek stien_ok)
#. Naam van wie er praat (Gesprek stien_menu)
#. Naam van wie er praat (Gesprek stien_klaar)
#: scripts/data/ext/moeras.gd:91 scripts/data/ext/moeras.gd:97 scripts/data/ext/moeras.gd:104 scripts/data/ext/moeras.gd:105
msgid "Stien"
msgstr "Stien"

#. Gesprek stien_intro, Stien zegt
#: scripts/data/ext/moeras.gd:92
msgid "Hé daar, oppassen waar je loopt! De turfvelden verrassen je, voor je het weet zak je tot je enkels."
msgstr "Hey there, watch your step! The peat fields catch you off guard; before you know it you sink to your ankles."

#. Gesprek stien_intro, Stien zegt
#: scripts/data/ext/moeras.gd:92
msgid "Ik ben Stien. Ik steek turf, zodat het dorp warm blijft in de winter."
msgstr "I am Stien. I cut peat, so the village stays warm in winter."

#. Gesprek stien_vraag, Stien zegt
#: scripts/data/ext/moeras.gd:98
msgid "Ik werk hier van ochtend tot avond en vergeet steeds te eten. Pluk je 5 veenbessen voor me? Dan maak ik mijn beroemde veenbespap."
msgstr "I work here from dawn to dusk and keep forgetting to eat. Will you pick 5 cranberries for me? Then I will make my famous cranberry porridge."

#. Gesprek stien_vraag, Stien zegt
#: scripts/data/ext/moeras.gd:98
msgid "Ze groeien laag bij de plassen; zoek de rode stipjes tussen het groen."
msgstr "They grow low near the pools; look for the red dots among the green."

#. Gesprek stien_vraag: keuze van de speler
#: scripts/data/ext/moeras.gd:100
msgid "Ik pluk ze voor je."
msgstr "I will pick them for you."

#. Gesprek stien_vraag: keuze van de speler
#: scripts/data/ext/moeras.gd:101
msgid "Nu even niet."
msgstr "Not right now."

#. Gesprek stien_ok, Stien zegt
#: scripts/data/ext/moeras.gd:104
msgid "Lekker bezig. En als je een vors hoort kwaken, kwak maar terug. Werkt altijd."
msgstr "Good going. And if you hear a toad croak, just croak back. Always works."

#. Gesprek stien_menu, Stien zegt
#: scripts/data/ext/moeras.gd:105
msgid "Heb je de veenbessen al? Mijn maag knort luider dan de vorsten."
msgstr "Got the cranberries yet? My stomach growls louder than the toads."

#. Gesprek stien_klaar, Stien zegt
#: scripts/data/ext/moeras.gd:108
msgid "Oooh, prachtige bessen! Zo rood als de zon achter de wilgen."
msgstr "Oooh, beautiful berries! Red as the sun behind the willows."

#. Gesprek stien_klaar, Stien zegt
#: scripts/data/ext/moeras.gd:108
msgid "Hier, een klomp ijzeroer uit mijn veld. En een paar munten; een deal is een deal."
msgstr "Here, a lump of bog iron from my field. And some coins; a deal is a deal."

#. Naam van wie er praat (Gesprek mees_intro)
#. Naam van wie er praat (Gesprek mees_vraag)
#. Naam van wie er praat (Gesprek mees_ok)
#. Naam van wie er praat (Gesprek mees_menu)
#. Naam van wie er praat (Gesprek mees_klaar)
#: scripts/data/ext/moeras.gd:113 scripts/data/ext/moeras.gd:126 scripts/data/ext/moeras.gd:144 scripts/data/ext/moeras.gd:145
msgid "Mees"
msgstr "Mees"

#. Gesprek mees_intro, Mees zegt
#: scripts/data/ext/moeras.gd:115
msgid "De westelijke oversteek is gebroken. Kijk bij de lier naast het eiland: eerst de sluizen goed zetten, dan repareren. Bouw, brouw, of neem de gevaarlijke route langs de bewakers."
msgstr "The western crossing is broken. Look at the winch beside the island: set the sluices first, then repair it. Build, brew, or take the dangerous route past the guardians."

#. Gesprek mees_vraag, Mees zegt
#: scripts/data/ext/moeras.gd:127
msgid "Help je de oversteek herstellen?"
msgstr "Will you help restore the crossing?"

#. Gesprek mees_vraag: keuze van de speler
#: scripts/data/ext/moeras.gd:130
msgid "Ik herstel de oversteek."
msgstr "I will restore the crossing."

#. Gesprek mees_ok, Mees zegt
#. Gesprek mees_menu, Mees zegt
#: scripts/data/ext/moeras.gd:144 scripts/data/ext/moeras.gd:145
msgid "De lier staat ten westen van het eiland. Zet de westelijke sluis open en de oostelijke dicht. Brugonderdelen, levende hars of de bewaakte lier helpen je daarna verder."
msgstr "The winch is west of the island. Open the western sluice and close the eastern one. Then use bridge components, living resin or the guarded winch."

#. Gesprek mees_klaar, Mees zegt
#: scripts/data/ext/moeras.gd:149
msgid "Stien brengt haar turf alweer over de brug. Met het lage water is ook het Rietarchief open. Ik leer je nu hoe je een lichte verkennersjas maakt."
msgstr "Stien is carrying peat across the bridge again. The low water has also opened the Reed Archive. I will teach you to make a lightweight scout coat."

#. Naam van wie er praat (Gesprek wouda_intro)
#. Naam van wie er praat (Gesprek wouda_vraag)
#. Naam van wie er praat (Gesprek wouda_ok)
#. Naam van wie er praat (Gesprek wouda_menu)
#. Naam van wie er praat (Gesprek wouda_amulet)
#. Naam van wie er praat (Gesprek wouda_kruiden)
#: scripts/data/ext/moeras.gd:177 scripts/data/ext/moeras.gd:183 scripts/data/ext/moeras.gd:190 scripts/data/ext/moeras.gd:192
msgid "Wouda"
msgstr "Wouda"

#. Gesprek wouda_intro, Wouda zegt
#: scripts/data/ext/moeras.gd:178
msgid "Ah... een wandelaar uit het noorden. Ik ben Wouda; het moeras kent mij en ik ken het moeras."
msgstr "Ah... a wanderer from the north. I am Wouda; the swamp knows me and I know the swamp."

#. Gesprek wouda_intro, Wouda zegt
#: scripts/data/ext/moeras.gd:178
msgid "Weet je wat dit land ooit was? De zilverzijde van het meer. De zon lag hier op het water en de schijf werd aanbeden."
msgstr "Do you know what this land once was? The silver side of the lake. The sun lay on this water and the disk was worshipped."

#. Gesprek wouda_intro, Wouda zegt
#: scripts/data/ext/moeras.gd:178
msgid "Toen zakte de grond, steeg het veen, en verdween de tempel onder de drijfmest."
msgstr "Then the ground sank, the peat rose, and the temple vanished under the quickmire."

#. Gesprek wouda_vraag, Wouda zegt
#: scripts/data/ext/moeras.gd:184
msgid "Op het eilandje in de grote plas ligt nog het zonneschijfamulet, het laatste stuk van die oude wereld."
msgstr "On the islet in the great pool still lies the sun disk amulet, the last piece of that old world."

#. Gesprek wouda_vraag, Wouda zegt
#: scripts/data/ext/moeras.gd:184
msgid "De loopbruggen houden je droog... meestal. Haal het voor me, dan vertel ik je wat de Diepte met dit alles te maken heeft."
msgstr "The footbridges keep you dry... mostly. Fetch it for me, and I will tell you what the Depths have to do with all this."

#. Gesprek wouda_vraag: keuze van de speler
#: scripts/data/ext/moeras.gd:186
msgid "Ik zoek het amulet."
msgstr "I will find the amulet."

#. Gesprek wouda_vraag: keuze van de speler
#: scripts/data/ext/moeras.gd:187
msgid "Dat klinkt gevaarlijk."
msgstr "That sounds dangerous."

#. Gesprek wouda_ok, Wouda zegt
#: scripts/data/ext/moeras.gd:190
msgid "Volg de modderpaden naar het hart van het veen. Het eiland wacht al honderd jaar; hij wacht jou ook wel af."
msgstr "Follow the mud paths to the heart of the peat. The island has waited a hundred years; it will wait for you too."

#. Gesprek wouda_menu, Wouda zegt
#: scripts/data/ext/moeras.gd:193
msgid "Het moeras ademt, hoor je dat? Vraag maar wat je wilt weten."
msgstr "The swamp breathes, do you hear it? Ask whatever you want to know."

#. Gesprek wouda_menu: keuze van de speler
#: scripts/data/ext/moeras.gd:195
msgid "Over het amulet."
msgstr "About the amulet."

#. Gesprek wouda_menu: keuze van de speler
#: scripts/data/ext/moeras.gd:196
msgid "Over de kruiden hier."
msgstr "About the herbs here."

#. Gesprek wouda_amulet, Wouda zegt
#: scripts/data/ext/moeras.gd:200
msgid "Het amulet ligt op het eilandje, midden in de drijfmestplas. Over de loopbruggen kom je er."
msgstr "The amulet lies on the islet, in the middle of the quickmire pool. The footbridges get you there."

#. Gesprek wouda_amulet, Wouda zegt
#: scripts/data/ext/moeras.gd:200
msgid "Het is goud dat nooit roestte, omdat het de zon zelf bewaarde. Dat zeggen ze tenminste."
msgstr "It is gold that never rusted, because it kept the sun itself. That is what they say, anyway."

#. Gesprek wouda_kruiden, Wouda zegt
#: scripts/data/ext/moeras.gd:201
msgid "Watermunt langs de paden, veenbessen bij de plassen. En diep in de turf zit ijzeroer, het bloed van het veen."
msgstr "Water mint along the paths, cranberries near the pools. And deep in the peat sits bog iron, the blood of the moor."

#. Gesprek wouda_kruiden, Wouda zegt
#: scripts/data/ext/moeras.gd:201
msgid "Met munt en bes brouw ik een elixer dat je benen nieuw leven geeft. De bibliotheek heeft het fornuis ervoor."
msgstr "With mint and berry I brew an elixir that gives your legs new life. The library has the stove for it."

#. Gesprek wouda_klaar, Wouda zegt
#: scripts/data/ext/moeras.gd:204
msgid "De zonneschijf... honderd jaar veen en hij gloeit nog. Voel je dat? Warm."
msgstr "The sun disk... a hundred years of peat and it still glows. Do you feel that? Warm."

#. Gesprek wouda_klaar, Wouda zegt
#: scripts/data/ext/moeras.gd:204
msgid "De Diepte onder de grot en dit moeras zijn zussen: waar het water de wereld opslokte, bleef het licht in kleine dingen wonen."
msgstr "The Depths below the cave and this swamp are sisters: where water swallowed the world, the light lived on in little things."

#. Gesprek wouda_klaar, Wouda zegt
#: scripts/data/ext/moeras.gd:204
msgid "Neem mijn moeraselixer mee. En kom terug als het veen je weer roept."
msgstr "Take my swamp elixir. And come back when the moor calls you again."

#. Naam van wie er praat (Gesprek lw_core)
#: scripts/entities/living_object.gd:43 scripts/data/ext/living.gd:138
msgid "Prismakern"
msgstr "Prism core"

#. Gesprek lw_core, Prismakern zegt
#: scripts/data/ext/living.gd:140
msgid "De spiegels voeden de kern. De bewakers reageren op elke poging hem los te maken. Hoe wil je hem stabiliseren?"
msgstr "The mirrors feed the core. Its guardians react to any attempt to free it. How will you stabilize it?"

#. Gesprek lw_core: keuze van de speler
#: scripts/data/ext/living.gd:144
msgid "Ik neem het op tegen de bewakers."
msgstr "I will face the guardians."

#. Gesprek lw_core: keuze van de speler
#: scripts/data/ext/living.gd:153
msgid "Gebruik aardingspoeder (1)."
msgstr "Use grounding powder (1)."

#. Gesprek lw_core: keuze van de speler
#: scripts/data/ext/living.gd:169
msgid "Eerst voorbereiden."
msgstr "Prepare first."

#. Gesprek lw_forge, Greta zegt
#: scripts/data/ext/living.gd:176
msgid "De werkplaats leeft weer! Je derde comboslag kan nu een schild breken. Maak hier ook een lantaarn voor Mira."
msgstr "The workshop is alive again! Your third combo strike can now break a shield. You can also make a lantern for Mira here."

#. Gesprek lw_forge: keuze van de speler
#: scripts/data/ext/living.gd:180
msgid "Monteer mijn lantaarn (40 munten)."
msgstr "Assemble my lantern (40 coins)."

#. Gesprek lw_forge: keuze van de speler
#: scripts/data/ext/living.gd:205
msgid "Ik maak hem zelf via Beroepen → Maken."
msgstr "I will craft it myself via Professions → Craft."

#. Naam van wie er praat (Gesprek lw_bridge)
#: scripts/entities/living_object.gd:48 scripts/data/ext/living.gd:210
msgid "De oude lier"
msgstr "The old winch"

#. Gesprek lw_bridge, De oude lier zegt
#: scripts/data/ext/living.gd:212
msgid "De oversteek brak door de waterdruk. West open, oost dicht: zo voert het water veilig af. Onderzoek beide sluizen vóór de reparatie."
msgstr "Water pressure broke the crossing. West open, east closed: that drains the water safely. Inspect both sluices before repairing it."

#. Gesprek lw_bridge: keuze van de speler
#: scripts/data/ext/living.gd:216
msgid "Plaats brugonderdelen (1)."
msgstr "Fit bridge components (1)."

#. Gesprek lw_bridge: keuze van de speler
#: scripts/data/ext/living.gd:232
msgid "Verbind het hout met levende hars (1)."
msgstr "Bind the timber with living resin (1)."

#. Gesprek lw_bridge: keuze van de speler
#: scripts/data/ext/living.gd:248
msgid "Gebruik de lier; verjaag de bewakers."
msgstr "Use the winch; drive off its guardians."

#. Gesprek lw_bridge: keuze van de speler
#: scripts/data/ext/living.gd:257
msgid "Ik bekijk eerst de sluizen."
msgstr "I will inspect the sluices first."

#. Naam van wie er praat (Gesprek lw_heat)
#: scripts/data/ext/living.gd:262
msgid "Verlaten vuurkorf"
msgstr "Abandoned brazier"

#. Gesprek lw_heat, Verlaten vuurkorf zegt
#: scripts/data/ext/living.gd:264
msgid "Blijf bij de korf terwijl hij twintig seconden opwarmt. Vijanden vlak bij de vlam houden de opwarming tegen. Versla alle aanvallers om het huis veilig te maken."
msgstr "Stay near the brazier as it warms up for twenty seconds. Enemies next to the flame stop it warming. Defeat all attackers to secure the house."

#. Gesprek lw_heat: keuze van de speler
#: scripts/data/ext/living.gd:268
msgid "Gebruik drie takken."
msgstr "Use three branches."

#. Gesprek lw_heat: keuze van de speler
#: scripts/data/ext/living.gd:284
msgid "Gebruik een wintergloed."
msgstr "Use a winter glow."

#. Gesprek lw_heat: keuze van de speler
#: scripts/data/ext/living.gd:300
msgid "Gebruik de herstelde prismatechniek."
msgstr "Use the restored prism technology."

#. Gesprek lw_heat: keuze van de speler
#: scripts/data/ext/living.gd:315
msgid "Ik kom voorbereid terug."
msgstr "I will return prepared."

#. Naam van wie er praat (Gesprek rf_inscription)
#: scripts/entities/route_object.gd:50 scripts/data/ext/first_route.gd:14
msgid "Wilfreds gedenksteen"
msgstr "Wilfred's Memorial"

#. Gesprek rf_inscription, Wilfreds gedenksteen zegt
#: scripts/data/ext/first_route.gd:14
msgid "Het wachtersboek en het reliëf vertellen hetzelfde: Wilfred bleef bij de poort zodat anderen de grot konden bereiken. Wat schrijf je op de steen?"
msgstr "The guardbook and relief tell the same story: Wilfred stayed at the gate so others could reach the cave. What will you inscribe?"

#. Gesprek rf_inscription: keuze van de speler
#: scripts/data/ext/first_route.gd:15
msgid "De bewaker die bleef."
msgstr "The guard who stayed."

#. Gesprek rf_inscription: keuze van de speler
#: scripts/data/ext/first_route.gd:16
msgid "De gids die anderen liet ontsnappen."
msgstr "The guide who helped others escape."

#. Gesprek rf_inscription: keuze van de speler
#: scripts/data/ext/first_route.gd:17
msgid "Ik wil er nog over nadenken."
msgstr "I want to think about it."

#. Naam van personage greta (boven zijn hoofd)
#: scripts/data/npcs.gd:20
msgid "Greta de smid"
msgstr "Greta the Smith"

#. Naam van personage tobias (boven zijn hoofd)
#: scripts/data/npcs.gd:31
msgid "Tobias de koopman"
msgstr "Tobias the Merchant"

#. Naam van personage mila (boven zijn hoofd)
#: scripts/data/npcs.gd:39
msgid "Mila de herbergierster"
msgstr "Mila the Innkeeper"

#. Naam van personage tessa (boven zijn hoofd)
#: scripts/data/ext/boog.gd:51
msgid "Tessa de boogschutter"
msgstr "Tessa the Archer"

#. Naam van personage meer_lena (boven zijn hoofd)
#: scripts/data/ext/meer.gd:137
msgid "Lena de bibliothecaresse"
msgstr "Lena the Librarian"

#. Naam van personage lotte (boven zijn hoofd)
#: scripts/data/ext/polijst.gd:73
msgid "Lotte de lantaarnmaker"
msgstr "Lotte the Lantern Maker"

#. Naam van personage kasper (boven zijn hoofd)
#: scripts/data/ext/polijst.gd:82
msgid "Kasper de handelaar"
msgstr "Kasper the Trader"

#. Naam van personage elke (boven zijn hoofd)
#: scripts/data/ext/polijst.gd:89
msgid "Elke de kruidenier"
msgstr "Elke the Herbalist"

#. Naam van personage willem (boven zijn hoofd)
#: scripts/data/ext/polijst.gd:98
msgid "Willem de verhalenverteller"
msgstr "Willem the Storyteller"

#. Naam van personage mira (boven zijn hoofd)
#: scripts/data/ext/polijst.gd:105
msgid "Mira de dauwbewaarder"
msgstr "Mira the Dew Keeper"

#. Naam van personage tomas (boven zijn hoofd)
#: scripts/data/ext/polijst.gd:118
msgid "Tomas de oude"
msgstr "Old Tomas"

#. Naam van personage noor (boven zijn hoofd)
#: scripts/data/ext/polijst.gd:125
msgid "Noor de verzamelaar"
msgstr "Noor the Collector"

#. Naam van personage fenna (boven zijn hoofd)
#: scripts/data/ext/sneeuw.gd:28
msgid "Fenna de kruidenvrouwe"
msgstr "Fenna the herbalist"

#. Naam van personage roos (boven zijn hoofd)
#: scripts/data/ext/sneeuw.gd:37
msgid "Roos de jageres"
msgstr "Roos the huntress"

#. Naam van personage olav (boven zijn hoofd)
#: scripts/data/ext/sneeuw.gd:46
msgid "Olav de kaartenbewaarder"
msgstr "Olav the map keeper"

#. Naam van personage jelle (boven zijn hoofd)
#: scripts/data/ext/dorst.gd:78
msgid "Jelle de vellenhandelaar"
msgstr "Jelle the hide trader"

#. Naam van personage sana (boven zijn hoofd)
#: scripts/data/ext/dorst.gd:87
msgid "Sana van de oase"
msgstr "Sana of the oasis"

#. Naam van personage nour (boven zijn hoofd)
#: scripts/data/ext/dorst.gd:134
msgid "Nour de woestijngids"
msgstr "Nour the desert guide"

#. Naam van personage vera (boven zijn hoofd)
#: scripts/data/ext/uiterlijk.gd:240
msgid "Vera de kleermaakster"
msgstr "Vera the tailor"

#. Naam van personage stien (boven zijn hoofd)
#: scripts/data/ext/moeras.gd:61
msgid "Stien de turfsterke"
msgstr "Stien the peat cutter"

#. Naam van personage mees (boven zijn hoofd)
#: scripts/data/ext/moeras.gd:70
msgid "Mees de rietvlechter"
msgstr "Mees the reed weaver"

#. Naam van personage wouda (boven zijn hoofd)
#: scripts/data/ext/moeras.gd:79
msgid "Wouda de kruidenheks"
msgstr "Wouda the herb witch"

#. Titel van opdracht main
#. Titel van boek blauwe_kaart (bibliotheek)
#: scripts/data/quests.gd:10 scripts/data/ext/meer_boeken.gd:17
msgid "De Blauwe Kaart"
msgstr "The Blue Map"

#. Opdracht main, stap 1
#: scripts/data/quests.gd:14
msgid "Vind de drie kaartkristallen: in het Fluisterbos, de Vergeten Ruïne en de Echo-grot. ({crystals}/3)"
msgstr "Find the three map crystals: in the Whispering Woods, the Forgotten Ruins and the Echo Cave. ({crystals}/3)"

#. Opdracht main, stap 2
#: scripts/data/quests.gd:17
msgid "Breng de kristallen naar Oudste Bram bij de tempel."
msgstr "Bring the crystals to Elder Bram at the temple."

#. Opdracht main, stap 3
#: scripts/data/quests.gd:18
msgid "Versla de Slijmkoning in de Kristaltempel (de deur in het dorp staat nu open)."
msgstr "Defeat the Slime King in the Crystal Temple (the door in the village is open now)."

#. Titel van opdracht kat
#: scripts/data/quests.gd:22
msgid "Muis de kat"
msgstr "Mouse the Cat"

#. Opdracht kat, stap 1
#: scripts/data/quests.gd:25
msgid "Pim mist zijn kat Muis. Zoek haar in het Fluisterbos."
msgstr "Pim misses his cat Mouse. Look for her in the Whispering Woods."

#. Opdracht kat, stap 2
#: scripts/data/quests.gd:28
msgid "Muis is gevonden! Vertel het aan Pim in het dorp."
msgstr "Mouse has been found! Tell Pim in the village."

#. Titel van opdracht medaillon
#: scripts/data/quests.gd:32
msgid "Het medaillon van Wilfred"
msgstr "Wilfred's Medallion"

#. Opdracht medaillon, stap 1
#: scripts/data/quests.gd:35
msgid "Wilfred, de geest in de Ruïne, zoekt zijn medaillon. Het ligt ergens in de Echo-grot."
msgstr "Wilfred, the ghost in the Ruins, is looking for his medallion. It's somewhere in the Echo Cave."

#. Opdracht medaillon, stap 2
#: scripts/data/quests.gd:38
msgid "Breng het medaillon naar Wilfred in de Vergeten Ruïne."
msgstr "Bring the medallion to Wilfred in the Forgotten Ruins."

#. Titel van opdracht drank
#: scripts/data/quests.gd:42
msgid "Slijmgel voor Mila"
msgstr "Slime Gel for Mila"

#. Opdracht drank, stap 1
#: scripts/data/quests.gd:45
msgid "Mila wil drankjes brouwen. Breng haar 5 slijmgel. ({gel}/5)"
msgstr "Mila wants to brew potions. Bring her 5 Slime Gel. ({gel}/5)"

#. Opdracht drank, stap 2
#: scripts/data/quests.gd:48
msgid "Geef de slijmgel aan Mila in de herberg."
msgstr "Give the Slime Gel to Mila at the inn."

#. Titel van opdracht ad_message
#: scripts/data/ext/coastal_adventures.gd:7
msgid "Een bericht zonder afzender"
msgstr "A Message Without a Sender"

#. Opdracht ad_message, stap 1
#: scripts/data/ext/coastal_adventures.gd:7
msgid "Lees het aangespoelde logboek op Meeuweneiland. Bekijk de breuksporen aan het eilandstrand en de afzetting bij Zilvermonding."
msgstr "Read the washed-up logbook on Gull Island. Examine the broken timber on the island beach and the sediment at Silver Estuary."

#. Opdracht ad_message, stap 2
#: scripts/data/ext/coastal_adventures.gd:7
msgid "Leg bij het werkboek op de havenkade uit waar het wrakhout vandaan kwam."
msgstr "Explain where the wreckage came from at the work ledger on the harbor quay."

#. Titel van opdracht ad_pilot
#: scripts/entities/coastal_adventure.gd:17 scripts/data/ext/coastal_adventures.gd:8
msgid "De oude loodsenroute"
msgstr "The Old Pilot Trail"

#. Opdracht ad_pilot, stap 1
#: scripts/data/ext/coastal_adventures.gd:8
msgid "Zoek vanaf de loodsenpaal op Lichtkaap de lage, gespleten rots in het noordwestelijke grasland."
msgstr "From the pilot post on Beacon Headland, find the low split rock in the northwestern meadow."

#. Opdracht ad_pilot, stap 2
#: scripts/data/ext/coastal_adventures.gd:8
msgid "Volg de beschrijving bij de rots naar de bleke zoutgraspol, oostelijk op de kaap."
msgstr "Follow the description at the rock to the pale saltgrass on the eastern headland."

#. Opdracht ad_pilot, stap 3
#: scripts/data/ext/coastal_adventures.gd:8
msgid "Lees bij het zoutgras waar de loodsen hun beschutte rustplek maakten."
msgstr "Read at the saltgrass where the pilots made their sheltered resting place."

#. Titel van opdracht ad_wheel
#: scripts/data/ext/coastal_adventures.gd:9
msgid "Water dat weer loopt"
msgstr "Water Running Again"

#. Opdracht ad_wheel, stap 1
#: scripts/data/ext/coastal_adventures.gd:9
msgid "Onderzoek het vastgelopen tijrad in de Tijholte, aan het einde van de westelijke zijroute van Zilvermonding."
msgstr "Examine the jammed tide wheel in Tidal Hollow, at the end of the western side trail in Silver Estuary."

#. Opdracht ad_wheel, stap 2
#: scripts/data/ext/coastal_adventures.gd:9
msgid "Maak het rad vrij met het gereedschap ter plaatse. Annuleren kost niets."
msgstr "Free the wheel using the tools on site. Cancelling costs nothing."

#. Titel van opdracht ad_keeper
#: scripts/data/ext/coastal_adventures.gd:10
msgid "De Schelpenhoeder"
msgstr "The Shellkeeper"

#. Opdracht ad_keeper, stap 1
#: scripts/data/ext/coastal_adventures.gd:10
msgid "Kies bij de sluistafel in de Tijholte: geef de poel rust, of open de werksluis en benader de hoeder voor een vrijwillige krachtproef."
msgstr "Choose at the sluice table in Tidal Hollow: leave the pool in peace, or open the working sluice and approach the keeper for a voluntary trial of strength."

#. Titel van opdracht ra_ridge
#: scripts/data/ext/regional.gd:5
msgid "Een lijn door de storm"
msgstr "A line through the storm"

#. Opdracht ra_ridge, stap 1
#: scripts/data/ext/regional.gd:9
msgid "Lees het kampbord bij de ingang van de Bergpas en neem het klimtouw mee."
msgstr "Read the camp board at the Mountain Pass entrance and take the climbing rope."

#. Opdracht ra_ridge, stap 2
#: scripts/data/ext/regional.gd:18
msgid "Steek de noordelijke pas over wanneer de wimpels slap hangen. Zet het touw vast aan de oostelijke paal."
msgstr "Cross the northern pass while the pennants hang loose. Secure the rope to the eastern post."

#. Opdracht ra_ridge, stap 3
#: scripts/data/ext/regional.gd:27
msgid "Haal de verloren weerkaart op bij de schuilhut in het zuidoosten van de Bergpas."
msgstr "Collect the lost weather chart at the shelter in the southeast of the Mountain Pass."

#. Opdracht ra_ridge, stap 4
#: scripts/data/ext/regional.gd:36
msgid "Breng de weerkaart naar het kamp bij de ingang van de Bergpas."
msgstr "Bring the weather chart to the camp at the Mountain Pass entrance."

#. Titel van opdracht ra_archive
#: scripts/data/ext/regional.gd:41
msgid "Wat het water onthield"
msgstr "What the water remembered"

#. Opdracht ra_archive, stap 1
#: scripts/data/ext/regional.gd:45
msgid "Onderzoek de drie reliëfs in het Rietarchief: rietvelden, aanlegplaats en hoogwater. Ga daarna naar de leestafel in het zuiden."
msgstr "Examine the three reliefs in the Reed Archive: reed beds, landing and flood. Then go to the reading table in the south."

#. Titel van opdracht ls_supper
#: scripts/entities/supper_object.gd:47 scripts/data/ext/lake_supper.gd:4
msgid "Een plek aan tafel"
msgstr "A place at the table"

#. Opdracht ls_supper, stap 1
#: scripts/data/ext/lake_supper.gd:5
msgid "Haal Joris' vismand met je hengel uit het water, links naast het begin van de middelste steiger in het Zilvermeer."
msgstr "Use your fishing rod to retrieve Joris’ basket, just left of the start of the middle pier at Silverlake."

#. Opdracht ls_supper, stap 2
#: scripts/data/ext/lake_supper.gd:6
msgid "Ga naar het fornuis rechts in de herberg. Kies een gerecht en bereid Joris' vangst met Mila."
msgstr "Go to the stove on the right inside the inn. Choose a dish and prepare Joris’ catch with Mila."

#. Opdracht ls_supper, stap 3
#: scripts/data/ext/lake_supper.gd:7
msgid "Zet één portie op de grote tafel in de nieuwe eetkamer. De rest mag mee op avontuur."
msgstr "Place one portion on the big table in the new dining room. Take the rest on your adventure."

#. Titel van opdracht boog_schietbaan
#: scripts/data/ext/boog.gd:64
msgid "Schietbaan"
msgstr "Shooting Range"

#. Opdracht boog_schietbaan, stap 1
#: scripts/data/ext/boog.gd:67
msgid "Raak alle drie de doelwitten op Tessa's schietbaan binnen 20 seconden. Praat met Tessa voor een poging."
msgstr "Hit all three targets on Tessa's shooting range within 20 seconds. Talk to Tessa to give it a try."

#. Opdracht boog_schietbaan, stap 2
#: scripts/data/ext/boog.gd:70
msgid "Gehaald! Ga naar Tessa voor je beloning."
msgstr "You did it! Go see Tessa for your reward."

#. Titel van opdracht meer_karper
#: scripts/data/ext/meer.gd:105
msgid "De Gouden Karper"
msgstr "The Golden Carp"

#. Opdracht meer_karper, stap 1
#: scripts/data/ext/meer.gd:108
msgid "Visser Joris droomt van de Gouden Karper. Vang hem in diep water, aan het eind van de verre steiger in het Zilvermeer."
msgstr "Joris the Fisher dreams of the Golden Carp. Catch it in deep water, at the end of the far dock at Silver Lake."

#. Opdracht meer_karper, stap 2
#: scripts/data/ext/meer.gd:111
msgid "Je hebt de Gouden Karper! Breng hem naar Visser Joris in het Zilvermeer."
msgstr "You caught the Golden Carp! Bring it to Joris the Fisher at Silver Lake."

#. Titel van opdracht meer_boeken
#. Naam van prestatie meer_boekenwurm
#: scripts/data/ext/meer.gd:51 scripts/data/ext/meer.gd:115
msgid "Boekenwurm"
msgstr "Bookworm"

#. Opdracht meer_boeken, stap 1
#: scripts/data/ext/meer.gd:118
msgid "Lena van de bibliotheek mist drie boeken: één op het eiland in het Zilvermeer, één in het huisje van Joris en één bij Sanne. ({boeken}/3)"
msgstr "Lena from the library is missing three books: one on the island in Silver Lake, one in Joris' Cabin, and one with Sanne. ({boeken}/3)"

#. Opdracht meer_boeken, stap 2
#: scripts/data/ext/meer.gd:121
msgid "Je hebt alle drie de boeken! Breng ze naar Lena in de bibliotheek."
msgstr "You've got all three books! Bring them to Lena at the library."

#. Opdracht diepte, stap 1
#: scripts/data/ext/diepte.gd:77
msgid "Het rommelt onder de Kristaltempel. Zoek achterin de tempel naar een weg naar beneden."
msgstr "Something is rumbling under the Crystal Temple. Search the back of the temple for a way down."

#. Opdracht diepte, stap 2
#: scripts/data/ext/diepte.gd:81
msgid "Het zegel is gebroken! Zoek in de Kristalgangen een sleutel voor de kristalpoort."
msgstr "The seal is broken! Search the Crystal Halls for a key to the crystal gate."

#. Opdracht diepte, stap 3
#: scripts/data/ext/diepte.gd:85
msgid "De poort is open. Neem de trap naar Het Hart van de Kaart. Neem genoeg drankjes mee!"
msgstr "The gate is open. Take the stairs to the Heart of the Map. Bring plenty of potions!"

#. Opdracht diepte, stap 4
#: scripts/data/ext/diepte.gd:89
msgid "Versla De Vergeten Wachter! Rol door zijn scherven en sla toe na zijn aanval. Laat hem tegen een pilaar knallen: dan is hij even duizelig!"
msgstr "Defeat the Forgotten Guardian! Roll through his shards and strike after he attacks. Make him crash into a pillar: that leaves him dizzy for a moment!"

#. Titel van opdracht arena_kampioen
#. Titel die je krijgt voor arena-rang gold ("Hé {arena_title}!")
#: scripts/data/arena.gd:36 scripts/data/ext/arena.gd:61
msgid "Arenakampioen"
msgstr "Arena Champion"

#. Opdracht arena_kampioen, stap 1
#: scripts/data/ext/arena.gd:64
msgid "Win de Brons-rang in de arena, in het noordoosten van het dorp. Arenameester Bruno schrijft je in."
msgstr "Win the Bronze rank in the arena, in the northeast part of the village. Arena Master Bruno will sign you up."

#. Opdracht arena_kampioen, stap 2
#: scripts/data/ext/arena.gd:68
msgid "Win de Zilver-rang in de arena."
msgstr "Win the Silver rank in the arena."

#. Opdracht arena_kampioen, stap 3
#: scripts/data/ext/arena.gd:71
msgid "Win de Goud-rang en word Arenakampioen! In de laatste ronde staat een kristalgolem."
msgstr "Win the Gold rank and become Arena Champion! A Crystal Golem waits in the final round."

#. Titel van opdracht lantaarn
#: scripts/data/ext/polijst.gd:11
msgid "De Verdwenen Lantaarn"
msgstr "The Missing Lantern"

#. Opdracht lantaarn, stap 1
#: scripts/data/ext/polijst.gd:14
msgid "Lotte zoekt haar speciale nachtlantaarn. Ze denkt dat die ergens in de Vergeten Ruïne is achtergebleven."
msgstr "Lotte is looking for her special night lantern. She thinks it was left somewhere in the Forgotten Ruins."

#. Opdracht lantaarn, stap 2
#: scripts/data/ext/polijst.gd:17
msgid "Breng de nachtlantaarn terug naar Lotte in het dorp."
msgstr "Bring the night lantern back to Lotte in the village."

#. Titel van opdracht kruiden
#: scripts/data/ext/polijst.gd:21
msgid "Verse kruiden voor Elke"
msgstr "Fresh Herbs for Elke"

#. Opdracht kruiden, stap 1
#: scripts/data/ext/polijst.gd:24
msgid "Elke de kruidenier wil 4 verse kruiden. Ze groeien in het bos."
msgstr "Elke the herbalist wants 4 fresh herbs. They grow in the forest."

#. Opdracht kruiden, stap 2
#: scripts/data/ext/polijst.gd:27
msgid "Breng de kruiden naar Elke in het dorp."
msgstr "Bring the herbs to Elke in the village."

#. Titel van opdracht dauw
#: scripts/data/ext/polijst.gd:31
msgid "Het Geheim van de Dauw"
msgstr "The Secret of the Dew"

#. Opdracht dauw, stap 1
#: scripts/data/ext/polijst.gd:34
msgid "Mira in het Dauwbos zoekt een oude dauwsteen. Hij ligt ergens in het bos."
msgstr "Mira in the Dew Woods is looking for an old dew stone. It lies somewhere in the forest."

#. Opdracht dauw, stap 2
#: scripts/data/ext/polijst.gd:38
msgid "Breng de dauwsteen naar Mira en hoor het verhaal van Tomas."
msgstr "Bring the dew stone to Mira and hear the story of Tomas."

#. Opdracht dauw, stap 3
#: scripts/data/ext/polijst.gd:41
msgid "Keer terug naar Mira om het evenwicht te herstellen."
msgstr "Return to Mira to restore the balance."

#. Titel van opdracht mistbloemen
#: scripts/data/ext/polijst.gd:45
msgid "Bloemen in de mist"
msgstr "Flowers in the mist"

#. Opdracht mistbloemen, stap 1
#: scripts/data/ext/polijst.gd:48
msgid "Mira wil 3 dauwklauwen voor haar mistedrank. Ze bloeien waar de mist het zachtst is: bij de vijver en langs de westelijke paden."
msgstr "Mira wants 3 dewclaws for her mist tonic. They bloom where the mist is softest: by the pond and along the western paths."

#. Opdracht mistbloemen, stap 2
#: scripts/data/ext/polijst.gd:51
msgid "Breng de dauwklauwen naar Mira in het Dauwbos."
msgstr "Bring the dewclaws to Mira in the Dew Forest."

#. Titel van opdracht warmte
#: scripts/data/ext/living.gd:61
msgid "Warmte voor IJsdal"
msgstr "Warmth for IJsdal"

#. Opdracht warmte, stap 1
#: scripts/data/ext/living.gd:64
msgid "Herstel de twee vuurkorven voor de noordelijke huizen. Voed ze met hout, wintergloed of de prismatechniek; houd koudevijanden weg tijdens het opwarmen."
msgstr "Restore the two braziers outside the northern houses. Fuel them with wood, winter glow or prism technology; keep cold enemies away while they warm up."

#. Opdracht warmte, stap 2
#: scripts/data/ext/living.gd:73
msgid "Beide huizen zijn warm. Vertel Fenna dat de bergpas weer veilig bereikbaar is."
msgstr "Both houses are warm. Tell Fenna that the mountain pass is accessible again."

#. Titel van opdracht ijswacht
#: scripts/data/ext/sneeuw.gd:15
msgid "De Ijswacht"
msgstr "The Ice Watch"

#. Opdracht ijswacht, stap 1
#: scripts/data/ext/sneeuw.gd:18
msgid "Roos de jageres houdt de paden van IJsdal veilig. Versla 4 ijsblauwe slijmen in het dal."
msgstr "Roos the huntress keeps the paths of IJsdal safe. Defeat 4 ice-blue slimes in the valley."

#. Opdracht ijswacht, stap 2
#: scripts/data/ext/sneeuw.gd:21
msgid "Vertel Roos dat de paden weer veilig zijn."
msgstr "Tell Roos the paths are safe again."

#. Titel van opdracht vellen_en_vlees
#: scripts/data/ext/dorst.gd:38
msgid "Vellen en vlees"
msgstr "Hides and meat"

#. Opdracht vellen_en_vlees, stap 1
#: scripts/data/ext/dorst.gd:41
msgid "Jelle de vellenhandelaar vraagt 2 dierenvachten en 2 stukken rauw vlees. Jaag op het wild van de Dorstvallei."
msgstr "Jelle the hide trader asks for 2 hides and 2 pieces of raw meat. Hunt the game of Dorstvallei."

#. Opdracht vellen_en_vlees, stap 2
#: scripts/data/ext/dorst.gd:44
msgid "Breng de vellen en het vlees naar Jelle in de Dorstvallei."
msgstr "Bring the hides and meat to Jelle in Dorstvallei."

#. Titel van opdracht cactusvijgen
#: scripts/data/ext/dorst.gd:48
msgid "De bron achter het zand"
msgstr "The spring behind the sand"

#. Opdracht cactusvijgen, stap 1
#: scripts/data/ext/dorst.gd:52
msgid "Vul Nours waterzak bij het blauwe waterpunt naast Sana in de Dorstvallei."
msgstr "Fill Nour's waterskin at the blue water station beside Sana in Dorstvallei."

#. Opdracht cactusvijgen, stap 2
#: scripts/data/ext/dorst.gd:61
msgid "Zoek de Zonnekloof in de noordelijke zandsteenwand, rechts van de oase. Volg de blauwe luifels naar de oude bron en kies een aftakking."
msgstr "Find the Sun Gorge in the northern sandstone wall, to the right of the oasis. Follow the blue shelters to the old spring and choose a branch."

#. Opdracht cactusvijgen, stap 3
#: scripts/data/ext/dorst.gd:70
msgid "Vertel Sana bij de oase dat de bron weer stroomt."
msgstr "Tell Sana at the oasis that the spring is flowing again."

#. Titel van opdracht veenbessen
#: scripts/data/ext/moeras.gd:37
msgid "Veenbessen voor Stien"
msgstr "Cranberries for Stien"

#. Opdracht veenbessen, stap 1
#: scripts/data/ext/moeras.gd:40
msgid "Stien de turfsterke heeft 5 veenbessen nodig voor haar pap. Ze groeien laag bij de plassen van het Kruipmoeras."
msgstr "Stien the peat cutter needs 5 cranberries for her porridge. They grow low near the pools of the Creeping Swamp."

#. Opdracht veenbessen, stap 2
#: scripts/data/ext/moeras.gd:43
msgid "Breng de veenbessen naar Stien op de turfvelden."
msgstr "Bring the cranberries to Stien at the peat fields."

#. Titel van opdracht wilgentwijgen
#: scripts/data/ext/living.gd:79
msgid "De oversteek van Mees"
msgstr "Mees’s crossing"

#. Opdracht wilgentwijgen, stap 1
#: scripts/data/ext/living.gd:82
msgid "Onderzoek de lier ten westen van het moeraseiland. Zet de westelijke sluis open en de oostelijke dicht; herstel daarna de oversteek met een bouwpakket, hars of de bewaakte lier."
msgstr "Inspect the winch west of the marsh island. Open the west sluice and close the east one; then restore the crossing with a bridge kit, resin or the guarded winch."

#. Opdracht wilgentwijgen, stap 2
#: scripts/data/ext/living.gd:91
msgid "Het water staat lager en de brug is bruikbaar. Breng Mees het goede nieuws."
msgstr "The water is lower and the bridge is usable. Give Mees the good news."

#. Titel van opdracht zonneschijf
#: scripts/data/ext/moeras.gd:48
msgid "De zonneschijf van Wouda"
msgstr "Wouda's sun disk"

#. Opdracht zonneschijf, stap 1
#: scripts/data/ext/moeras.gd:51
msgid "Wouda de kruidenheks vertelde over een zonneschijfamulet op het eilandje in de drijfmestplas. Zoek het."
msgstr "Wouda the herb witch told of a sun disk amulet on the islet in the quickmire pool. Find it."

#. Opdracht zonneschijf, stap 2
#: scripts/data/ext/moeras.gd:54
msgid "Breng het amulet naar Wouda bij de wilgenhut."
msgstr "Bring the amulet to Wouda at the willow hut."

#. Titel van opdracht prisma_herstel
#: scripts/data/ext/living.gd:5
msgid "Licht onder de bergen"
msgstr "Light beneath the mountains"

#. Opdracht prisma_herstel, stap 1
#: scripts/data/ext/living.gd:8
msgid "Prismamijn: richt de drie spiegels van de noordelijke kamer op hun gemarkeerde ontvangers. Elke aanraking draait een kwartslag."
msgstr "Prism Mine: turn the three mirrors in the northern chamber towards their marked receivers. Each interaction turns a quarter turn."

#. Opdracht prisma_herstel, stap 2
#: scripts/data/ext/living.gd:17
msgid "Activeer de kern naast de laatste ontvanger. Versla de bewakers of gebruik aardingspoeder."
msgstr "Activate the core beside the final receiver. Defeat its guardians or use grounding powder."

#. Opdracht prisma_herstel, stap 3
#: scripts/data/ext/living.gd:26
msgid "De mijn is stabiel. Herstel de prismabank links in Greta’s smederij."
msgstr "The mine is stable. Restore the prism bench on the left in Greta’s smithy."

#. Titel van opdracht lichtwerk
#: scripts/data/ext/living.gd:32
msgid "Een licht voor Mira"
msgstr "A light for Mira"

#. Opdracht lichtwerk, stap 1
#: scripts/data/ext/living.gd:35
msgid "Maak een prismalantaarn bij Greta: via Maken met de prismalens en twee takken, of laat Greta hem voor 40 munten monteren."
msgstr "Make a prism lantern at Greta’s: craft it with the prism lens and two branches, or pay Greta 40 coins to assemble it."

#. Titel van opdracht mistsporen
#: scripts/data/ext/living.gd:41
msgid "Wat de mist verbergt"
msgstr "What the mist hides"

#. Opdracht mistsporen, stap 1
#: scripts/data/ext/living.gd:44
msgid "Neem je prismalantaarn mee. Onderzoek de tekens bij de westelijke wortels, de vijver en de oostelijke steen in het Dauwbos."
msgstr "Bring your prism lantern. Investigate the markings by the western roots, the pond and the eastern stone in Dewwood."

#. Opdracht mistsporen, stap 2
#: scripts/data/ext/living.gd:53
msgid "Ontsteek de drie runen in de volgorde van het gedicht: water, wortel, ster. Een fout dooft de reeks, niet je aanwijzingen."
msgstr "Light the three runes in the order of the poem: water, root, star. A mistake resets the sequence, not your clues."

#. Titel van opdracht first_water
#: scripts/data/ext/opening.gd:4
msgid "Water voor het plein"
msgstr "Water for the Square"

#. Opdracht first_water, stap 1
#: scripts/data/ext/opening.gd:5
msgid "Help Nelle bij het rooster ten westen van de fontein. Gebruik haar hark om het riet los te maken."
msgstr "Help Nelle at the grate west of the fountain. Use her rake to clear the reeds."

#. Opdracht first_water, stap 2
#: scripts/data/ext/opening.gd:6
msgid "Het rooster is vrij. Draai het sluisrad iets zuidelijker open en volg het water naar de fontein."
msgstr "The grate is clear. Open the sluice wheel a little to the south and follow the water to the fountain."

#. Opdracht first_water, stap 3
#: scripts/data/ext/opening.gd:7
msgid "Er zit een prismateken onder het riet. Laat Greta in de smederij aan de westkant van het plein weten wat je vond."
msgstr "There is a prism symbol beneath the reeds. Tell Greta what you found at the smithy west of the square."

#. Titel van opdracht rf_memory
#: scripts/data/ext/first_route.gd:4
msgid "De naam op de stenen"
msgstr "The Name on the Stones"

#. Opdracht rf_memory, stap 1
#: scripts/data/ext/first_route.gd:5
msgid "Onderzoek het beschadigde reliëf in de westelijke zaal en het wachtersboek in de zuidoostelijke kamer van de Ruïne."
msgstr "Examine the damaged relief in the western hall and the guardbook in the southeast room of the Ruins."

#. Opdracht rf_memory, stap 2
#: scripts/data/ext/first_route.gd:6
msgid "De bewaker hield de doorgang open voor vluchtelingen. Breng zijn medaillon uit de Echo-grot terug naar Wilfred."
msgstr "The guard kept the passage open for refugees. Return his medallion from the Echo Cave to Wilfred."

#. Opdracht rf_memory, stap 3
#: scripts/data/ext/first_route.gd:7
msgid "Kies bij de gedenksteen naast Wilfred hoe zijn verhaal herinnerd wordt."
msgstr "Choose how his story will be remembered at the memorial beside Wilfred."

#. Titel van opdracht rf_echo
#: scripts/data/ext/first_route.gd:8
msgid "Wat de stilte vertelt"
msgstr "What Silence Tells"

#. Opdracht rf_echo, stap 1
#: scripts/data/ext/first_route.gd:9
msgid "Luister bij de klankschaal aan de ingang van de Echo-grot."
msgstr "Listen at the singing bowl near the Echo Cave entrance."

#. Opdracht rf_echo, stap 2
#: scripts/data/ext/first_route.gd:10
msgid "Volg de blauwe tekens naar de schaal in de middelste kamer. Lopen is stil; rennen, rollen en aanvallen wekken de luisteraars."
msgstr "Follow the blue marks to the bowl in the middle chamber. Walking is quiet; sprinting, rolling and attacking wake the listeners."

#. Opdracht rf_echo, stap 3
#: scripts/data/ext/first_route.gd:11
msgid "Volg de westelijke echo naar de laatste schaal. Luister rustig: de oude schuilplaats ligt achter de bocht."
msgstr "Follow the western echo to the final bowl. Listen quietly: the old refuge is around the bend."

#. Naam van voorwerp coin
#. Haarkleur (tabblad Uiterlijk)
#: scripts/data/items.gd:9 scripts/data/ext/uiterlijk.gd:137
msgid "Munt"
msgstr "Coin"

#. Beschrijving van voorwerp coin
#: scripts/data/items.gd:9
msgid "Je betaalt er mee."
msgstr "You pay with it."

#. Naam van voorwerp potion
#: scripts/data/items.gd:11
msgid "Helddrank"
msgstr "Hero Potion"

#. Beschrijving van voorwerp potion
#: scripts/data/items.gd:12
msgid "Geneest 3 hartjes. Druk op H om te drinken."
msgstr "Heals 3 hearts. Press H to drink."

#. Naam van voorwerp gel
#: scripts/data/items.gd:15
msgid "Slijmgel"
msgstr "Slime Gel"

#. Beschrijving van voorwerp gel
#: scripts/data/items.gd:16
msgid "Plakkerig spul van slijmen. Handig voor smeden en drankjes."
msgstr "Sticky goo from slimes. Handy for smithing and potions."

#. Naam van voorwerp shard
#: scripts/data/items.gd:19
msgid "Kristalscherf"
msgstr "Crystal Shard"

#. Beschrijving van voorwerp shard
#: scripts/data/items.gd:20
msgid "Een stukje kaartkristal. De smid kan er een bijzonder zwaard van maken."
msgstr "A little piece of map crystal. The smith can make a special sword out of it."

#. Naam van voorwerp ruin_key
#: scripts/data/items.gd:23
msgid "Ruïnesleutel"
msgstr "Ruins Key"

#. Beschrijving van voorwerp ruin_key
#: scripts/data/items.gd:24
msgid "Een roestige sleutel. Hij past op het poortje van de Vergeten Ruïne."
msgstr "A rusty key. It fits the little gate of the Forgotten Ruins."

#. Naam van voorwerp medallion
#: scripts/data/items.gd:27
msgid "Oud medaillon"
msgstr "Old Medallion"

#. Beschrijving van voorwerp medallion
#: scripts/data/items.gd:28
msgid "Een zilveren medaillon met een naam erin gegraveerd: Wilfred."
msgstr "A silver medallion with a name engraved on it: Wilfred."

#. Naam van voorwerp boots
#: scripts/data/items.gd:31
msgid "Snelle laarzen"
msgstr "Swift Boots"

#. Beschrijving van voorwerp boots
#: scripts/data/items.gd:32
msgid "Je loopt een stuk sneller. Altijd handig."
msgstr "You walk a lot faster. Always handy."

#. Naam van voorwerp heart_container
#: scripts/data/items.gd:35
msgid "Hartcontainer"
msgstr "Heart Container"

#. Beschrijving van voorwerp heart_container
#: scripts/data/items.gd:37
msgid "Je kunt er een hartje meer door hebben. Blijvend!"
msgstr "Gives you one more heart. Forever!"

#. Voorwerp heart_container: melding (full_text)
#: scripts/data/items.gd:36
msgid "Je hebt al het maximum van 8 hartjes"
msgstr "You already have the max of 8 hearts"

#. Naam van voorwerp crystal_bos
#: scripts/data/items.gd:40
msgid "Kaartkristal van het Bos"
msgstr "Map Crystal of the Woods"

#. Beschrijving van voorwerp crystal_bos
#: scripts/data/items.gd:41
msgid "Een gloeiend kristal uit het Fluisterbos. Hoort in de Blauwe Kaart."
msgstr "A glowing crystal from the Whispering Woods. It belongs in the Blue Map."

#. Naam van voorwerp crystal_ruine
#: scripts/data/items.gd:44
msgid "Kaartkristal van de Ruïne"
msgstr "Map Crystal of the Ruins"

#. Beschrijving van voorwerp crystal_ruine
#: scripts/data/items.gd:45
msgid "Een gloeiend kristal uit de Vergeten Ruïne. Hoort in de Blauwe Kaart."
msgstr "A glowing crystal from the Forgotten Ruins. It belongs in the Blue Map."

#. Naam van voorwerp crystal_grot
#: scripts/data/items.gd:48
msgid "Kaartkristal van de Grot"
msgstr "Map Crystal of the Cave"

#. Beschrijving van voorwerp crystal_grot
#: scripts/data/items.gd:49
msgid "Een gloeiend kristal uit de Echo-grot. Hoort in de Blauwe Kaart."
msgstr "A glowing crystal from the Echo Cave. It belongs in the Blue Map."

#. Naam van voorwerp sword_wood
#. Naam van zwaard wood
#: scripts/data/items.gd:51 scripts/data/items.gd:61
msgid "Houten zwaard"
msgstr "Wooden Sword"

#. Beschrijving van voorwerp sword_wood
#: scripts/data/items.gd:51
msgid "Klein, maar het werkt."
msgstr "Small, but it works."

#. Naam van voorwerp sword_iron
#. Naam van zwaard iron
#: scripts/data/items.gd:52 scripts/data/items.gd:62
msgid "IJzeren zwaard"
msgstr "Iron Sword"

#. Beschrijving van voorwerp sword_iron
#: scripts/data/items.gd:52
msgid "Door Greta gesmeed. Raakt harder."
msgstr "Forged by Greta. Hits harder."

#. Naam van voorwerp sword_crystal
#. Naam van zwaard crystal
#: scripts/data/items.gd:54 scripts/data/items.gd:63
msgid "Kristalzwaard"
msgstr "Crystal Sword"

#. Beschrijving van voorwerp sword_crystal
#: scripts/data/items.gd:55
msgid "Gloeit zachtblauw. Het sterkste zwaard van Azura."
msgstr "Glows a soft blue. The strongest sword in Azura."

#. Naam van voorwerp td_line
#: scripts/data/ext/tides.gd:5
msgid "Landingslijn"
msgstr "Landing line"

#. Beschrijving van voorwerp td_line
#: scripts/data/ext/tides.gd:5
msgid "Gratis geleend bij de kist in de Getijdenbaai. Herbruikbaar bij beide lijnpalen; wordt nooit verbruikt."
msgstr "Borrowed free from the chest in Tidal Cove. Reusable at either line post; never consumed."

#. Naam van voorwerp ra_waterskin
#: scripts/data/ext/regional.gd:159
msgid "Nours waterzak"
msgstr "Nour's waterskin"

#. Beschrijving van voorwerp ra_waterskin
#: scripts/data/ext/regional.gd:164
msgid "Een hervulbare waterzak voor de Zonnekloof. Je drinkt automatisch; vul gratis bij onder de blauwe luifels."
msgstr "A refillable waterskin for the Sun Gorge. You drink automatically; refill for free under the blue shelters."

#. Naam van voorwerp ls_crate
#: scripts/data/ext/lake_supper.gd:10
msgid "Joris' maaltijdmand"
msgstr "Joris’ meal hamper"

#. Beschrijving van voorwerp ls_crate
#: scripts/data/ext/lake_supper.gd:10
msgid "Verse vangst en groente voor Mila. Bereid twee porties bij het fornuis in de herberg."
msgstr "Fresh fish and vegetables for Mila. Prepare two portions at the inn’s stove."

#. Naam van voorwerp ls_chowder
#: scripts/data/ext/lake_supper.gd:11
msgid "Zilvermeerstoof"
msgstr "Silverlake stew"

#. Beschrijving van voorwerp ls_chowder
#: scripts/data/ext/lake_supper.gd:11
msgid "Stevige visstoof: herstelt 3 hartjes en 20 uithoudingsvermogen. Gebruik via Beroepen → Eten & drinken."
msgstr "Hearty fish stew: restores 3 hearts and 20 stamina. Use through Professions → Food & drink."

#. Naam van voorwerp ls_broth
#: scripts/data/ext/lake_supper.gd:12
msgid "Oeverbouillon"
msgstr "Lakeside broth"

#. Beschrijving van voorwerp ls_broth
#: scripts/data/ext/lake_supper.gd:12
msgid "Lichte visbouillon: herstelt 1 hartje en 60 uithoudingsvermogen. Gebruik via Beroepen → Eten & drinken."
msgstr "Light fish broth: restores 1 heart and 60 stamina. Use through Professions → Food & drink."

#. Naam van voorwerp bow
#. Instelbare bediening: bow
#: scripts/core/input_manager.gd:14 scripts/data/ext/boog.gd:15
msgid "Boog"
msgstr "Bow"

#. Beschrijving van voorwerp bow
#: scripts/data/ext/boog.gd:16
msgid "Druk op F om een pijl te schieten. Een pijl doet 2 schade (bij bazen 1) en vliegt over water. Je krijgt er 5 pijlen bij, meer pijlen koop je apart."
msgstr "Press F to shoot an arrow. An arrow does 2 damage (1 to bosses) and flies over water. Comes with 5 arrows. You can buy more arrows separately."

#. Naam van voorwerp arrow
#: scripts/data/ext/boog.gd:19
msgid "Pijl"
msgstr "Arrow"

#. Beschrijving van voorwerp arrow
#: scripts/data/ext/boog.gd:23
msgid "Pijlen voor je boog. Er passen er 40 in je pijlenkoker. Skeletten laten er soms een paar vallen."
msgstr "Arrows for your bow. Your quiver holds 40 of them. Skeletons sometimes drop a few."

#. Voorwerp arrow: melding (full_text)
#: scripts/data/ext/boog.gd:20
msgid "Je pijlenkoker is vol"
msgstr "Your quiver is full"

#. Voorwerp arrow: melding (almost_full_text)
#: scripts/data/ext/boog.gd:21
msgid "Je pijlenkoker zit bijna vol"
msgstr "Your quiver is almost full"

#. Voorwerp arrow: melding (chest_full_text)
#: scripts/data/ext/boog.gd:22
msgid "Er zitten pijlen in deze kist, maar ze passen niet meer in je pijlenkoker. Schiet er eerst een paar af!"
msgstr "There are arrows in this chest, but your quiver has no room for them. Shoot a few first!"

#. Naam van voorwerp fishing_rod
#: scripts/data/ext/meer.gd:62
msgid "Hengel"
msgstr "Fishing Rod"

#. Beschrijving van voorwerp fishing_rod
#: scripts/data/ext/meer.gd:63
msgid "De reservehengel van Visser Joris. Ga bij een visplek in het Zilvermeer staan en druk op E."
msgstr "Joris the Fisher's spare rod. Stand at a fishing spot at Silver Lake and press E."

#. Naam van voorwerp meer_baars
#: scripts/data/ext/meer.gd:66
msgid "Baars"
msgstr "Perch"

#. Beschrijving van voorwerp meer_baars
#: scripts/data/ext/meer.gd:67
msgid "Een gestreepte baars met rode vinnen. Joris en Mila kopen hem graag."
msgstr "A striped perch with red fins. Joris and Mila are happy to buy it."

#. Naam van voorwerp meer_snoek
#: scripts/data/ext/meer.gd:70
msgid "Snoek"
msgstr "Pike"

#. Beschrijving van voorwerp meer_snoek
#: scripts/data/ext/meer.gd:71
msgid "Een lange snoek met een grote bek. Joris en Mila betalen er goed voor."
msgstr "A long pike with a big mouth. Joris and Mila pay well for it."

#. Naam van voorwerp meer_gouden_karper
#: scripts/data/ext/meer.gd:74
msgid "Gouden Karper"
msgstr "Golden Carp"

#. Beschrijving van voorwerp meer_gouden_karper
#: scripts/data/ext/meer.gd:75
msgid "De beroemde vis van het Zilvermeer. Hij glinstert alsof hij van goud is. Visser Joris droomt van hem."
msgstr "The famous fish of Silver Lake. It sparkles like it's made of gold. Joris the Fisher dreams about it."

#. Naam van voorwerp meer_laars
#: scripts/data/ext/meer.gd:78
msgid "Oude laars"
msgstr "Old Boot"

#. Beschrijving van voorwerp meer_laars
#: scripts/data/ext/meer.gd:79
msgid "Een natte, stinkende laars. Joris verzamelt ze. Waarom, dat weet niemand."
msgstr "A wet, smelly boot. Joris collects them. Why? Nobody knows."

#. Naam van voorwerp fishers_cap
#: scripts/data/ext/meer.gd:82
msgid "Visserspet"
msgstr "Fisher's Cap"

#. Beschrijving van voorwerp fishers_cap
#: scripts/data/ext/meer.gd:83
msgid "De pet van Visser Joris. Met deze pet betalen Joris en Mila je 10% extra voor je vis."
msgstr "Joris the Fisher's cap. With this cap on, Joris and Mila pay you 10% extra for your fish."

#. Naam van voorwerp meer_boek_eiland
#: scripts/data/ext/meer.gd:86
msgid "Sagen van het Zilvermeer"
msgstr "Legends of Silver Lake"

#. Beschrijving van voorwerp meer_boek_eiland
#: scripts/data/ext/meer.gd:87
msgid "Een van de drie boeken die Lena mist. Je vond het op het eiland."
msgstr "One of the three books Lena is missing. You found it on the island."

#. Naam van voorwerp meer_boek_hut
#: scripts/data/ext/meer.gd:90
msgid "Het Grote Vissenboek"
msgstr "The Big Book of Fish"

#. Beschrijving van voorwerp meer_boek_hut
#: scripts/data/ext/meer.gd:91
msgid "Een van de drie boeken die Lena mist. Het lag in het huisje van Joris, met een koffiekring erop."
msgstr "One of the three books Lena is missing. It was in Joris' Cabin, with a coffee ring on it."

#. Naam van voorwerp meer_boek_sanne
#: scripts/data/ext/meer.gd:94
msgid "Sterren boven Azura"
msgstr "Stars over Azura"

#. Beschrijving van voorwerp meer_boek_sanne
#: scripts/data/ext/meer.gd:95
msgid "Een van de drie boeken die Lena mist. Sanne gaf het je."
msgstr "One of the three books Lena is missing. Sanne gave it to you."

#. Naam van voorwerp meer_schelp
#: scripts/data/ext/meer.gd:98
msgid "Zilverschelp"
msgstr "Silver Shell"

#. Beschrijving van voorwerp meer_schelp
#: scripts/data/ext/meer.gd:99
msgid "Een roze schelp uit het Zilvermeer. Als je goed luistert, hoor je een rustig liedje. Een verzamelstuk."
msgstr "A pink shell from Silver Lake. If you listen closely, you can hear a calm little song. A collectible."

#. Naam van voorwerp sword_star
#. Naam van zwaard star
#: scripts/data/ext/diepte.gd:97 scripts/data/ext/diepte.gd:109
msgid "Sterrenzwaard"
msgstr "Starsword"

#. Beschrijving van voorwerp sword_star
#: scripts/data/ext/diepte.gd:98
msgid "Het legendarische zwaard van de Sterrenkaart. Het schijnt als een ster en raakt harder dan alle andere zwaarden."
msgstr "The legendary sword of the Star Map. It shines like a star and hits harder than any other sword."

#. Naam van voorwerp diepte_key
#: scripts/data/ext/diepte.gd:101
msgid "Kristalsleutel"
msgstr "Crystal Key"

#. Beschrijving van voorwerp diepte_key
#: scripts/data/ext/diepte.gd:102
msgid "Een sleutel van gloeiend kristal. Hij past op de kristalpoort in de Diepte."
msgstr "A key made of glowing crystal. It fits the crystal gate in the Depths."

#. Naam van voorwerp arena_trophy_bronze
#: scripts/data/ext/arena.gd:31
msgid "Bronzen trofee"
msgstr "Bronze Trophy"

#. Beschrijving van voorwerp arena_trophy_bronze
#: scripts/data/ext/arena.gd:32
msgid "Voor het winnen van de Brons-rang in de arena. Staat mooi op de trofeeënplank."
msgstr "For winning the Bronze rank in the arena. Looks great on the trophy shelf."

#. Naam van voorwerp arena_trophy_silver
#: scripts/data/ext/arena.gd:35
msgid "Zilveren trofee"
msgstr "Silver Trophy"

#. Beschrijving van voorwerp arena_trophy_silver
#: scripts/data/ext/arena.gd:36
msgid "Voor het winnen van de Zilver-rang in de arena. Hij glimt als een spiegel."
msgstr "For winning the Silver rank in the arena. It shines like a mirror."

#. Naam van voorwerp arena_trophy_gold
#: scripts/data/ext/arena.gd:39
msgid "Gouden trofee"
msgstr "Gold Trophy"

#. Beschrijving van voorwerp arena_trophy_gold
#: scripts/data/ext/arena.gd:40
msgid "Voor het winnen van de Goud-rang in de arena. De hoogste eer van Dageraadsdorp!"
msgstr "For winning the Gold rank in the arena. The highest honor in Daybreak Village!"

#. Naam van voorwerp arena_helm
#: scripts/data/ext/arena.gd:43
msgid "Arenahelm"
msgstr "Arena Helmet"

#. Beschrijving van voorwerp arena_helm
#: scripts/data/ext/arena.gd:44
msgid "Een stalen helm met een rode pluim. Alleen een echte Arenakampioen mag hem dragen. Een verzamelstuk."
msgstr "A steel helmet with a red plume. Only a true Arena Champion may wear it. A collectible."

#. Naam van voorwerp prof_branch
#: scripts/data/ext/beroepen.gd:32
msgid "Droge tak"
msgstr "Dry Branch"

#. Beschrijving van voorwerp prof_branch
#: scripts/data/ext/beroepen.gd:32
msgid "Los hout uit dorp en bos. Voor je eerste bijl en pikhouweel."
msgstr "Loose wood from the village and woods. For your first axe and pickaxe."

#. Naam van voorwerp prof_stone
#: scripts/data/ext/beroepen.gd:33
msgid "Vuursteen"
msgstr "Flint"

#. Beschrijving van voorwerp prof_stone
#: scripts/data/ext/beroepen.gd:33
msgid "Een scherpe losse steen. Je kunt hem zonder gereedschap oprapen."
msgstr "A sharp loose stone. You can pick it up without tools."

#. Naam van voorwerp prof_herb
#. Oogstbare grondstof herbs
#: scripts/data/ext/beroepen.gd:34 scripts/data/ext/beroepen.gd:167
msgid "Zilverkruid"
msgstr "Silverleaf"

#. Beschrijving van voorwerp prof_herb
#: scripts/data/ext/beroepen.gd:34
msgid "Geurig kruid voor alchemie en stevige soep."
msgstr "A fragrant herb for alchemy and hearty soup."

#. Naam van voorwerp prof_berry
#: scripts/data/ext/beroepen.gd:35
msgid "Bosbes"
msgstr "Blueberry"

#. Beschrijving van voorwerp prof_berry
#: scripts/data/ext/beroepen.gd:35
msgid "Maak er een bessensnack of een energie-elixer van."
msgstr "Use it to make a berry snack or an energy tonic."

#. Naam van voorwerp prof_log
#: scripts/data/ext/beroepen.gd:36
msgid "Berkenhout"
msgstr "Birch Wood"

#. Beschrijving van voorwerp prof_log
#: scripts/data/ext/beroepen.gd:36
msgid "Hout van een oogstbare stronk. Voor smeltvuur, gereedschap en pijlen."
msgstr "Wood from a harvestable stump. For smelting, tools and arrows."

#. Naam van voorwerp prof_copper_ore
#: scripts/data/ext/beroepen.gd:37
msgid "Kopererts"
msgstr "Copper Ore"

#. Beschrijving van voorwerp prof_copper_ore
#: scripts/data/ext/beroepen.gd:37
msgid "Win met een stenen pikhouweel. Smelt het bij Greta tot koper."
msgstr "Mine it with a stone pickaxe. Smelt it into copper at Greta's."

#. Naam van voorwerp prof_iron_ore
#: scripts/data/ext/beroepen.gd:38
msgid "IJzererts"
msgstr "Iron Ore"

#. Beschrijving van voorwerp prof_iron_ore
#: scripts/data/ext/beroepen.gd:38
msgid "Win in de Echo-grot met mijnbouw 2 en een koperen pikhouweel."
msgstr "Mine it in Echo Cave with Mining 2 and a copper pickaxe."

#. Naam van voorwerp prof_copper_bar
#: scripts/data/ext/beroepen.gd:39
msgid "Koperstaaf"
msgstr "Copper Bar"

#. Beschrijving van voorwerp prof_copper_bar
#: scripts/data/ext/beroepen.gd:39
msgid "Gesmolten koper voor een beter pikhouweel."
msgstr "Smelted copper for a better pickaxe."

#. Naam van voorwerp prof_iron_bar
#: scripts/data/ext/beroepen.gd:40
msgid "IJzerstaaf"
msgstr "Iron Bar"

#. Beschrijving van voorwerp prof_iron_bar
#: scripts/data/ext/beroepen.gd:40
msgid "Gesmolten ijzer voor een efficiëntere bijl."
msgstr "Smelted iron for a more efficient axe."

#. Naam van voorwerp prof_axe
#: scripts/data/ext/beroepen.gd:41
msgid "Stenen bijl"
msgstr "Stone Axe"

#. Beschrijving van voorwerp prof_axe
#: scripts/data/ext/beroepen.gd:41
msgid "Hak oogstbare stronken. Wordt automatisch gebruikt; slijt niet."
msgstr "Chop harvestable stumps. Used automatically; never wears out."

#. Naam van voorwerp prof_pickaxe
#: scripts/data/ext/beroepen.gd:42
msgid "Stenen pikhouweel"
msgstr "Stone Pickaxe"

#. Beschrijving van voorwerp prof_pickaxe
#: scripts/data/ext/beroepen.gd:42
msgid "Win koperaders. Wordt automatisch gebruikt; slijt niet."
msgstr "Mine copper veins. Used automatically; never wears out."

#. Naam van voorwerp prof_copper_pickaxe
#: scripts/data/ext/beroepen.gd:43
msgid "Koperen pikhouweel"
msgstr "Copper Pickaxe"

#. Beschrijving van voorwerp prof_copper_pickaxe
#: scripts/data/ext/beroepen.gd:43
msgid "Ontsluit ijzererts vanaf mijnbouw 2. Vervangt je stenen pikhouweel automatisch."
msgstr "Unlocks iron ore at Mining 2. Automatically replaces your stone pickaxe."

#. Naam van voorwerp prof_iron_axe
#: scripts/data/ext/beroepen.gd:44
msgid "IJzeren bijl"
msgstr "Iron Axe"

#. Beschrijving van voorwerp prof_iron_axe
#: scripts/data/ext/beroepen.gd:44
msgid "Oogst 3 berkenhout per stronk in plaats van 2. Slijt niet."
msgstr "Harvests 3 birch wood per stump instead of 2. Never wears out."

#. Naam van voorwerp prof_tonic
#: scripts/data/ext/beroepen.gd:45
msgid "Energie-elixer"
msgstr "Energy Tonic"

#. Beschrijving van voorwerp prof_tonic
#: scripts/data/ext/beroepen.gd:45
msgid "Herstelt 60 uithoudingsvermogen. Gebruik via Beroepen → Eten & drinken."
msgstr "Restores 60 stamina. Use through Professions → Food & drink."

#. Naam van voorwerp prof_berry_meal
#: scripts/data/ext/beroepen.gd:46
msgid "Bessensnack"
msgstr "Berry Snack"

#. Beschrijving van voorwerp prof_berry_meal
#: scripts/data/ext/beroepen.gd:46
msgid "Herstelt 1 hartje. Gebruik via Beroepen → Eten & drinken."
msgstr "Restores 1 heart. Use through Professions → Food & drink."

#. Naam van voorwerp prof_fish_meal
#: scripts/data/ext/beroepen.gd:47
msgid "Gebakken baars"
msgstr "Grilled Perch"

#. Beschrijving van voorwerp prof_fish_meal
#: scripts/data/ext/beroepen.gd:47
msgid "Herstelt 3 hartjes. Gemaakt in de herberg. Gebruik via Beroepen → Eten & drinken."
msgstr "Restores 3 hearts. Cooked at the inn. Use through Professions → Food & drink."

#. Naam van voorwerp prof_mushroom
#: scripts/data/ext/beroepen.gd:48
msgid "Honingzwam"
msgstr "Honey Mushroom"

#. Beschrijving van voorwerp prof_mushroom
#: scripts/data/ext/beroepen.gd:48
msgid "Een eetbare zwam uit het Fluisterbos. Voor stevige paddenstoelensoep."
msgstr "An edible mushroom from the Whispering Woods. For hearty mushroom soup."

#. Naam van voorwerp prof_stew
#: scripts/data/ext/beroepen.gd:49
msgid "Paddenstoelensoep"
msgstr "Mushroom Soup"

#. Beschrijving van voorwerp prof_stew
#: scripts/data/ext/beroepen.gd:49
msgid "Herstelt 2 hartjes. Gebruik via Beroepen → Eten & drinken."
msgstr "Restores 2 hearts. Use through Professions → Food & drink."

#. Naam van voorwerp prof_ijsbloem
#: scripts/data/ext/beroepen.gd:50
msgid "IJsbloem"
msgstr "Ice flower"

#. Beschrijving van voorwerp prof_ijsbloem
#: scripts/data/ext/beroepen.gd:50
msgid "Een bloem die alleen in het IJsdal bloeit. Koud en helder; basis voor vorstelixers."
msgstr "A flower that blooms only in IJsdal. Cold and clear; the base for frost tonics."

#. Naam van voorwerp prof_winterbes
#: scripts/data/ext/beroepen.gd:51
msgid "Winterbes"
msgstr "Winter berry"

#. Beschrijving van voorwerp prof_winterbes
#: scripts/data/ext/beroepen.gd:51
msgid "Zoete bes die juist in de sneeuw rijpt. Lekker en verwarmend."
msgstr "A sweet berry that ripens right in the snow. Tasty and warming."

#. Naam van voorwerp prof_dennenhout
#: scripts/data/ext/beroepen.gd:52
msgid "Dennenhout"
msgstr "Pine wood"

#. Beschrijving van voorwerp prof_dennenhout
#: scripts/data/ext/beroepen.gd:52
msgid "Harsachtig hout uit het IJsdal. Brandt lang en warm."
msgstr "Resinous wood from IJsdal. Burns long and warm."

#. Naam van voorwerp prof_ijskristal
#: scripts/data/ext/beroepen.gd:53
msgid "IJskristal"
msgstr "Ice crystal"

#. Beschrijving van voorwerp prof_ijskristal
#: scripts/data/ext/beroepen.gd:53
msgid "Een zuivere kristalspalk uit een bevroren ader. Gezocht door alchemisten."
msgstr "A pure crystal shard from a frozen vein. Sought after by alchemists."

#. Naam van voorwerp prof_frost_tonic
#: scripts/data/ext/beroepen.gd:54
msgid "Vorstelixer"
msgstr "Frost tonic"

#. Beschrijving van voorwerp prof_frost_tonic
#: scripts/data/ext/beroepen.gd:54
msgid "Herstelt 40 uithoudingsvermogen. Gebruik via Beroepen → Eten & drinken."
msgstr "Restores 40 stamina. Use through Professions → Food & drink."

#. Naam van voorwerp prof_winter_gloed
#: scripts/data/ext/beroepen.gd:55
msgid "Wintergloed"
msgstr "Winter glow"

#. Beschrijving van voorwerp prof_winter_gloed
#: scripts/data/ext/beroepen.gd:55
msgid "Een warme winterbespap. Herstelt 2 hartjes. Gebruik via Beroepen → Eten & drinken."
msgstr "A warm winter berry porridge. Restores 2 hearts. Use through Professions → Food & drink."

#. Naam van voorwerp prof_cactusvijg
#: scripts/data/ext/beroepen.gd:56
msgid "Cactusvijg"
msgstr "Cactus fig"

#. Beschrijving van voorwerp prof_cactusvijg
#: scripts/data/ext/beroepen.gd:56
msgid "Zoete vrucht van de zuilcactus. Verkoelend; Sana maakt er drankjes van."
msgstr "Sweet fruit of the columnar cactus. Cooling; Sana turns them into drinks."

#. Naam van voorwerp prof_zandkruid
#. Oogstbare grondstof sandwort
#: scripts/data/ext/beroepen.gd:57 scripts/data/ext/beroepen.gd:178
msgid "Zandkruid"
msgstr "Sandwort"

#. Beschrijving van voorwerp prof_zandkruid
#: scripts/data/ext/beroepen.gd:57
msgid "Een taai, geurig kruid dat tussen het duinzand groeit. Voor balsems en braadstukken."
msgstr "A tough, fragrant herb that grows among the dune sand. For balms and roasts."

#. Naam van voorwerp prof_zandsteen
#: scripts/data/ext/beroepen.gd:58
msgid "Zandsteen"
msgstr "Sandstone"

#. Beschrijving van voorwerp prof_zandsteen
#: scripts/data/ext/beroepen.gd:58
msgid "Warme, gelaagde steen uit de klippen van de Dorstvallei. Licht en goed te bewerken."
msgstr "Warm, layered stone from the cliffs of Dorstvallei. Light and easy to work."

#. Naam van voorwerp prof_zandbalsem
#: scripts/data/ext/beroepen.gd:59
msgid "Zandbalsem"
msgstr "Sand balm"

#. Beschrijving van voorwerp prof_zandbalsem
#: scripts/data/ext/beroepen.gd:59
msgid "Verkoelende balsem van zandkruid en cactusvijg. Herstelt 30 uithoudingsvermogen. Gebruik via Beroepen → Eten & drinken."
msgstr "Cooling balm of sandwort and cactus fig. Restores 30 stamina. Use through Professions → Food & drink."

#. Naam van voorwerp prof_dauwklauw
#: scripts/data/ext/beroepen.gd:60
msgid "Dauwklauw"
msgstr "Dewclaw"

#. Beschrijving van voorwerp prof_dauwklauw
#: scripts/data/ext/beroepen.gd:60
msgid "Een bleke bloem die alleen in de mist van het Dauwbos bloeit. Basis voor het mistedrank."
msgstr "A pale flower that only blooms in the mist of the Dew Forest. The base for mist tonic."

#. Naam van voorwerp prof_mistdrank
#: scripts/data/ext/beroepen.gd:61
msgid "Mistedrank"
msgstr "Mist tonic"

#. Beschrijving van voorwerp prof_mistdrank
#: scripts/data/ext/beroepen.gd:61
msgid "Een koel, kolkend elixer van dauwklauwen en honingzwam. Herstelt 35 uithoudingsvermogen. Gebruik via Beroepen → Eten & drinken."
msgstr "A cool, swirling elixir of dewclaws and honey fungus. Restores 35 stamina. Use via Professions → Food & drink."

#. Naam van voorwerp prof_dauwsoep
#: scripts/data/ext/beroepen.gd:62
msgid "Dauwsoep"
msgstr "Dew soup"

#. Beschrijving van voorwerp prof_dauwsoep
#: scripts/data/ext/beroepen.gd:62
msgid "Lichte soep van honingzwammen met dauwklauw. Herstelt 2 hartjes en 10 uithoudingsvermogen. Gebruik via Beroepen → Eten & drinken."
msgstr "Light soup of honey fungi with dewclaw. Restores 2 hearts and 10 stamina. Use via Professions → Food & drink."

#. Naam van voorwerp prof_veenbes
#: scripts/data/ext/beroepen.gd:63
msgid "Veenbes"
msgstr "Cranberry"

#. Beschrijving van voorwerp prof_veenbes
#: scripts/data/ext/beroepen.gd:63
msgid "Een rode, zure bes die laag boven het veenwater groeit. Voor pap en elixers."
msgstr "A red, tart berry that grows low above the moor water. For porridge and elixirs."

#. Naam van voorwerp prof_watermunt
#. Oogstbare grondstof watermunt
#: scripts/data/ext/beroepen.gd:64 scripts/data/ext/beroepen.gd:182
msgid "Watermunt"
msgstr "Water mint"

#. Beschrijving van voorwerp prof_watermunt
#: scripts/data/ext/beroepen.gd:64
msgid "Fris kruid uit de plasranden van het Kruipmoeras. Prikt lekker in thee en brouwsels."
msgstr "Fresh herb from the pool edges of the Creeping Swamp. Lovely kick in tea and brews."

#. Naam van voorwerp prof_wilgentwijg
#: scripts/data/ext/beroepen.gd:65
msgid "Wilgentwijg"
msgstr "Willow twig"

#. Beschrijving van voorwerp prof_wilgentwijg
#: scripts/data/ext/beroepen.gd:65
msgid "Buigzame twijg van een geknotte wilg. Rietvlechters zweren erbij."
msgstr "Supple twig from a pollard willow. Reed weavers swear by it."

#. Naam van voorwerp prof_ijzeroer
#: scripts/data/ext/beroepen.gd:66
msgid "IJzeroer"
msgstr "Bog iron"

#. Beschrijving van voorwerp prof_ijzeroer
#: scripts/data/ext/beroepen.gd:66
msgid "Bruin erts uit de turfvelden, het bloed van het veen. Alchemisten smeden er rare dingen mee."
msgstr "Brown ore from the peat fields, the blood of the moor. Alchemists forge strange things with it."

#. Naam van voorwerp prof_moeraselixer
#: scripts/data/ext/beroepen.gd:67
msgid "Moeraselixer"
msgstr "Swamp elixir"

#. Beschrijving van voorwerp prof_moeraselixer
#: scripts/data/ext/beroepen.gd:67
msgid "Kolkend groen brouwsel van watermunt en veenbes. Herstelt 45 uithoudingsvermogen. Gebruik via Beroepen → Eten & drinken."
msgstr "Bubbling green brew of water mint and cranberry. Restores 45 stamina. Use via Professions → Food & drink."

#. Naam van voorwerp prof_veenbespap
#: scripts/data/ext/beroepen.gd:68
msgid "Veenbespap"
msgstr "Cranberry porridge"

#. Beschrijving van voorwerp prof_veenbespap
#: scripts/data/ext/beroepen.gd:68
msgid "Warme pap met veenbessen, zoals Stien hem maakt. Herstelt 2 hartjes en 5 uithoudingsvermogen. Gebruik via Beroepen → Eten & drinken."
msgstr "Warm porridge with cranberries, the way Stien makes it. Restores 2 hearts and 5 stamina. Use via Professions → Food & drink."

#. Naam van voorwerp gear_ra_grip
#: scripts/data/ext/uitrusting.gd:15
msgid "Klimhandschoenen"
msgstr "Climbing gloves"

#. Beschrijving van voorwerp gear_ra_grip
#: scripts/data/ext/uitrusting.gd:15
msgid "Grip en een lichte tred: 4% sneller lopen en 15 extra stamina. Gebruikt hetzelfde handvak als aanvalshandschoenen."
msgstr "Grip and a light step: 4% faster movement and 15 extra stamina. Uses the same hand slot as attack gloves."

#. Naam van voorwerp gear_ra_compass
#: scripts/data/ext/uitrusting.gd:16
msgid "Archiefkompas"
msgstr "Archive compass"

#. Beschrijving van voorwerp gear_ra_compass
#: scripts/data/ext/uitrusting.gd:16
msgid "Een kompas uit het Rietarchief: 16 extra oppakbereik en 10% sneller staminaherstel. Draag het in je halsvak."
msgstr "A compass from the Reed Archive: 16 extra pickup range and 10% faster stamina regeneration. Wear it in your neck slot."

#. Naam van voorwerp gear_rf_keepsake
#: scripts/data/ext/uitrusting.gd:17
msgid "Wilfreds herinnering"
msgstr "Wilfred's Keepsake"

#. Beschrijving van voorwerp gear_rf_keepsake
#: scripts/data/ext/uitrusting.gd:17
msgid "Een ring uit de herdenkingsplek: 15% sneller staminaherstel en 6 extra oppakbereik. Minder bereik dan een koperen ring."
msgstr "A memorial ring: 15% faster stamina recovery and 6 extra pickup range. Less range than a copper ring."

#. Naam van voorwerp gear_rf_cord
#: scripts/data/ext/uitrusting.gd:18
msgid "Stiltekoord"
msgstr "Cord of Stillness"

#. Beschrijving van voorwerp gear_rf_cord
#: scripts/data/ext/uitrusting.gd:18
msgid "Een oud koord uit de schuilroute. Geeft gedragen 20 extra stamina; amuletten voor sneller herstel gebruiken hetzelfde halsvak."
msgstr "An old cord from the refuge route. Grants 20 extra stamina when worn; recovery amulets use the same neck slot."

#. Naam van voorwerp gear_scout_coat
#: scripts/data/ext/uitrusting.gd:20
msgid "Verkennersjas"
msgstr "Scout coat"

#. Beschrijving van voorwerp gear_scout_coat
#: scripts/data/ext/uitrusting.gd:30
msgid "8% sneller en 10 extra stamina, maar geen pantser. Voor verkennen en ontwijken."
msgstr "8% faster and 10 extra stamina, but no armor. For exploration and dodging."

#. Naam van voorwerp gear_bastion_coat
#: scripts/data/ext/uitrusting.gd:33
msgid "Wachtharnas"
msgstr "Warden coat"

#. Beschrijving van voorwerp gear_bastion_coat
#: scripts/data/ext/uitrusting.gd:43
msgid "2 pantser, maar 8% langzamer. Elke treffer doet minimaal 1 schade. Voor standhouden bij een vuurkorf."
msgstr "2 armor, but 8% slower. Every hit deals at least 1 damage. For holding your ground by a brazier."

#. Naam van voorwerp gear_cloth_hood
#: scripts/data/ext/uitrusting.gd:46
msgid "Linnen kap"
msgstr "Linen hood"

#. Beschrijving van voorwerp gear_cloth_hood
#: scripts/data/ext/uitrusting.gd:46
msgid "Een lichte reiskap. Draag hem op je hoofd voor 15 extra uithoudingsvermogen."
msgstr "A light traveling hood. Wear it on your head for 15 extra stamina."

#. Naam van voorwerp gear_bronze_helm
#: scripts/data/ext/uitrusting.gd:47
msgid "Bronzen helm"
msgstr "Bronze helmet"

#. Beschrijving van voorwerp gear_bronze_helm
#: scripts/data/ext/uitrusting.gd:47
msgid "Een stevige helm voor lange tochten. Draag hem op je hoofd voor 30 extra uithoudingsvermogen."
msgstr "A sturdy helmet for long journeys. Wear it on your head for 30 extra stamina."

#. Naam van voorwerp gear_leather_armor
#: scripts/data/ext/uitrusting.gd:48
msgid "Leren harnas"
msgstr "Leather armor"

#. Beschrijving van voorwerp gear_leather_armor
#: scripts/data/ext/uitrusting.gd:48
msgid "Vangt zware klappen op. Vermindert schade met 1, tot minimaal 1 schade per treffer."
msgstr "Absorbs heavy blows. Reduces damage by 1, to a minimum of 1 damage per hit."

#. Naam van voorwerp gear_iron_armor
#: scripts/data/ext/uitrusting.gd:49
msgid "IJzeren harnas"
msgstr "Iron armor"

#. Beschrijving van voorwerp gear_iron_armor
#: scripts/data/ext/uitrusting.gd:49
msgid "Gesmede bescherming. Vermindert schade met 2, tot minimaal 1 schade per treffer."
msgstr "Forged protection. Reduces damage by 2, to a minimum of 1 damage per hit."

#. Naam van voorwerp gear_novice_gloves
#: scripts/data/ext/uitrusting.gd:50
msgid "Leerlinghandschoenen"
msgstr "Apprentice gloves"

#. Beschrijving van voorwerp gear_novice_gloves
#: scripts/data/ext/uitrusting.gd:50
msgid "Een goede grip op je zwaard. Draag ze voor 8% kortere wachttijd tussen zwaardaanvallen."
msgstr "A firm grip on your sword. Wear them for an 8% shorter cooldown between sword attacks."

#. Naam van voorwerp gear_smith_gloves
#: scripts/data/ext/uitrusting.gd:51
msgid "Smeedhandschoenen"
msgstr "Smith's gloves"

#. Beschrijving van voorwerp gear_smith_gloves
#: scripts/data/ext/uitrusting.gd:51
msgid "Perfect passende handschoenen. Draag ze voor 16% kortere wachttijd tussen zwaardaanvallen."
msgstr "Perfectly fitted gloves. Wear them for a 16% shorter cooldown between sword attacks."

#. Naam van voorwerp gear_copper_amulet
#: scripts/data/ext/uitrusting.gd:52
msgid "Koperen amulet"
msgstr "Copper amulet"

#. Beschrijving van voorwerp gear_copper_amulet
#: scripts/data/ext/uitrusting.gd:52
msgid "Een warm koperen sieraad. Draag het om je hals voor 15% sneller herstel van uithoudingsvermogen."
msgstr "A warm copper charm. Wear it around your neck for 15% faster stamina recovery."

#. Naam van voorwerp gear_crystal_amulet
#: scripts/data/ext/uitrusting.gd:53
msgid "Kristallen amulet"
msgstr "Crystal amulet"

#. Beschrijving van voorwerp gear_crystal_amulet
#: scripts/data/ext/uitrusting.gd:53
msgid "Alchemie laat gel kristalliseren rond koper. Draag het voor 30% sneller herstel van uithoudingsvermogen."
msgstr "Alchemy crystallizes gel around copper. Wear it for 30% faster stamina recovery."

#. Naam van voorwerp gear_copper_ring
#: scripts/data/ext/uitrusting.gd:54
msgid "Koperen ring"
msgstr "Copper ring"

#. Beschrijving van voorwerp gear_copper_ring
#: scripts/data/ext/uitrusting.gd:54
msgid "Een ring die verloren spullen aantrekt. Vergroot je magnetische oppakbereik met 12 pixels."
msgstr "A ring that attracts lost belongings. Increases your magnetic pickup range by 12 pixels."

#. Naam van voorwerp gear_crystal_ring
#: scripts/data/ext/uitrusting.gd:55
msgid "Kristallen ring"
msgstr "Crystal ring"

#. Beschrijving van voorwerp gear_crystal_ring
#: scripts/data/ext/uitrusting.gd:55
msgid "Een ring van koper en alchemistisch kristal. Vergroot je magnetische oppakbereik met 24 pixels."
msgstr "A ring of copper and alchemical crystal. Increases your magnetic pickup range by 24 pixels."

#. Naam van voorwerp gear_pg_grip
#: scripts/data/ext/uitrusting.gd:56
msgid "Slagbanden"
msgstr "Strike Wraps"

#. Beschrijving van voorwerp gear_pg_grip
#: scripts/data/ext/uitrusting.gd:56
msgid "10% minder stamina voor voorbereide zwaardtechnieken en precisieschoten. Gewone slagen en sprinten veranderen niet."
msgstr "10% less stamina for prepared sword techniques and precise shots. Ordinary swings and sprinting are unchanged."

#. Naam van voorwerp gear_pg_grip_plus
#: scripts/data/ext/uitrusting.gd:57
msgid "Geharde slagbanden"
msgstr "Hardened Strike Wraps"

#. Beschrijving van voorwerp gear_pg_grip_plus
#: scripts/data/ext/uitrusting.gd:57
msgid "20% minder techniekstamina en 6% kortere wachttijd tussen gewone zwaardaanvallen. Verbeterde slagbanden met zandsteen uit Dorstvallei."
msgstr "20% less technique stamina and 6% shorter cooldown between ordinary sword attacks. Strike wraps hardened with Dorstvallei sandstone."

#. Naam van voorwerp gear_pg_focus
#: scripts/data/ext/uitrusting.gd:58
msgid "Richtlens"
msgstr "Aiming Lens"

#. Beschrijving van voorwerp gear_pg_focus
#: scripts/data/ext/uitrusting.gd:58
msgid "15% kortere voorbereiding van je precisieschot. Draag de lens in het halsvak; pijlschade en staminakosten blijven gelijk."
msgstr "15% shorter preparation for your precise shot. Wear the lens in your neck slot; arrow damage and stamina cost stay the same."

#. Naam van voorwerp gear_pg_focus_plus
#: scripts/data/ext/uitrusting.gd:59
msgid "Heldere richtlens"
msgstr "Clear Aiming Lens"

#. Beschrijving van voorwerp gear_pg_focus_plus
#: scripts/data/ext/uitrusting.gd:59
msgid "25% kortere voorbereiding van precisieschoten en 10% sneller staminaherstel. Gebruikt ijskristal en watermunt na je onderzoek in het Rietarchief."
msgstr "25% shorter precise shot preparation and 10% faster stamina recovery. Uses ice crystal and water mint after your Reed Archive research."

#. Naam van voorwerp gear_pg_pack
#: scripts/data/ext/uitrusting.gd:60
msgid "Werkpak"
msgstr "Work Harness"

#. Beschrijving van voorwerp gear_pg_pack
#: scripts/data/ext/uitrusting.gd:60
msgid "15% korter verzamelen met kruiden, bijl en pikhouweel. Een gevlochten werkpak voor ambachten; geeft geen pantser."
msgstr "15% less time gathering herbs, chopping and mining. A woven harness for crafting; provides no armor."

#. Naam van voorwerp gear_pg_pack_plus
#: scripts/data/ext/uitrusting.gd:61
msgid "Bergwerkpak"
msgstr "Mountain Work Harness"

#. Beschrijving van voorwerp gear_pg_pack_plus
#: scripts/data/ext/uitrusting.gd:61
msgid "25% korter verzamelen en 10 extra oppakbereik. Versterkt met dennenhout en wilgentwijgen na het vastzetten van de klimlijn; geeft geen pantser."
msgstr "25% less gathering time and 10 extra pickup range. Reinforced with pine wood and willow twigs after securing the climbing line; provides no armor."

#. Naam van voorwerp special_lantern
#: scripts/data/ext/polijst.gd:58
msgid "Nachtlantaarn"
msgstr "Night Lantern"

#. Beschrijving van voorwerp special_lantern
#: scripts/data/ext/polijst.gd:59
msgid "Een lantaarn die 's nachts verder en warmer schijnt dan een gewone fakkel."
msgstr "A lantern that shines farther and warmer at night than a normal torch."

#. Naam van voorwerp dauwsteen
#: scripts/data/ext/polijst.gd:62
msgid "Dauwsteen"
msgstr "Dew Stone"

#. Beschrijving van voorwerp dauwsteen
#: scripts/data/ext/polijst.gd:63
msgid "Een steen die altijd bedekt is met fijne dauw. Hij voelt koel en levend."
msgstr "A stone always covered in fine dew. It feels cool and alive."

#. Naam van voorwerp herb
#: scripts/data/ext/polijst.gd:66
msgid "Verse kruiden"
msgstr "Fresh Herbs"

#. Beschrijving van voorwerp herb
#: scripts/data/ext/polijst.gd:67
msgid "Verse kruiden uit het bos. Elke de kruidenier heeft ze nodig."
msgstr "Fresh herbs from the forest. Elke the herbalist needs them."

#. Naam van voorwerp jacht_vlees
#: scripts/data/ext/dorst.gd:31
msgid "Rauw vlees"
msgstr "Raw meat"

#. Beschrijving van voorwerp jacht_vlees
#: scripts/data/ext/dorst.gd:31
msgid "Vers vlees van wild uit de Dorstvallei. Braad het in de keuken van de herberg."
msgstr "Fresh game meat from Dorstvallei. Roast it in the inn's kitchen."

#. Naam van voorwerp jacht_vacht
#: scripts/data/ext/dorst.gd:32
msgid "Dierenvacht"
msgstr "Animal hide"

#. Beschrijving van voorwerp jacht_vacht
#: scripts/data/ext/dorst.gd:32
msgid "Een zachte vossenvacht. Handelaars en kleermakers betalen er goed voor."
msgstr "A soft fox hide. Traders and tailors pay well for it."

#. Naam van voorwerp jacht_braadstuk
#: scripts/data/ext/dorst.gd:33
msgid "Braadstuk"
msgstr "Roast"

#. Beschrijving van voorwerp jacht_braadstuk
#: scripts/data/ext/dorst.gd:33
msgid "Sappig gebraden vlees met zandkruid. Herstelt 3 hartjes. Gebruik via Beroepen → Eten & drinken."
msgstr "Juicy roasted meat with sandwort. Restores 3 hearts. Use through Professions → Food & drink."

#. Naam van voorwerp cloth_straw_hat
#: scripts/data/ext/uiterlijk.gd:211
msgid "Strohoed"
msgstr "Straw hat"

#. Beschrijving van voorwerp cloth_straw_hat
#: scripts/data/ext/uiterlijk.gd:211
msgid "Een zonnehoed van gevlochten stro. Puur voor de look; draag hem over je uitrusting."
msgstr "A sun hat of woven straw. Purely for looks; wear it over your equipment."

#. Naam van voorwerp cloth_beret
#: scripts/data/ext/uiterlijk.gd:212
msgid "Baret"
msgstr "Beret"

#. Beschrijving van voorwerp cloth_beret
#: scripts/data/ext/uiterlijk.gd:212
msgid "Een kunstzinnige baret, schuin op je hoofd. Puur voor de look; draag hem over je uitrusting."
msgstr "An artistic beret, tilted on your head. Purely for looks; wear it over your equipment."

#. Naam van voorwerp cloth_beanie
#: scripts/data/ext/uiterlijk.gd:213
msgid "Muts"
msgstr "Beanie"

#. Beschrijving van voorwerp cloth_beanie
#: scripts/data/ext/uiterlijk.gd:213
msgid "Een warme gebreide muts met pompon. Puur voor de look; draag hem over je uitrusting."
msgstr "A warm knitted beanie with a pompom. Purely for looks; wear it over your equipment."

#. Naam van voorwerp cloth_cape
#: scripts/data/ext/uiterlijk.gd:214
msgid "Cape"
msgstr "Cape"

#. Beschrijving van voorwerp cloth_cape
#: scripts/data/ext/uiterlijk.gd:214
msgid "Een wapperende cape voor over je schouders. Puur voor de look; draag hem over je uitrusting."
msgstr "A fluttering cape for over your shoulders. Purely for looks; wear it over your equipment."

#. Naam van voorwerp cloth_scarf
#: scripts/data/ext/uiterlijk.gd:215
msgid "Sjaal"
msgstr "Scarf"

#. Beschrijving van voorwerp cloth_scarf
#: scripts/data/ext/uiterlijk.gd:215
msgid "Een zachte sjaal met een losse punt. Puur voor de look; draag hem over je uitrusting."
msgstr "A soft scarf with a loose end. Purely for looks; wear it over your equipment."

#. Naam van voorwerp cloth_tunic
#: scripts/data/ext/uiterlijk.gd:216
msgid "Tuniek"
msgstr "Tunic"

#. Beschrijving van voorwerp cloth_tunic
#: scripts/data/ext/uiterlijk.gd:216
msgid "Een ruimvallende tuniek met ceintuur. Puur voor de look; draag hem over je uitrusting."
msgstr "A loose tunic with a belt. Purely for looks; wear it over your equipment."

#. Naam van voorwerp cloth_blouse
#: scripts/data/ext/uiterlijk.gd:217
msgid "Blouse"
msgstr "Blouse"

#. Beschrijving van voorwerp cloth_blouse
#: scripts/data/ext/uiterlijk.gd:217
msgid "Een fijne blouse met knoopjes. Puur voor de look; draag hem over je uitrusting."
msgstr "A fine blouse with buttons. Purely for looks; wear it over your equipment."

#. Naam van voorwerp cloth_shirt
#: scripts/data/ext/uiterlijk.gd:218
msgid "Hemd"
msgstr "Shirt"

#. Beschrijving van voorwerp cloth_shirt
#: scripts/data/ext/uiterlijk.gd:218
msgid "Een stevig hemd met kraag. Puur voor de look; draag hem over je uitrusting."
msgstr "A sturdy shirt with a collar. Purely for looks; wear it over your equipment."

#. Naam van voorwerp cloth_trousers
#: scripts/data/ext/uiterlijk.gd:219
msgid "Broek"
msgstr "Trousers"

#. Beschrijving van voorwerp cloth_trousers
#: scripts/data/ext/uiterlijk.gd:219
msgid "Een nette broek met stevige pijpen. Puur voor de look; draag hem over je uitrusting."
msgstr "Neat trousers with sturdy legs. Purely for looks; wear them over your equipment."

#. Naam van voorwerp cloth_skirt
#: scripts/data/ext/uiterlijk.gd:220
msgid "Rok"
msgstr "Skirt"

#. Beschrijving van voorwerp cloth_skirt
#: scripts/data/ext/uiterlijk.gd:220
msgid "Een zwierige rok tot over de knieën. Puur voor de look; draag hem over je uitrusting."
msgstr "A flowing skirt down to the knees. Purely for looks; wear it over your equipment."

#. Naam van voorwerp cloth_shoes
#: scripts/data/ext/uiterlijk.gd:221
msgid "Schoenen"
msgstr "Shoes"

#. Beschrijving van voorwerp cloth_shoes
#: scripts/data/ext/uiterlijk.gd:221
msgid "Stevige leren schoenen. Puur voor de look; draag ze over je uitrusting."
msgstr "Sturdy leather shoes. Purely for looks; wear them over your equipment."

#. Naam van voorwerp cloth_slippers
#: scripts/data/ext/uiterlijk.gd:222
msgid "Sloffen"
msgstr "Slippers"

#. Beschrijving van voorwerp cloth_slippers
#: scripts/data/ext/uiterlijk.gd:222
msgid "Zachte sloffen met een bontje. Puur voor de look; draag ze over je uitrusting."
msgstr "Soft slippers with a fluffy trim. Purely for looks; wear them over your equipment."

#. Naam van voorwerp cloth_headband
#: scripts/data/ext/uiterlijk.gd:223
msgid "Hoofdband"
msgstr "Headband"

#. Beschrijving van voorwerp cloth_headband
#: scripts/data/ext/uiterlijk.gd:223
msgid "Een stoere band die je haar uit je gezicht houdt. Puur voor de look; draag hem over je uitrusting."
msgstr "A sturdy band that keeps your hair out of your face. Purely for looks; wear it over your equipment."

#. Naam van voorwerp cloth_felt_hat
#: scripts/data/ext/uiterlijk.gd:224
msgid "Vilthoed"
msgstr "Felt hat"

#. Beschrijving van voorwerp cloth_felt_hat
#: scripts/data/ext/uiterlijk.gd:224
msgid "Een elegante hoed van zacht vilt, met een lint om de bol. Puur voor de look; draag hem over je uitrusting."
msgstr "An elegant hat of soft felt, with a ribbon around the crown. Purely for looks; wear it over your equipment."

#. Naam van voorwerp cloth_nightcap
#: scripts/data/ext/uiterlijk.gd:225
msgid "Nachtmuts"
msgstr "Nightcap"

#. Beschrijving van voorwerp cloth_nightcap
#: scripts/data/ext/uiterlijk.gd:225
msgid "Een slap hangende muts met een pompon. Zo knus dat je erin zou willen slapen. Puur voor de look; draag hem over je uitrusting."
msgstr "A floppy cap with a pompom. So cosy you could sleep in it. Purely for looks; wear it over your equipment."

#. Naam van voorwerp cloth_backpack
#: scripts/data/ext/uiterlijk.gd:226
msgid "Rugzak"
msgstr "Backpack"

#. Beschrijving van voorwerp cloth_backpack
#: scripts/data/ext/uiterlijk.gd:226
msgid "Een stevige rugzak voor de echte avonturier. Puur voor de look; draag hem over je uitrusting."
msgstr "A sturdy backpack for the true adventurer. Purely for looks; wear it over your equipment."

#. Naam van voorwerp cloth_cloak
#: scripts/data/ext/uiterlijk.gd:227
msgid "Mantel"
msgstr "Cloak"

#. Beschrijving van voorwerp cloth_cloak
#: scripts/data/ext/uiterlijk.gd:227
msgid "Een warme mantel met capuchon, voor reizen door koude streken. Puur voor de look; draag hem over je uitrusting."
msgstr "A warm cloak with a hood, for journeys through cold lands. Purely for looks; wear it over your equipment."

#. Naam van voorwerp cloth_sweater
#: scripts/data/ext/uiterlijk.gd:228
msgid "Trui"
msgstr "Sweater"

#. Beschrijving van voorwerp cloth_sweater
#: scripts/data/ext/uiterlijk.gd:228
msgid "Een zachte gebreide trui met een opstaande kraag. Puur voor de look; draag hem over je uitrusting."
msgstr "A soft knitted sweater with a stand-up collar. Purely for looks; wear it over your equipment."

#. Naam van voorwerp cloth_vest
#: scripts/data/ext/uiterlijk.gd:229
msgid "Gilet"
msgstr "Vest"

#. Beschrijving van voorwerp cloth_vest
#: scripts/data/ext/uiterlijk.gd:229
msgid "Een net gilet dat open over je hemd valt. Puur voor de look; draag hem over je uitrusting."
msgstr "A neat vest worn open over your shirt. Purely for looks; wear it over your equipment."

#. Naam van voorwerp cloth_dress
#: scripts/data/ext/uiterlijk.gd:230
msgid "Jurk"
msgstr "Dress"

#. Beschrijving van voorwerp cloth_dress
#: scripts/data/ext/uiterlijk.gd:230
msgid "Een zwierige jurk met een wijde rok. Puur voor de look; draag hem over je uitrusting."
msgstr "A flowing dress with a wide skirt. Purely for looks; wear it over your equipment."

#. Naam van voorwerp cloth_shorts
#: scripts/data/ext/uiterlijk.gd:231
msgid "Korte broek"
msgstr "Shorts"

#. Beschrijving van voorwerp cloth_shorts
#: scripts/data/ext/uiterlijk.gd:231
msgid "Een luchtige korte broek voor warme dagen. Puur voor de look; draag hem over je uitrusting."
msgstr "An airy pair of shorts for warm days. Purely for looks; wear it over your equipment."

#. Naam van voorwerp cloth_overalls
#: scripts/data/ext/uiterlijk.gd:232
msgid "Werkbroek"
msgstr "Work trousers"

#. Beschrijving van voorwerp cloth_overalls
#: scripts/data/ext/uiterlijk.gd:232
msgid "Een stevige werkbroek met verstevigde knieën. Puur voor de look; draag hem over je uitrusting."
msgstr "Sturdy work trousers with reinforced knees. Purely for looks; wear it over your equipment."

#. Naam van voorwerp cloth_boots
#: scripts/ui/equipment_page.gd:220 scripts/ui/progression_page.gd:126 scripts/data/ext/uiterlijk.gd:233
msgid "Laarzen"
msgstr "Boots"

#. Beschrijving van voorwerp cloth_boots
#: scripts/data/ext/uiterlijk.gd:233
msgid "Hoge laarzen die modder en sneeuw trotseren. Puur voor de look; draag ze over je uitrusting."
msgstr "Tall boots that defy mud and snow. Purely for looks; wear them over your equipment."

#. Naam van voorwerp cloth_sandals
#: scripts/data/ext/uiterlijk.gd:234
msgid "Sandalen"
msgstr "Sandals"

#. Beschrijving van voorwerp cloth_sandals
#: scripts/data/ext/uiterlijk.gd:234
msgid "Lichte sandalen voor zwoele zomerdagen. Puur voor de look; draag ze over je uitrusting."
msgstr "Light sandals for sultry summer days. Purely for looks; wear them over your equipment."

#. Naam van voorwerp moeras_huid
#: scripts/data/ext/moeras.gd:31
msgid "Moerashuid"
msgstr "Marsh hide"

#. Beschrijving van voorwerp moeras_huid
#: scripts/data/ext/moeras.gd:31
msgid "Een taaie, waterdichte huid van moeraswild. Kleermakers werken er graag mee."
msgstr "A tough, waterproof hide from swamp game. Tailors love working with it."

#. Naam van voorwerp zonneschijf_amulet
#: scripts/data/ext/moeras.gd:32
msgid "Zonneschijfamulet"
msgstr "Sun disk amulet"

#. Beschrijving van voorwerp zonneschijf_amulet
#: scripts/data/ext/moeras.gd:32
msgid "Een gouden schijfje aan een verweerd koord. Het voelt warm, alsof de zon er nog in zit."
msgstr "A golden disk on a weathered cord. It feels warm, as if the sun still sits inside."

#. Naam van voorwerp lw_lens
#: scripts/data/ext/living.gd:99
msgid "Prismalens"
msgstr "Prism lens"

#. Beschrijving van voorwerp lw_lens
#: scripts/data/ext/living.gd:104
msgid "De gestabiliseerde kern uit de Prismamijn. Greta kan er een lantaarn van maken."
msgstr "The stabilized core from the Prism Mine. Greta can turn it into a lantern."

#. Naam van voorwerp lw_lantern
#: scripts/data/ext/living.gd:107
msgid "Prismalantaarn"
msgstr "Prism lantern"

#. Beschrijving van voorwerp lw_lantern
#: scripts/data/ext/living.gd:112
msgid "Onthult de verborgen bosrunen. Mistjagers wijken terug binnen de lichtkring. Werkt automatisch zolang je hem draagt."
msgstr "Reveals hidden forest runes. Mist stalkers retreat inside its light. Works automatically while carried."

#. Naam van voorwerp lw_powder
#: scripts/data/ext/living.gd:115
msgid "Aardingspoeder"
msgstr "Grounding powder"

#. Beschrijving van voorwerp lw_powder
#: scripts/data/ext/living.gd:119
msgid "Stabiliseert de mijnkern zonder gevecht. Meng steen met slijmgel aan de alchemietafel."
msgstr "Stabilizes the mine core without combat. Mix stone and slime gel at the alchemy table."

#. Naam van voorwerp lw_bridge_kit
#: scripts/data/ext/living.gd:122
msgid "Brugonderdelen"
msgstr "Bridge components"

#. Beschrijving van voorwerp lw_bridge_kit
#: scripts/data/ext/living.gd:126
msgid "Een houten constructie voor Mees’ oversteek. Te maken zonder werkbank."
msgstr "A wooden structure for Mees’s crossing. Can be crafted without a workbench."

#. Naam van voorwerp lw_resin
#: scripts/data/ext/living.gd:129
msgid "Levende hars"
msgstr "Living resin"

#. Beschrijving van voorwerp lw_resin
#: scripts/data/ext/living.gd:133
msgid "Watermunt en slijmgel verbinden het gebroken hout van de oversteek."
msgstr "Watermint and slime gel bind the crossing’s broken timbers."

#. Naam van voorwerp op_rake
#: scripts/data/ext/opening.gd:11
msgid "Nelles tuinhark"
msgstr "Nelle’s Garden Rake"

#. Beschrijving van voorwerp op_rake
#: scripts/data/ext/opening.gd:12
msgid "Geleend van Nelle. Gebruik bij het verstopte rooster naast de dorpsfontein; daarna krijgt ze hem terug."
msgstr "Borrowed from Nelle. Use it at the blocked grate beside the village fountain, then return it to her."

#. Naam van vijand slime
#: scripts/data/enemies.gd:13
msgid "Slijm"
msgstr "Slime"

#. Vijand slime: grappige beschrijving in het beestenboek
#: scripts/data/enemies.gd:17
msgid "Een vrolijk groen slijm. Hij wil alleen maar knuffelen, maar dat doet toch een beetje pijn."
msgstr "A cheerful green slime. It just wants a hug, but its hugs still hurt a little."

#. Naam van vijand slime_blue
#: scripts/data/enemies.gd:20
msgid "Blauw slijm"
msgstr "Blue Slime"

#. Vijand slime_blue: grappige beschrijving in het beestenboek
#: scripts/data/enemies.gd:24
msgid "Een blauw slijm dat net iets sneller is. Hij ruikt naar regen en natte sokken."
msgstr "A blue slime that's just a bit faster. It smells like rain and wet socks."

#. Naam van vijand slime_red
#: scripts/data/enemies.gd:27
msgid "Rood slijm"
msgstr "Red Slime"

#. Vijand slime_red: grappige beschrijving in het beestenboek
#: scripts/data/enemies.gd:31
msgid "Een rood slijm met een slecht humeur. Hij slaat harder dan zijn zachte buik doet vermoeden."
msgstr "A red slime in a bad mood. It hits much harder than its squishy belly would make you think."

#. Naam van vijand slime_mini
#: scripts/data/enemies.gd:34
msgid "Minislijm"
msgstr "Mini Slime"

#. Vijand slime_mini: grappige beschrijving in het beestenboek
#: scripts/data/enemies.gd:38
msgid "Een piepklein slijmpje uit de Slijmkoning. Ze komen nooit alleen en vallen om bij een kriebel."
msgstr "A teeny tiny slime that pops out of the Slime King. They never come alone, and one tickle knocks them over."

#. Naam van vijand bat
#: scripts/data/enemies.gd:41
msgid "Vleermuis"
msgstr "Bat"

#. Vijand bat: grappige beschrijving in het beestenboek
#: scripts/data/enemies.gd:45
msgid "Een vleermuis die dol is op duiken. Hij komt altijd net uit de hoek waar je niet keek."
msgstr "A bat that loves to dive. It always swoops in from the one corner you weren't watching."

#. Naam van vijand skeleton
#: scripts/data/enemies.gd:48
msgid "Skelet"
msgstr "Skeleton"

#. Vijand skeleton: grappige beschrijving in het beestenboek
#: scripts/data/enemies.gd:52
msgid "Een skelet met een boog. Hij is al eeuwen dood, maar zijn mikken is nog prima."
msgstr "A skeleton with a bow. He's been dead for ages, but his aim is still just fine."

#. Naam van vijand golem
#: scripts/data/enemies.gd:55
msgid "Kristalgolem"
msgstr "Crystal Golem"

#. Vijand golem: grappige beschrijving in het beestenboek
#: scripts/data/enemies.gd:59
msgid "Een reus van kristal en steen. Hij is traag, maar zijn klap voel je tot in je tenen."
msgstr "A giant made of crystal and stone. It's slow, but you'll feel its punch all the way down to your toes."

#. Vijand king: grappige beschrijving in het beestenboek
#: scripts/data/enemies.gd:67
msgid "De baas van alle slijmen. Hij springt, spuugt slijm en vindt zichzelf erg belangrijk."
msgstr "The boss of all slimes. He jumps, spits slime, and thinks he's very important."

#. Naam van vijand ad_crab
#: scripts/data/ext/coastal_adventures.gd:13
msgid "Rotskrab"
msgstr "Rock Crab"

#. Vijand ad_crab: grappige beschrijving in het beestenboek
#: scripts/data/ext/coastal_adventures.gd:13
msgid "Bewoont de noordelijke zijpoel. De amberkleurige waaier staat stil vóór de schaar sluit. Stap opzij en val tijdens het lange herstel aan. Het zuidelijke pad blijft buiten zijn territorium."
msgstr "Lives in the northern side pool. The amber fan stays fixed before its claw closes. Step aside and attack during the long recovery. The southern path lies outside its territory."

#. Naam van vijand ad_wisp
#: scripts/data/ext/coastal_adventures.gd:14
msgid "Getijdenlicht"
msgstr "Tidelight"

#. Vijand ad_wisp: grappige beschrijving in het beestenboek
#: scripts/data/ext/coastal_adventures.gd:14
msgid "Kondigt een uitdijende lichtkring aan. De open sector blijft veilig; hij draait niet achter je aan. Verlaat de poel of loop door de opening. Geen contactschade."
msgstr "Warns of an expanding ring of light. The open sector stays safe and does not turn to follow you. Leave the pool or walk through the gap. No contact damage."

#. Naam van vijand ad_keeper
#: scripts/data/ext/coastal_adventures.gd:15
msgid "Schelpenhoeder"
msgstr "Shellkeeper"

#. Vijand ad_keeper: grappige beschrijving in het beestenboek
#: scripts/data/ext/coastal_adventures.gd:15
msgid "Een vrijwillige krachtproef na de werksluiskeuze. Twee afzonderlijk aangekondigde schaarbogen, daarna een lang herstel. De zuidelijke gang blijft open; terugtrekken stopt de aanval."
msgstr "A voluntary trial after choosing the working sluice. Two separately announced claw arcs, then a long recovery. The southern passage stays open; retreating stops the attack."

#. Naam van vijand hb_root
#: scripts/data/ext/habitat.gd:5
msgid "Wortelwaker"
msgstr "Rootwarden"

#. Vijand hb_root: grappige beschrijving in het beestenboek
#: scripts/data/ext/habitat.gd:5
msgid "Blijft bij zijn wortels. De amberkleurige grondstrook ligt vast voordat de wortels toeslaan. Stap of rol opzij en sla tijdens het lange herstel. Zijn gesloten bast houdt gewone slagen en pijlen tegen; een techniek opent hem eerder."
msgstr "Stays by its roots. The amber ground strip is fixed before the roots strike. Step or roll aside, then attack during the long recovery. Closed bark blocks ordinary hits and arrows; a technique opens it sooner."

#. Naam van vijand hb_moth
#: scripts/data/ext/habitat.gd:6
msgid "Schemermot"
msgstr "Dusk Moth"

#. Vijand hb_moth: grappige beschrijving in het beestenboek
#: scripts/data/ext/habitat.gd:6
msgid "Volgt dichtbij zichtbaar licht binnen zijn eigen hoek van de grot. Lok hem naar een bestaande fakkel: daar houdt hij rustig de wacht. Zonder afleiding kondigt hij een korte rechte duik aan. Een treffer onderbreekt die; muren, rustplaatsen en aankomsten blijven buiten zijn bereik."
msgstr "Follows nearby visible light within its own corner of the cave. Lead it to an existing torch, where it settles quietly. Without a distraction, it warns before a short straight dive. A hit interrupts it; walls, rest stops and arrivals remain safe."

#. Naam van vijand cv_ram
#: scripts/data/ext/combat.gd:6
msgid "Keiram"
msgstr "Cairn Ram"

#. Vijand cv_ram: grappige beschrijving in het beestenboek
#: scripts/data/ext/combat.gd:6
msgid "Een oranje baan verraadt zijn stormloop. De richting ligt vast: stap opzij of lok hem tegen een rots. Na de botsing is hij kwetsbaar. Hard geluid trekt eerder zijn aandacht."
msgstr "An orange lane warns of its charge. Its direction is fixed: step aside or lure it into a rock. It is vulnerable after the impact. Loud noise attracts its attention from farther away."

#. Naam van vijand cv_slinger
#: scripts/data/ext/combat.gd:7
msgid "Doornschutter"
msgstr "Thorn Slinger"

#. Vijand cv_slinger: grappige beschrijving in het beestenboek
#: scripts/data/ext/combat.gd:7
msgid "Houdt afstand en richt langs een oranje baan. Dekking stopt zijn doorn; je zwaard kan die ook stukslaan. Een treffer onderbreekt de voorbereiding."
msgstr "Keeps its distance and aims along an orange lane. Cover stops its thorn; your sword can shatter it too. A hit interrupts its preparation."

#. Naam van vijand mage
#: scripts/data/ext/vijanden.gd:20
msgid "Magiër"
msgstr "Mage"

#. Vijand mage: grappige beschrijving in het beestenboek
#: scripts/data/ext/vijanden.gd:28
msgid "Zweeft in zijn gewaad en is nooit waar je hem verwacht: poef, weg! Zijn tovervonk is traag, dus sla hem gewoon kapot met je zwaard."
msgstr "Floats around in his robe and is never where you expect him: poof, gone! His magic spark is slow, so just smash it with your sword."

#. Vijand mage: tip als je hem voor het eerst ziet
#: scripts/data/ext/vijanden.gd:26
msgid "Een Magiër! Sla zijn tovervonk stuk of wijk uit."
msgstr "A Mage! Smash his magic spark or dodge it."

#. Naam van vijand slime_spitter
#: scripts/data/ext/vijanden.gd:31
msgid "Slijmspuwer"
msgstr "Slime Spitter"

#. Vijand slime_spitter: grappige beschrijving in het beestenboek
#: scripts/data/ext/vijanden.gd:38
msgid "Een slijm met een veel te grote mond, en hij gebruikt hem ook. Kom je te dichtbij, dan hupt hij weg om het opnieuw te proberen."
msgstr "A slime with a way-too-big mouth, and it sure likes to use it. Get too close and it hops away to try again."

#. Vijand slime_spitter: tip als je hem voor het eerst ziet
#: scripts/data/ext/vijanden.gd:36
msgid "Een Slijmspuwer! Rol weg als hij spuugt. Kom je dichtbij, dan hupt hij weg."
msgstr "A Slime Spitter! Roll away when it spits. Get close and it hops away."

#. Naam van vijand diepte_golem
#: scripts/data/ext/diepte.gd:118
msgid "Paarse kristalgolem"
msgstr "Purple Crystal Golem"

#. Vijand diepte_golem: grappige beschrijving in het beestenboek
#: scripts/data/ext/diepte.gd:122
msgid "Een golem van paars kristal die al eeuwen de Kristalgangen bewaakt. Hij is langzaam, maar zijn klap voel je tot in je tenen."
msgstr "A golem of purple crystal that has guarded the Crystal Halls for ages. It's slow, but you'll feel its punch all the way down to your toes."

#. Vijand guardian: grappige beschrijving in het beestenboek
#: scripts/data/ext/diepte.gd:130
msgid "De oude bewaker van de Sterrenkaart. Hij sliep meer dan duizend jaar onder de tempel en wilde liever niet gestoord worden."
msgstr "The ancient keeper of the Star Map. He slept under the temple for over a thousand years and really didn't want to be woken up."

#. Naam van vijand woestijnvos
#: scripts/data/ext/dorst.gd:15
msgid "Woestijnvos"
msgstr "Desert fox"

#. Vijand woestijnvos: grappige beschrijving in het beestenboek
#: scripts/data/ext/dorst.gd:19
msgid "Een sluwe vos met oren als warmtepanelen. Hij is niet gevaarlijk, maar wel verdomd snel."
msgstr "A sly fox with ears like heat panels. Not dangerous, but darn fast."

#. Naam van vijand zandhaas
#: scripts/data/ext/dorst.gd:22
msgid "Zandhaas"
msgstr "Sand hare"

#. Vijand zandhaas: grappige beschrijving in het beestenboek
#: scripts/data/ext/dorst.gd:26
msgid "Een haas die tussen de duinen huppelt. Zijn achterpoten zijn sneller dan je zwaard, bijna dan."
msgstr "A hare that hops between the dunes. Its hind legs are faster than your sword — almost."

#. Naam van vijand moerasvors
#: scripts/data/ext/moeras.gd:15
msgid "Moerasvors"
msgstr "Marsh toad"

#. Vijand moerasvors: grappige beschrijving in het beestenboek
#: scripts/data/ext/moeras.gd:19
msgid "Een trage vors met een kwak die door het hele veen galmt. Tot hij springt; dan is hij verdwenen."
msgstr "A slow toad with a croak that echoes across the moor. Until it leaps; then it is gone."

#. Naam van vijand waterslang
#: scripts/data/ext/moeras.gd:22
msgid "Waterslang"
msgstr "Water snake"

#. Vijand waterslang: grappige beschrijving in het beestenboek
#: scripts/data/ext/moeras.gd:26
msgid "Een gladde slang die tussen het riet glijdt. Ongevaarlijk, maar je grijpt hem zelden bij de staart."
msgstr "A slick snake that slides between the reeds. Harmless, but you rarely catch it by the tail."

#. Naam van vijand lw_warden
#: scripts/data/ext/living.gd:322
msgid "Schildwachter"
msgstr "Shield warden"

#. Vijand lw_warden: grappige beschrijving in het beestenboek
#: scripts/data/ext/living.gd:341
msgid "Blokkeert frontale treffers. Flankeer hem of breek zijn schild met je vrijgespeelde derde comboslag."
msgstr "Blocks frontal hits. Flank it or break its shield with your unlocked third combo strike."

#. Naam van vijand lw_stalker
#: scripts/data/ext/living.gd:344
msgid "Mistjager"
msgstr "Mist stalker"

#. Vijand lw_stalker: grappige beschrijving in het beestenboek
#: scripts/data/ext/living.gd:363
msgid "Loopt om je heen voor een korte uitval. Wijkt terug voor prismalicht en brandende vuurkorven."
msgstr "Circles around you before a short lunge. Retreats from prism light and burning braziers."

#. Naam van vijand lw_singer
#: scripts/data/ext/living.gd:366
msgid "Rietzanger"
msgstr "Reed singer"

#. Vijand lw_singer: grappige beschrijving in het beestenboek
#: scripts/data/ext/living.gd:385
msgid "Helpt gewonde vijanden met een zichtbaar lied. Een zwaardtreffer onderbreekt de genezing."
msgstr "Helps wounded enemies with a visible song. A sword hit interrupts its healing."

#. Naam van vijand rf_bramble
#: scripts/data/ext/first_route.gd:26
msgid "Struiksluiper"
msgstr "Bramble Prowler"

#. Vijand rf_bramble: grappige beschrijving in het beestenboek
#: scripts/data/ext/first_route.gd:26
msgid "Ritselende bladeren verraden zijn sprong. Stap opzij tijdens de aanloop en raak hem wanneer hij uitrust."
msgstr "Rustling leaves give away its leap. Step aside during the windup and strike while it rests."

#. Naam van vijand rf_listener
#: scripts/data/ext/first_route.gd:27
msgid "Steenluisteraar"
msgstr "Stone Listener"

#. Vijand rf_listener: grappige beschrijving in het beestenboek
#: scripts/data/ext/first_route.gd:27
msgid "Slaapt op trillingen. Hij springt naar de plek van een hard geluid, niet naar waar je daarna heen loopt. Rustig passeren kan ook."
msgstr "Dozes amid vibrations. It leaps at the source of a loud noise, not wherever you move afterwards. You can also pass quietly."

#. Naam van vijand crystal_beetle
#: scripts/data/ext/echo.gd:23
msgid "Kristalkever"
msgstr "Crystal Beetle"

#. Vijand crystal_beetle: grappige beschrijving in het beestenboek
#: scripts/data/ext/echo.gd:28
msgid "Zijn turquoise pantser licht op voor hij recht vooruit stormt. Stap opzij; na de botsing is hij even weerloos."
msgstr "Its turquoise shell lights up before it charges straight ahead. Step aside; after the charge it needs a moment to recover."

#. Naam van vijand prism_moth
#: scripts/data/ext/echo.gd:31
msgid "Prismamot"
msgstr "Prism Moth"

#. Vijand prism_moth: grappige beschrijving in het beestenboek
#: scripts/data/ext/echo.gd:36
msgid "Tekent drie lichtstralen voordat ze kristalvonken schiet. Zoek de ruimte ertussen of onderbreek haar met je zwaard."
msgstr "Draws three rays of light before firing crystal sparks. Find the gaps or interrupt it with your sword."

#. Een aanval van een vijand, tussen haakjes achter zijn naam: "Kristalgolem (klap)" op het game-over-scherm
#: scripts/data/enemies.gd:75
msgctxt "aanval"
msgid "pijl"
msgstr "arrow"

#. Een aanval van een vijand, tussen haakjes achter zijn naam: "Kristalgolem (klap)" op het game-over-scherm
#: scripts/data/enemies.gd:75
msgctxt "aanval"
msgid "tovervonk"
msgstr "magic spark"

#. Een aanval van een vijand, tussen haakjes achter zijn naam: "Kristalgolem (klap)" op het game-over-scherm
#: scripts/data/enemies.gd:75
msgctxt "aanval"
msgid "slijmbal"
msgstr "slime ball"

#. Een aanval van een vijand, tussen haakjes achter zijn naam: "Kristalgolem (klap)" op het game-over-scherm
#: scripts/data/enemies.gd:75
msgctxt "aanval"
msgid "klap"
msgstr "slam"

#. Een aanval van een vijand, tussen haakjes achter zijn naam: "Kristalgolem (klap)" op het game-over-scherm
#: scripts/data/enemies.gd:75
msgctxt "aanval"
msgid "steen"
msgstr "rock"

#. Een aanval van een vijand, tussen haakjes achter zijn naam: "Kristalgolem (klap)" op het game-over-scherm
#: scripts/data/enemies.gd:75 scripts/maps/tide_cove.gd:110 scripts/maps/tide_cove.gd:122
msgctxt "aanval"
msgid "landing"
msgstr "landing"

#. Een aanval van een vijand, tussen haakjes achter zijn naam: "Kristalgolem (klap)" op het game-over-scherm
#: scripts/data/enemies.gd:75
msgctxt "aanval"
msgid "storm"
msgstr "charge"

#. Een aanval van een vijand, tussen haakjes achter zijn naam: "Kristalgolem (klap)" op het game-over-scherm
#: scripts/data/enemies.gd:75
msgctxt "aanval"
msgid "scherf"
msgstr "shard"

