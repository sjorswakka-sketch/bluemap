msgstr ""

#. Kaart depths1, sign [21, 12]: tekst op een bord
#: scripts/maps/depths1.gd:52
msgid "Een kristalpoort met een sleutelgat in de vorm van een ster."
msgstr ""

#. Kaart depths1, sign [21, 12]: tekst op een bord
#: scripts/maps/depths1.gd:52
msgid "Ergens in deze gangen moet de sleutel liggen."
msgstr ""

#. Naam van gebied depths2
#: scripts/maps/depths2.gd:7
msgid "Het Hart van de Kaart"
msgstr ""

#. Naam van gebied depths2 midden in een zin ("Reizen naar %s?"); de vorm met hoofdletter is "Het Hart van de Kaart"
msgid "het Hart van de Kaart"
msgstr ""

#. Kaart depths2, diepte_gate [12, 18]: melding als hij op slot zit
#: scripts/maps/depths2.gd:41
msgid "De deur is dicht. Hij gaat pas weer open als het gevecht voorbij is."
msgstr ""

#. Kaart depths2, sign [15, 19]: tekst op een bord
#: scripts/maps/depths2.gd:45
msgid "Hierachter slaapt De Vergeten Wachter. Wie hem wakker maakt, kan pas terug als het gevecht voorbij is."
msgstr ""

#. Kaart depths2, sign [15, 19]: tekst op een bord
#: scripts/maps/depths2.gd:46
msgid "Sla dus eerst op bij het altaar en neem genoeg drankjes mee!"
msgstr ""

#. Kaart depths2, sign [15, 19]: tekst op een bord
#: scripts/maps/depths2.gd:47
msgid "Een tip van een oude held: laat hem tegen een muur of een pilaar knallen. Dan is hij even duizelig."
msgstr ""

#. Naam van gebied arena_hall
#: scripts/maps/arena_hall.gd:6
msgid "Arenahal"
msgstr ""

#. Kaart arena_hall, portal [8, 3]: melding als hij op slot zit
#: scripts/maps/arena_hall.gd:36
msgid "De arenadeur zit dicht. Schrijf je eerst in bij Bruno."
msgstr ""

#. Naam van gebied arena
#: scripts/maps/arena.gd:7
msgid "De Arena"
msgstr ""

#. Naam van gebied arena midden in een zin ("Reizen naar %s?"); de vorm met hoofdletter is "De Arena"
